# home-house: The house, who is here and what each is on right now (a6057, the HUD sprint's lane 3, LAMPLIT). A panel
# (its panel note's lens=; it takes At work's place). One grammar for everyone, Alex included: who, what they are on,
# since when, their word now. You first: your Now (shown only when set: nothing here asks you to type) and the timer.
# Then each one at work: a worker by WHAT it is on (its card's brief=, else its title) and its maker (Claude, Codex),
# never an id; its word is its card's now= (one line it keeps of what it is doing this minute), else its own latest
# comment. A resident by name, its own Now (its corner's focus=) and its last reply. Who rests is one faint line of
# names. A press on anyone opens their live feed in the middle (home-feed, a5988; the viewer's with=); the one you
# watch has a white edge. The rail says whose move it is: mint (accent), at work this moment; lilac (jeff), it asks a
# resident; amber (warm), it asks you. Placed: home-timer (the You row).
house : column
  role lhouse
  mine : column
    of prop:role=home-view,prop:actor=$me as v
    each roster
  plain : text "No viewer note for you here (role=home-view, actor=you): a press has nowhere to open a feed."
    role hint
    only when count(prop:role=home-view,prop:actor=$me) = 0
roster : column
  role lhouse
  you : column
    of prop:role=now,prop:actor=$me as nw
    each me
  lit : column
    role lhlist
    of house doing=working as h
    each being
  rest : row
    role lhrest
    only when count(house doing!=working) > 0
    label : text "resting"
      role lhrestlabel
    names : row
      role lhrestnames
      share 1
      of house doing!=working as r
      each restname
  empty : text "No house is running here: no one is at work, and no one rests."
    role lhcalm
    only when count(house) = 0
me : row
  role lhme
  name : text "You"
    role lhname.you
  doing : text "$nw.doing"
    role lhdoing
    share 1
    clamp 1
    only when ($nw.doing or "") != ""
  gap : column
    share 1
    only when ($nw.doing or "") = ""
  timer : row
    lens home-timer
being : column
  the $h.corner as c
  role lhbeing
  role lhbeing.asks when $c.commission = "waiting" and ($c.asked_by or "") != $me
  role lhbeing.you when $c.commission = "waiting" and ($c.asked_by or "") = $me
  role lhbeing.on when $v.viewing = $h.corner and $v.with = "home-feed"
  let was = $v.viewing
  on click do prop $v viewing=$h.corner back="$v.viewing" find="" with=home-feed
  work : column
    role lhcol
    only when ($c.commission or "") != ""
    let maker = "Codex" when ($c.worker_provider or "") = "codex"
    let maker = "Claude" otherwise
    head : row
      role lhhead
      what : text "$(($c.brief or $c.title))"
        role lhwhat
        share 1
        clamp 1
      asks : text "asks $c.asked_by"
        role lhstate.asks
        role lhstate.you when ($c.asked_by or "") = $me
        only when $c.commission = "waiting"
      who : text "$(maker)"
        role lhwho
      since : text "$(day-or-time($changed.commission, $today))"
        role lhsince
        only when ($changed.commission or "") != ""
    now : text "$c.now"
      role lhword.now
      clamp 1
      only when ($c.now or "") != ""
    said : row
      only when ($c.now or "") = ""
      of comments:$c.item by=$h.resident as m
      each lastword
  dweller : column
    role lhcol
    only when ($c.commission or "") = ""
    let shown = "JEFF" when $h.resident = "jeff"
    let shown = $h.resident otherwise
    head : row
      role lhhead
      name : text "$(shown)"
        role lhname
        role lhname.jeff when $h.resident = "jeff"
      focus : text "$c.focus"
        role lhfocus
        share 1
        clamp 1
        only when ($c.focus or "") != ""
      gap : column
        share 1
        only when ($c.focus or "") = ""
      since : text "$h.since"
        role lhsince
        only when ($h.since or "") != ""
    said : row
      of turns:$h.corner as t
      each lastturn
lastword : text "$m.text"
  role lhword
  only when $index = $count
  clamp 1
  share 1
lastturn : text "$t.said"
  role lhword
  only when $index = $count
  clamp 1
  share 1
restname : text "$r.resident"
  role lhrestname
  role lhrestname.on when $v.viewing = $r.corner and $v.with = "home-feed"
  let was = $v.viewing
  on click do prop $v viewing=$r.corner back="$v.viewing" find="" with=home-feed
