do rewrite a5715 text="# home-notices: the notification bar (a5530): what the world wants Alex to see now, newest first, calm. Two kinds.\n# Notices: notes with role=notice to=\$me, which world rules in the Home base room make (something landed, a worker\n# asks, something is ready for his review, a design waits on his word); about= names the thing, came= when; a × takes\n# one away. Calls: sayings for him not yet answered, newer than his notices surface's cleared= (a call's × is 'seen up\n# to here'), leaving out the chat the home base already shows (skip= on that surface). While his focus timer runs they\n# are held: the bar only counts them. A press on one opens its thing in the middle and takes the notice away.\n# A widget: tag widget, slot=bar, order=4.\nbar : row\n  role nbar\n  of kind:surface,prop:role=notices,prop:actor=\$me as nb\n  each bell\n  none : text \"no notices surface (role=notices actor=you) in the Home base room\"\n    role hint\n    only when count(kind:surface,prop:role=notices,prop:actor=\$me) = 0\nbell : row\n  role nbell\n  let notes = count(prop:role=notice,prop:to=\$me)\n  let calls = count(sayings for:\$me answered=no item!=\$nb.skip eid>\$nb.cleared)\n  let total = notes + calls\n  let focusing = count(prop:role=pomodoro,prop:actor=\$me,prop:state=running,prop:mode=focus)\n  quiet : text \"all quiet\"\n    role nquiet\n    only when total = 0\n  held : text \"\$(total) held until your break\"\n    role nheld\n    only when total > 0 and focusing > 0\n  first : row\n    role nfirst\n    share 1\n    only when total > 0 and focusing = 0\n    note : row\n      share 1\n      of prop:role=notice,prop:to=\$me as nt\n      by -came\n      clamp 1\n      each noticeline\n    call : row\n      share 1\n      only when notes = 0\n      of sayings for:\$me answered=no item!=\$nb.skip eid>\$nb.cleared as s\n      by -eid\n      clamp 1\n      each callline\n  open : column\n    role nopen\n    only when total > 0 and focusing = 0\n    fold \"\$(total)\" float handle ncount\n    list : column\n      role nlist\n      of prop:role=home-view,prop:actor=\$me as hv\n      each feed\nfeed : column\n  role nfeed\n  notes : column\n    role nitems\n    of prop:role=notice,prop:to=\$me as nt\n    by -came\n    clamp 12\n    each notice\n  callshead : text \"FOR YOU\"\n    role nhead\n    only when calls > 0\n  calls : column\n    role nitems\n    of sayings for:\$me answered=no item!=\$nb.skip eid>\$nb.cleared as s\n    by -eid\n    clamp 8\n    each call\n# one line in the bar: the newest notice or call\nnoticeline : row\n  role nline\n  let label = \"Landed\" when \$nt.topic = \"landed\"\n  let label = \"Asks\" when \$nt.topic = \"asking\"\n  let label = \"For your review\" when \$nt.topic = \"review\"\n  let label = \"Waits on your word\" when \$nt.topic = \"design\"\n  let label = \$nt.topic otherwise\n  dot : text \"●\"\n    role ndot\n    role ndot.landed when \$nt.topic = \"landed\"\n    role ndot.asking when \$nt.topic = \"asking\"\n  what : text \"\$(label)\"\n    role nlabel\n  about : row\n    share 1\n    the \$nt.about as a\n    title : text \"\$a.title\"\n      role ntitle\n      clamp 1\ncallline : row\n  role nline\n  dot : text \"●\"\n    role ndot.call\n  what : text \"\$s.name\"\n    role nlabel\n  said : text \"\$s.said\"\n    role ntitle\n    share 1\n    clamp 1\n# in the list: one notice, with its time, what it is about, and its ×\nnotice : row\n  role nitem\n  let label = \"Landed\" when \$nt.topic = \"landed\"\n  let label = \"Asks\" when \$nt.topic = \"asking\"\n  let label = \"For your review\" when \$nt.topic = \"review\"\n  let label = \"Waits on your word\" when \$nt.topic = \"design\"\n  let label = \$nt.topic otherwise\n  main : column\n    role nmain\n    share 1\n    on click do prop \$hv viewing=\$nt.about back=\"\$hv.viewing\" find=\"\"; do remove \$nt\n    top : row\n      role ntop\n      dot : text \"●\"\n        role ndot\n        role ndot.landed when \$nt.topic = \"landed\"\n        role ndot.asking when \$nt.topic = \"asking\"\n      what : text \"\$(label)\"\n        role nlabel\n      at : text \"\$(time(\$nt.came))\"\n        role meta\n    about : column\n      the \$nt.about as a\n      title : text \"\$a.title\"\n        role ntitle\n        clamp 2\n  x : text \"×\"\n    role nx\n    on click do remove \$nt\n# one call: who, where, a line of what they said; × is 'seen up to here'\ncall : row\n  role nitem\n  main : column\n    role nmain\n    share 1\n    let was = \$hv.back\n    on click do prop \$hv viewing=\$s.item back=\"\$hv.viewing\" find=\"\"\n    top : row\n      role ntop\n      dot : text \"●\"\n        role ndot.call\n      who : text \"\$s.name\"\n        role nlabel\n      where : text \"in \$s.in · \$s.at\"\n        role meta\n        clamp 1\n    said : text \"\$s.said\"\n      role ntitle\n      clamp 2\n  x : text \"×\"\n    role nx\n    let was = \$nb.cleared\n    on click do prop \$nb cleared=\$s.eid"
