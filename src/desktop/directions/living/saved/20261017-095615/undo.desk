do rewrite a5206 text="font sans = Segoe UI Variable Text, Segoe UI, system-ui, sans-serif\nfont mono = Cascadia Code, ui-monospace, monospace\ntoken night = #0E1211\ntoken paper = #0E1211\ntoken ink = #E9EEEA\ntoken jeff = #B9A4F2\ntoken accent = #8DCDB4\ntoken warm = #F2C98B\ntoken glass = #0E1211A6\ntoken glassdeep = #0E1211D0\ntoken rim = ink at 10%\ntoken soft = ink at 62%\ntoken faint = ink at 14%\ntoken mine = #8DCDB433\ntoken jeffwash = #B9A4F222\ntoken wash = #E9EEEA12\ntoken focus = accent at 40%\ntoken scrollbar = ink at 22%\ntoken scrollbar_w = 5\ntoken gap = 8\ntoken ramp = 1.16\ntoken text = sans 15/1.55\ntoken text.mono = mono 12/1.5\nrole desk : ink, text\nrole page : ink, text\nrole home : ink, text, pad gap x2\nrole bar : pad bottom gap x2, between gap x2\nrole brand : text.mono down tracked, accent\nrole place : text medium, ink\nrole meta : text down, soft\nrole body : between gap x2\nrole side : between gap x2\nrole panel : on glass, edge rim, corner gap x2, pad gap x2, between gap\nrole heading : text up medium, ink\nrole prose : text, ink, space above gap\nrole busy : between gap, pad top gap /2\nrole live : accent\nrole who : text medium, ink\nrole who.jeff : text medium, jeff\nrole tiles : between gap x1.5\nrole tile : on glass, edge rim, corner gap x1.5, pad gap, between gap /2\nrole tile.front : on glassdeep, edge accent, corner gap x1.5, pad gap, between gap /2\nrole thumb : on wash, corner gap, height gap x19\nrole tilename : text down medium, ink\nrole chat : ink, text\nrole room : on glassdeep, edge rim, corner gap x2, lift gap\nrole chathead : pad gap x2, border bottom rim, between gap x1.5\nrole face : on jeffwash, jeff, text up 2 strong, corner gap x3, pad gap, pad left gap x2, pad right gap x2\nrole chatname : text up 2 strong, ink\nrole thinking : text down, jeff\nrole tabs : between gap /2\nrole tab : text down, soft, pad gap /2, pad left gap, pad right gap, corner gap\nrole tab.on : text down medium, ink, on wash, pad gap /2, pad left gap, pad right gap, corner gap\nrole feed : pad gap x2, between gap /2\nrole said : align start, width 46em, space above gap /2\nrole said.mine : align end, width 46em, space above gap /2\nrole saidhead : between gap, pad bottom gap /2, space above gap\nrole bubble : on wash, corner gap x1.5, pad gap x1.5\nrole bubble.mine : on mine, corner gap x1.5, pad gap x1.5\nrole bubble.jeff : on jeffwash, corner gap x1.5, pad gap x1.5\nrole words : text, ink\nrole acts : shy, pad left gap\nrole tool : text down, soft, pad gap /2\nrole working : pad left gap x2\nrole typingrow : between gap, pad bottom gap /2\nrole dots : jeff\nrole dock : on glass, border top rim, pad gap x2, between gap\nrole answering : on wash, corner gap, pad gap, between gap\nrole to : between gap /2\nrole chip : text down, soft, edge rim, corner gap x2, pad gap /2, pad left gap x1.5, pad right gap x1.5\nrole chip.on : text down medium, night, on accent, corner gap x2, pad gap /2, pad left gap x1.5, pad right gap x1.5\nrole input : text, ink, on wash, corner gap x1.5, pad gap x1.5\nrole button : on accent, night, text down medium, pad gap, pad left gap x2, pad right gap x2, corner gap x2\nrole hint : text down 2, soft\nrole attachment : on wash, corner gap, pad gap, between gap\nrole attachthumb : corner gap /2, width gap x14\nrole mark : ink\nrole menu.item : text down, ink, pad gap\nrole popup : on glassdeep, edge rim, corner gap, pad gap\nrole code : text.mono, on wash, corner gap /2\nrole hello : pad gap x3, between gap, space below gap x2\nrole waithead : between gap\nrole waitdesk : between gap x1.5\nrole waitlist : between gap /2\nrole wait : on wash, corner gap, pad gap, between gap /4\nrole wait.on : on mine, edge accent, corner gap, pad gap, between gap /4\nrole waitfacts : between gap\nrole reviewcard : on glassdeep, edge accent, corner gap x1.5, pad gap x1.5, between gap\nrole reviewacts : between gap, space above gap /2\nrole lane : between gap /2, space above gap\nrole lanename : text down medium tracked, soft\nrole lanecards : between gap /2\nrole taskcard : on wash, edge faint, corner gap, pad gap /2, pad left gap, pad right gap\nrole taskcard.live : on wash, edge accent, corner gap, pad gap /2, pad left gap, pad right gap\nrole cardtitle : text down medium, ink\nrole cardline : between gap\nrole cardwho : text down, soft\nrole cardlane : text down 2, soft\nrole still : faint\nrole cardopen : text down 2, soft\nrole cardmore : between gap /2, pad top gap /2, pad bottom gap /2, space above gap /2, border top rim\nrole cardnote : between gap /4, pad left gap, border left rim\nrole cardtext : text down, soft\nrole cut : text down, soft\n# a5398: the home base's viewer (home-viewer, home-note, home-chat, home-surface)\nrole viewer : between gap\nrole findbar : between gap, on glass, edge rim, corner gap x2, pad gap /2, pad left gap\nrole find : text, ink, on wash, corner gap x1.5, pad gap\nrole pins : between gap /2\nrole found : on glassdeep, edge rim, corner gap x2, pad gap x1.5, between gap /2\nrole foundlist : between gap /4\nrole hit : between gap, pad gap /2, corner gap\nrole shown : on glassdeep, edge rim, corner gap x2, pad gap x2, between gap\nrole viewhead : between gap, pad bottom gap, border bottom rim\nrole viewlanes : between gap\nrole viewlane : on wash, corner gap x1.5, pad gap, between gap\nrole viewlanehead : text down medium, soft\nrole viewlanelist : between gap /2\nrole viewcard : on glass, edge rim, corner gap, pad gap, between gap /4\nrole viewcard.p1 : on glass, edge warm, corner gap, pad gap, between gap /4\nrole viewcardtitle : text down, ink\nrole docheading : text up medium, ink, space above gap\n# a5504: the waiting list opens in place (waiting-on-me), and a demo opened inside a card wears this style: report..composer are the demo lens's own role names\nrole count : text down medium, night, on accent, corner gap x2, pad left gap, pad right gap\nrole tag : text down 2 tracked, soft\nrole tag.demo : text down 2 medium tracked, warm\nrole tag.design : text down 2 medium tracked, jeff\nrole waithit : between gap /4\nrole reviewbody : between gap, pad top gap, border top rim\nrole demo : on night, edge rim, corner gap, pad gap, height gap x60\nrole report : on wash, ink, text, pad gap x1.5, edge rim, corner gap x1.5\nrole eyebrow : text.mono tracked, accent, space below gap\nrole title : text up strong, ink\nrole subtitle : text down, soft, space below gap\nrole check : on wash, pad gap, corner gap, space below gap\nrole label : text medium, ink\nrole good : text.mono strong, accent, pad left gap\nrole detail : text down, soft, space above gap /2\nrole boundary : text down 2, soft, space above gap\nrole message : pad gap /2, space below gap\nrole author : text down medium, accent\nrole composer : text, ink, on wash, corner gap, pad gap\n# a5500: the dock along the foot of the home base (home-dock)\nrole appfoot : pad top gap x2\nrole appdock : on glassdeep, edge rim, corner gap x2, pad gap, pad left gap x2, pad right gap x2\nrole appshelf : between gap x1.5\nrole appicons : between gap\nrole appslot : between gap /4\nrole appicon : on wash, edge faint, corner gap x1.5, pad gap, width gap x11, between gap /4\nrole appicon.on : on mine, edge accent, corner gap x1.5, pad gap, width gap x11, between gap /4\nrole appadd : on glass, edge rim, soft, corner gap x1.5, pad gap, width gap x11, between gap /4\nrole appglyph : text up 3, ink, align center\nrole applabel : text down 2, soft, align center\n# a5504: the board (home-board): one colour per lane, used only as small marks (a dot, a rail, a count); a card is a raised tile; a card whose worker is at work has an edge in its lane colour (a5816, Alex 16 Oct: no breathing, no glide, no pulse, wave or hover lift anywhere in this style; only the pomodoro ring moves)\ntoken shadow = #000000\ntoken sky = #8FB8F2\ntoken teal = #7FD1E0\ntoken raised = #E9EEEA0D\ntoken raisedhi = #E9EEEA17\ntoken skywash = #8FB8F226\ntoken jeffwash2 = #B9A4F226\ntoken accentwash = #8DCDB426\ntoken warmwash = #F2C98B26\ntoken tealwash = #7FD1E026\nrole bdhead : between gap, pad bottom gap /2\nrole bdlivecount : text down medium, accent\nrole bdlane : between gap /2, space above gap x1.5\nrole bdlanehead : between gap, pad left gap /4\nrole bddot : text down, faint\nrole bddot.asked : text down, jeff\nrole bddot.working : text down, accent\nrole bddot.ready : text down, sky\nrole bddot.landing : text down, teal\nrole bdlanename : text down 2 medium tracked, soft\nrole bdcount : text down 2 medium, soft, on wash, corner gap x2, pad left gap /2, pad right gap /2\nrole bdcount.asked : text down 2 medium, jeff, on jeffwash2, corner gap x2, pad left gap /2, pad right gap /2\nrole bdcount.working : text down 2 medium, accent, on accentwash, corner gap x2, pad left gap /2, pad right gap /2\nrole bdcount.ready : text down 2 medium, sky, on skywash, corner gap x2, pad left gap /2, pad right gap /2\nrole bdcount.landing : text down 2 medium, teal, on tealwash, corner gap x2, pad left gap /2, pad right gap /2\nrole bdcards : between gap /2\nrole bdcard : on raised, corner gap, pad gap /2, pad left gap x1.5, pad right gap, lift gap /2\nrole bdcard.asked : on raised, rail jeff, corner gap, pad gap /2, pad left gap x1.5, pad right gap, lift gap /2\nrole bdcard.working : on raised, rail accent, corner gap, pad gap /2, pad left gap x1.5, pad right gap, lift gap /2\nrole bdcard.live : on raisedhi, rail accent, edge accent, corner gap, pad gap /2, pad left gap x1.5, pad right gap, lift gap /2\nrole bdcard.asking : on raised, rail warm, corner gap, pad gap /2, pad left gap x1.5, pad right gap, lift gap /2\nrole bdcard.ready : on raised, rail sky, corner gap, pad gap /2, pad left gap x1.5, pad right gap, lift gap /2\nrole bdcard.landing : on raised, rail teal, edge teal, corner gap, pad gap /2, pad left gap x1.5, pad right gap, lift gap /2\nrole bdcard.landed : corner gap, pad gap /4, pad left gap x1.5, pad right gap\nrole bdline : between gap\nrole bdtitle : text down medium, ink\nrole bdtitle.landed : text down, soft\nrole bdwho : text down 2, soft\nrole bdstate : text down 2 medium, accent\nrole bdstate.asking : text down 2 medium, warm\nrole bdmore : between gap /2, pad top gap /2, pad bottom gap /2, space above gap /2, border top rim\n# a5592: the music panel (home-music)\nrole musictop : between gap\nrole mediakey : text up 2, ink, on wash, corner gap x3, pad gap /2, pad left gap, pad right gap\nrole nowplaying : between gap /4\n# a5496: the home base's layout (home-tiling, home-panels, the *-small one-line views)\nrole stage : between gap x2\nrole top : between gap x2\nrole clock : between gap\nrole clocktime : text up 3 strong, ink\nrole clockday : text down, soft\nrole tiling : between gap x2\nrole pinned : between gap\nrole tilecol : between gap x2\nrole tilefoot : height gap x6\nrole pane : on glass, edge rim, corner gap x2, pad gap x2, between gap\nrole pane.big : on glassdeep, edge accent, corner gap x2, pad gap x2, between gap\nrole panehead : between gap\nrole panetitle : text up medium, ink\nrole panesum : text down, soft\nrole panebody : between gap\nrole summary : text down, soft\nrole shelf : between gap /2\nrole dockchip : soft, edge rim, corner gap, pad gap /2, pad left gap, pad right gap\nrole dockchip.on : ink, on wash, edge accent, corner gap, pad gap /2, pad left gap, pad right gap\nrole chipname : text down medium\nrole chipsum : text down 2, soft\n# a5530: the widgets in the home base's top bar (home-widgets): clock, now, pomodoro, notices\nrole widgets : between gap x3, align center\nrole widget : align center\nrole widget.wide : align center\nrole wclock : between gap\nrole wtime : text up 3 medium, ink\nrole wdate : text down, soft\nrole nowbar : between gap\nrole nowline : between gap, on wash, corner gap x2, pad gap /2, pad left gap x1.5, pad right gap x1.5\nrole nowlabel : text down 2 medium tracked, accent\nrole nowtext : text down, ink, width 22em\nrole pomo : between gap\nrole pomotimer : between gap, align center\nrole pomoring : text down medium, accent, width gap x7\nrole pomoring.still : text down medium, soft, width gap x7\nrole pomoring.done : text down medium, warm, width gap x7\nrole pomoside : between gap /4\nrole pomomode : text down 2 medium tracked, soft\nrole pomomode.on : text down 2 medium tracked, accent\nrole pomoacts : between gap /2\nrole pomobtn : text down 2 medium, night, on accent, corner gap x2, pad gap /4, pad left gap, pad right gap\nrole pomochip : text down 2, soft, edge rim, corner gap x2, pad gap /4, pad left gap, pad right gap\nrole nbar : between gap\nrole nbell : between gap, on glass, edge rim, corner gap x2, pad gap /2, pad left gap x1.5, pad right gap /2, width 34em\nrole nquiet : text down, soft\nrole nheld : text down, soft\nrole nfirst : between gap\nrole nline : between gap\nrole ndot : text down 2, sky\nrole ndot.landed : text down 2, accent\nrole ndot.asking : text down 2, warm\nrole ndot.call : text down 2, jeff\nrole nlabel : text down medium, ink\nrole ntitle : text down, soft\nrole nopen : between gap /2\nrole ncount : text down 2 medium, night, on accent, corner gap x2, pad left gap, pad right gap\nrole nlist : on glassdeep, edge rim, corner gap x1.5, pad gap, width 30em, lift gap\nrole nfeed : between gap /2\nrole nitems : between gap /2\nrole nhead : text down 2 medium tracked, soft, space above gap /2\nrole nitem : on wash, corner gap, pad gap /2, pad left gap, between gap /2\nrole nmain : between gap /4\nrole ntop : between gap /2\nrole nx : text down, soft, pad left gap /2, pad right gap /2\n# a5949: the Writing room in the home base (writing, doc-page, design-review): design-review's page, in this style's glass\ntoken card = #17221E\ntoken hush = ink at 50%\ntoken ghost = ink at 12%\ntoken mark = #E89A5B\nrole sheet : between gap\nrole toolbar : between gap, pad bottom gap, border bottom rim\nrole railhead : text.mono down tracked, accent\nrole rail : between gap /2, pad right gap\nrole tree : between gap /4, space above gap /2\nrole qcard : pad gap /2, pad left gap, corner gap\nrole qcard.on : on wash, edge accent, pad gap /2, pad left gap, corner gap\nrole qtitle : text down, ink\nrole viewtab : text.mono down, soft, pad gap /2\nrole viewtab.on : text.mono down, accent, pad gap /2, border bottom accent\nrole leaf : pad left gap x2, pad right gap x2\nrole aside : text down, soft, pad left gap, between gap, border left rim\nrole block : space below gap /2\nrole in1 : pad left gap x3\nrole in2 : pad left gap x6\nrole in3 : pad left gap x9\nrole bullet : accent, pad right gap /2\nrole box : text up, soft, pad right gap /2\nrole box.on : text up, accent, pad right gap /2\nrole figure : on wash, corner gap, pad gap x2\nrole h1 : text up 3 strong, ink, space above gap x2\nrole h2 : text up 2 medium, ink, space above gap x3, pad top gap, border top rim\nrole h3 : text medium, accent, space above gap x2\nrole quote : text up, ink, pad left gap x2, border left accent\nrole ticked : text medium, accent\nrole item : text, ink\nrole pip : text down, warm, pad left gap\nrole note : on raised, edge rim, corner gap, pad gap, between gap /2\nrole notewaiting : on warmwash, edge warm, corner gap, pad gap, between gap /2\nrole remark : text down, ink\nrole unread : text down, warm\nrole replybox : text down, ink, on wash, corner gap, pad gap /2\nrole resolve : text.mono down 2, soft\nrole talkpane : on glass, edge rim, corner gap x2, pad gap x2, between gap\nrole askcard : on warmwash, edge warm, corner gap, pad gap\nrole msg : text down, ink, pad top gap /2, pad bottom gap /2, border bottom rim\nrole msg.ask : text down, ink, on warmwash, edge warm, corner gap, pad gap\nrole msg.folded : text down, soft\nrole msgbody : text down, ink\nrole folded : text down, soft\nrole typing : text.mono down, soft\nrole pending : on glassdeep, edge accent, corner gap x1.5, pad gap, between gap /2, space above gap\nrole light : on warmwash\n# a6249: the Scripts lens (scripts, rocket-settings), appended to home-style\nrole scpage : between gap, pad gap\nrole schead : text up 3 medium, ink\nrole scintro : text down, soft\nrole sclist : between gap\nrole sccard : on wash, edge rim, corner gap, pad gap, between gap /2\nrole sctitle : text up 1 medium, ink\nrole scdoes : text, ink\nrole scmeta : text down, soft\nrole scwarn : text down, warm\nrole scpanel : between gap /4\nrole scsettings : between gap /4\nrole scsetting : between gap, align start\nrole sclabel : text, ink\nrole scnumber : text medium, ink, edge rim, corner gap /2, pad left gap /2, pad right gap /2, width 4em\nrole scwords : between gap /4\nrole sccode : text.mono down, ink, on glassdeep, corner gap /2, pad gap /2\n# a5994: the tiling's rail (a panel fills the room, the rest are titles) and the landing box of a drag; white, the hand's own colour\nrole rail : between gap, width 15em\nrole railitem : soft, on glass, edge rim, corner gap x1.5, pad gap, between gap /4\nrole railitem.on : ink, on glassdeep, edge ink, corner gap x1.5, pad gap, between gap /4\nrole landing : on wash, edge ink, corner gap x2\n# a5988: an agent's live feed in the viewer (home-feed), and the At work row being watched (home-work)\nrole busy.on : between gap, pad top gap /2, on wash, corner gap\nrole wfline : between gap, pad gap /4\nrole wftime : text.mono, soft\nrole wfkind : text down 2 medium tracked, accent, width gap x8\nrole wfkind.thoughts : text down 2 medium tracked, jeff, width gap x8\nrole wfkind.errors : text down 2 medium tracked, warm, width gap x8\nrole wfkind.life : text down 2 medium tracked, soft, width gap x8\nrole wfwords : text down, ink\nrole wfwords.errors : text down, warm\n# a6010 board roles: begin (board-lab/apply.py replaces this block)\n# a6010: the board as an inbox (direction-board-inbox). Round 2: LAMPLIT's rule (a6057), colour says whose move it is:\n# warm (amber) only on what waits on Alex, jeff (lilac) on a resident's move, accent (mint) only on an agent acting this\n# moment; everything else soft grey on the glass, and controls white. Lists, not tiles; nothing moves.\nrole nb : between gap x2\nrole nbbands : between gap x3\nrole nbband : between gap /2\nrole nbhead : between gap, pad bottom gap /2, pad left gap /2\nrole nbname : text down 2 medium tracked, soft\nrole nbname.need : text down 2 medium tracked, warm\nrole nbname.link : text down 2 medium, ink\nrole nbcount : text down 2 medium, soft\nrole nbcount.need : text down 2 medium, night, on warm, corner gap x2, pad left gap /1.5, pad right gap /1.5\nrole nbquiet : text down 2, soft\nrole nblive : text down 2, accent\nrole nbcards : between gap /2\nrole nblater : between gap /2, space above gap /2\nrole nbjeff : between gap /4, space above gap /2\nrole nbfold : text down 2 medium tracked, soft, pad gap /4\nrole nbfold.jeff : text down 2 medium tracked, jeff, pad gap /4\nrole nbchev : text down 2, faint\n# leaves/away (a6010, round 3): a needs-you card is not drawn while a press on its own answer waits for the desk\nrole nbneed : on raised, rail warm, corner gap, pad gap /1.5, pad left gap x1.5, pad right gap, leaves\nrole nbneed.fail : on raised, rail warm, corner gap, pad gap /1.5, pad left gap x1.5, pad right gap, leaves\nrole nbline : between gap, align center\nrole nbbody : between gap, pad top gap /2, pad bottom gap /2\nrole nbtop : between gap\nrole nbkind : text down 2, soft\nrole nbkind.review : text down 2 medium tracked, warm\nrole nbkind.design : text down 2 medium tracked, warm\nrole nbkind.fail : text down 2 medium tracked, warm\nrole nbwhen : text down 2, soft\nrole nbtitle : text medium, ink\nrole nbgist : text down, soft\nrole nbacts : between gap\nrole nbgo : text down 2 medium, night, on ink, corner gap x2, pad gap /4, pad left gap x1.5, pad right gap x1.5, away\nrole nbbtn : text down 2, ink, edge rim, corner gap x2, pad gap /4, pad left gap x1.5, pad right gap x1.5\nrole nbaway : text down 2, ink, edge rim, corner gap x2, pad gap /4, pad left gap x1.5, pad right gap x1.5, away\nrole nbinput : text down, ink, on wash, corner gap, pad gap\nrole nbrows : between gap /4\nrole nbrow : corner gap, pad gap /2, pad left gap x1.5, pad right gap\nrole nbrow.live : corner gap, pad gap /2, pad left gap x1.5, pad right gap\nrole nbrowtitle : text down, ink\nrole nbstage : text down 2, soft\nrole nbstage.live : text down 2 medium, accent\nrole nbstage.jeff : text down 2 medium, jeff\nrole nbstage.queued : text down 2, soft\nrole nbstage.working : text down 2, soft\nrole nbstage.asks : text down 2 medium, jeff\nrole nbstage.ready : text down 2, soft\nrole nbstage.landing : text down 2, soft\nrole nbnow : text down 2, accent\nrole nbnote : between gap /4, pad left gap, border left rim\nrole nbnoteby : text down 2 medium, soft\nrole nbnotetext : text down, ink\nrole nbdone : between gap, pad gap /4, pad left gap x1.5, pad right gap\nrole nbdonetitle : text down, soft\n# home-board-small, the one line: what needs Alex in amber, what waits on JEFF in lilac, the rest grey\nrole nbsmall : between gap\nrole nbsmall.need : text down medium, warm\nrole nbsmall.jeff : text down, jeff\n# the track of steps, and direction-board-focus (round 1, kept for the record)\nrole nbfocus : on raised, rail warm, corner gap x1.5, pad gap x2, pad left gap x2.5, between gap\nrole nbtitle.big : text up 2 medium, ink\nrole nbwho : text down 2, soft\nrole nbsteps : between gap /2\nrole nbstep : text down 2, faint\nrole nbstep.done : text down 2, soft\nrole nbstep.on : text down 2 medium, night, on ink, corner gap x2, pad left gap /1.5, pad right gap /1.5\nrole nbstep.jeff : text down 2 medium, night, on jeff, corner gap x2, pad left gap /1.5, pad right gap /1.5\nrole nbstep.ask : text down 2 medium, night, on jeff, corner gap x2, pad left gap /1.5, pad right gap /1.5\n# a6010 board roles: end"
