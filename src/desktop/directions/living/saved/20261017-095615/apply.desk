/4, space above gap /2\nrole qcard : pad gap /2, pad left gap, corner gap\nrole qcard.on : on wash, edge ink, pad gap /2, pad left gap, corner gap\nrole qtitle : text down, ink\nrole viewtab : text.mono down, soft, pad gap /2\nrole viewtab.on : text.mono down, ink, pad gap /2, border bottom ink\nrole leaf : pad left gap x2, pad right gap x2\nrole aside : text down, soft, pad left gap, between gap, border left rim\nrole block : space below gap /2\nrole in1 : pad left gap x3\nrole in2 : pad left gap x6\nrole in3 : pad left gap x9\nrole bullet : soft, pad right gap /2\nrole box : text up, soft, pad right gap /2\nrole box.on : text up, ink, pad right gap /2\nrole figure : on wash, corner gap, pad gap x2\nrole h1 : text up 3 strong, ink, space above gap x2\nrole h2 : text up 2 medium, ink, space above gap x3, pad top gap, border top rim\nrole h3 : text medium, ink, space above gap x2\nrole quote : text up, ink, pad left gap x2, border left rim\nrole ticked : text medium, soft\nrole item : text, ink\nrole pip : text down, warm, pad left gap\nrole note : on raised, edge rim, corner gap, pad gap, between gap /2\nrole notewaiting : on warmwash, edge warm, corner gap, pad gap, between gap /2\nrole remark : text down, ink\nrole unread : text down, warm\nrole replybox : text down, ink, on wash, corner gap, pad gap /2\nrole resolve : text.mono down 2, soft\nrole talkpane : on glass, edge rim, corner gap x2, pad gap x2, between gap\nrole askcard : on warmwash, edge warm, corner gap, pad gap\nrole msg : text down, ink, pad top gap /2, pad bottom gap /2, border bottom rim\nrole msg.ask : text down, ink, on warmwash, edge warm, corner gap, pad gap\nrole msg.folded : text down, soft\nrole msgbody : text down, ink\nrole folded : text down, soft\nrole typing : text.mono down, soft\nrole pending : on glassdeep, edge ink, corner gap x1.5, pad gap, between gap /2, space above gap\nrole light : on warmwash\n# a6249: the Scripts lens (scripts, rocket-settings), appended to home-style\nrole scpage : between gap, pad gap\nrole schead : text up 3 medium, ink\nrole scintro : text down, soft\nrole sclist : between gap\nrole sccard : on wash, edge rim, corner gap, pad gap, between gap /2\nrole sctitle : text up 1 medium, ink\nrole scdoes : text, ink\nrole scmeta : text down, soft\nrole scwarn : text down, warm\nrole scpanel : between gap /4\nrole scsettings : between gap /4\nrole scsetting : between gap, align start\nrole sclabel : text, ink\nrole scnumber : text medium, ink, edge rim, corner gap /2, pad left gap /2, pad right gap /2, width 4em\nrole scwords : between gap /4\nrole sccode : text.mono down, ink, on glassdeep, corner gap /2, pad gap /2\n# a5994: the tiling's rail (a panel fills the room, the rest are titles) and the landing box of a drag; white, the hand's own colour\nrole railitem : soft, on glass, edge rim, corner gap x1.5, pad gap, between gap /4\nrole railitem.on : ink, on glassdeep, edge ink, corner gap x1.5, pad gap, between gap /4\nrole landing : on wash, edge ink, corner gap x2\n# a5988: an agent's live feed in the viewer (home-feed), and the At work row being watched (home-work)\nrole busy.on : between gap, pad top gap /2, on wash, edge ink, corner gap\nrole wfline : between gap, pad gap /4\nrole wftime : text.label, faint\nrole wfkind : text.label medium tracked, accent, width gap x8\nrole wfkind.thoughts : text.label medium tracked, soft, width gap x8\nrole wfkind.errors : text.label strong tracked, ink, width gap x8\nrole wfkind.life : text.label tracked, faint, width gap x8\nrole wfwords : text down, ink\nrole wfwords.errors : text down medium, ink\n# a6010 board roles: begin (board-lab/apply.py replaces this block)\n# a6010: the board as an inbox (direction-board-inbox). Round 2: LAMPLIT's rule (a6057), colour says whose move it is:\n# warm (amber) only on what waits on Alex, jeff (lilac) on a resident's move, accent (mint) only on an agent acting this\n# moment; everything else soft grey on the glass, and controls white. Lists, not tiles; nothing moves.\nrole nb : between gap x2\nrole nbbands : between gap x3\nrole nbband : between gap /2\nrole nbhead : between gap, pad bottom gap /2, pad left gap /2\nrole nbname : text down 2 medium tracked, soft\nrole nbname.need : text down 2 medium tracked, warm\nrole nbname.link : text down 2 medium, ink\nrole nbcount : text down 2 medium, soft\nrole nbcount.need : text down 2 medium, night, on warm, corner gap x2, pad left gap /1.5, pad right gap /1.5\nrole nbquiet : text down 2, soft\nrole nblive : text down 2, accent\nrole nbcards : between gap /2\nrole nblater : between gap /2, space above gap /2\nrole nbjeff : between gap /4, space above gap /2\nrole nbfold : text down 2 medium tracked, soft, pad gap /4\nrole nbfold.jeff : text down 2 medium tracked, jeff, pad gap /4\nrole nbchev : text down 2, faint\n# leaves/away (a6010, round 3): a needs-you card is not drawn while a press on its own answer waits for the desk\nrole nbneed : on raised, rail warm, corner gap, pad gap /1.5, pad left gap x1.5, pad right gap, leaves\nrole nbneed.fail : on raised, rail warm, corner gap, pad gap /1.5, pad left gap x1.5, pad right gap, leaves\nrole nbline : between gap, align center\nrole nbbody : between gap, pad top gap /2, pad bottom gap /2\nrole nbtop : between gap\nrole nbkind : text down 2, soft\nrole nbkind.review : text down 2 medium tracked, warm\nrole nbkind.design : text down 2 medium tracked, warm\nrole nbkind.fail : text down 2 medium tracked, warm\nrole nbwhen : text down 2, soft\nrole nbtitle : text medium, ink\nrole nbgist : text down, soft\nrole nbacts : between gap\nrole nbgo : text down 2 medium, night, on ink, corner gap x2, pad gap /4, pad left gap x1.5, pad right gap x1.5, away\nrole nbbtn : text down 2, ink, edge rim, corner gap x2, pad gap /4, pad left gap x1.5, pad right gap x1.5\nrole nbaway : text down 2, ink, edge rim, corner gap x2, pad gap /4, pad left gap x1.5, pad right gap x1.5, away\nrole nbinput : text down, ink, on wash, corner gap, pad gap\nrole nbrows : between gap /4\nrole nbrow : corner gap, pad gap /2, pad left gap x1.5, pad right gap\nrole nbrow.live : corner gap, pad gap /2, pad left gap x1.5, pad right gap\nrole nbrowtitle : text down, ink\nrole nbstage : text down 2, soft\nrole nbstage.live : text down 2 medium, accent\nrole nbstage.jeff : text down 2 medium, jeff\nrole nbstage.queued : text down 2, soft\nrole nbstage.working : text down 2, soft\nrole nbstage.asks : text down 2 medium, jeff\nrole nbstage.ready : text down 2, soft\nrole nbstage.landing : text down 2, soft\nrole nbnow : text down 2, accent\nrole nbnote : between gap /4, pad left gap, border left rim\nrole nbnoteby : text down 2 medium, soft\nrole nbnotetext : text down, ink\nrole nbdone : between gap, pad gap /4, pad left gap x1.5, pad right gap\nrole nbdonetitle : text down, soft\n# home-board-small, the one line: what needs Alex in amber, what waits on JEFF in lilac, the rest grey\nrole nbsmall : between gap\nrole nbsmall.need : text down medium, warm\nrole nbsmall.jeff : text down, jeff\n# the track of steps, and direction-board-focus (round 1, kept for the record)\nrole nbfocus : on raised, rail warm, corner gap x1.5, pad gap x2, pad left gap x2.5, between gap\nrole nbtitle.big : text up 2 medium, ink\nrole nbwho : text down 2, soft\nrole nbsteps : between gap /2\nrole nbstep : text down 2, faint\nrole nbstep.done : text down 2, soft\nrole nbstep.on : text down 2 medium, night, on ink, corner gap x2, pad left gap /1.5, pad right gap /1.5\nrole nbstep.jeff : text down 2 medium, night, on jeff, corner gap x2, pad left gap /1.5, pad right gap /1.5\nrole nbstep.ask : text down 2 medium, night, on jeff, corner gap x2, pad left gap /1.5, pad right gap /1.5\n# a6010 board roles: end\n# ===== LAMPLIT (a6057, the HUD sprint's lane 3; round 3, converged with lanes 1 and 2 on the design table a6049).\n# The rule: the house at night, seen from outside. Only what is alive gives light, and colour says whose move it is.\n#   warm    Alex's move: it waits on him              accent  an agent acting this moment (mint)\n#   jeff    a resident's move (JEFF or another)       ink     chosen, and every control (white)\n#   everything else is ink, soft or faint on glass, wash, raised: the machine's, or nobody's (queued, ready, past).\n# Numbers and times are in a mono, so they line up and do not jitter. Nothing moves but the timer's own count.\n# THE RULE FOR A ROLE ADDED LATER: a role names a meaning, not a paint. Its colours are only these tokens: warm, jeff,\n# accent, ink, soft, faint, ghost, night (text on a light face), and the materials glass, glassdeep, wash, raised,\n# raisedhi, mine, rim (and their *wash forms: warmwash, jeffwash, accentwash); never a hex. A lens that adds roles\n# appends them to home-style, one desk line each. src/desktop/directions/living/apply.py lint lists any role\n# that breaks this and any role a lens in the Home base room uses that home-style lacks.\n# How this text is made: apply.py reads the live home-style, adds a5988's feed roles (wf*) where it lacks them, then\n# these lines, and keeps each name once (where it first stood, in its last words): one flat style. Lane 1's board roles\n# (nb*) are its own marked block, written by its apply and never overridden here.\n# the four lights\n# home-style's other colour tokens, folded into the rule: the machine's lanes are grey; a mark in a document is warm\ntoken text.big = mono 30/1\ntoken text.num = mono 26/1\ntoken text.label = mono 11/1.4\n# --- the glance (home-glance)\nrole lgband : between gap x5, align center\nrole lgclock : between gap /4\nrole lgtime : text.big, ink\nrole lgday : text.label tracked, soft\nrole lgsentence : between gap x3, align center, pad left gap x4, border left rim\nrole lgstat : between gap, align center, corner gap, pad gap /2, pad left gap, pad right gap\nrole lgstat.on : between gap, align center, corner gap, pad gap /2, pad left gap, pad right gap, on wash, edge ink\nrole lgnum : text.num, soft\nrole lgnum.you : text.num medium, warm\nrole lgnum.lit : text.num medium, accent\nrole lgword : text down, faint\nrole lgword.you : text down medium, warm\nrole lgword.lit : text down, accent\nrole lgcalm : text down, faint\n# --- The house (home-house, home-house-small)\nrole lhouse : between gap x1.5\nrole lhlist : between gap /2\nrole lhme : between gap x1.5, pad gap /1.5, pad left gap x1.5, on wash, corner gap, rail warm\nrole lhname.you : text medium, warm, width 4em\nrole lhdoing : text, ink\nrole lhbeing : on raised, rail accent, corner gap, pad gap /1.5, pad left gap x1.5, between gap /4\nrole lhbeing.asks : on jeffwash, rail jeff, corner gap, pad gap /1.5, pad left gap x1.5, between gap /4\nrole lhbeing.you : on warmwash, rail warm, corner gap, pad gap /1.5, pad left gap x1.5, between gap /4\nrole lhbeing.on : on raisedhi, rail accent, edge ink, corner gap, pad gap /1.5, pad left gap x1.5, between gap /4\nrole lhcol : between gap /2\nrole lhhead : between gap x1.5\nrole lhwhat : text medium, ink\nrole lhwho : text.label, soft\nrole lhname : text medium, ink\nrole lhname.jeff : text medium, jeff\nrole lhline : between gap\nrole lhstate.asks : text.label medium, jeff\nrole lhstate.you : text.label medium, warm\nrole lhsince : text.label, faint\nrole lhword : text down, soft\nrole lhword.now : text down, ink\nrole lhfocus : text down, soft\nrole lhrest : between gap, pad top gap, border top rim\nrole lhrestlabel : text.label tracked, faint\nrole lhrestnames : between gap x1.5\nrole lhrestname : text down, faint\nrole lhrestname.on : text down medium, ink\nrole lhcalm : text down, faint\nrole lhsmall : between gap\nrole lhsmall.lit : text down medium, accent\n# --- the timer as one line (home-timer, home-timer-bar): running is alive, done is your move, idle grey\nrole ltimer : between gap, align center\nrole ltmode : text.label tracked, faint\nrole ltmode.on : text.label medium tracked, accent\nrole ltmode.done : text.label medium tracked, warm\nrole lttime : text.label medium, soft\nrole lttime.on : text.label medium, accent\nrole ltgo : text down 2 medium, night, on ink, corner gap x2, pad gap /4, pad left gap, pad right gap\nrole ltgo.done : text down 2 medium, night, on warm, corner gap x2, pad gap /4, pad left gap, pad right gap\nrole ltbtn : text down 2, soft, edge rim, corner gap x2, pad gap /4, pad left gap, pad right gap\nrole ltx : text down, faint, pad left gap /2, pad right gap /2\n# --- the notices (home-notices): what asks you is warm, what only happened is grey\nrole ndot.you : text down 2, warm\nrole nlabel.you : text down medium, warm\nrole ncounts : between gap /2\nrole ncount.you : text.label medium, night, on warm, corner gap x2, pad left gap /1.5, pad right gap /1.5\nrole nmore : text down 2, soft, pad left gap /2, pad right gap /2\nrole nhead.you : text.label tracked, warm, space above gap /2\nrole nitem.you : on warmwash, corner gap, pad gap /2, pad left gap, between gap /2, rail warm\nrole nat : text.label, faint\n# --- a5988's live feed: actions are the agent acting (accent), thoughts grey, life faint; an error is loud by weight,\n# not colour (warm would say it is yours)\n# --- the frame: panes are dark glass with a hairline; their titles are quiet labels, so the contents lead\n# --- chrome that wore accent in home-style is chosen or a control: white (accent now means alive, only)\n# --- the old board (home-board) and At work, if still worn: a card is lit only while its worker is at work; one\n# that asks a resident is lilac; the rest grey\n# --- what waits on you is the warm list\n# --- the chat: JEFF lilac, you plain\n# --- the old ring timer (home-pomodoro), if still worn: running is alive; idle grey; done is your move"
look f5204
do create f5204 kind=note title=home-timer tags=lens style=home-style text="# home-timer: the focus timer as one line (a6057, the HUD sprint's lane 3), in the You row of The house, and in the top\n# bar (home-timer-bar) only while The house is put away, so it is always somewhere and never twice. Same facts as\n# home-pomodoro (a5530; Alex's timer note role=pomodoro actor=\$me: mode, focus=, rest=, state, started=, left=,\n# paused=), same presses, same `on end`; only its face is smaller: the word, the time left counting in a mono (the\n# painter's `live until` without the ring), and the one press that makes sense now. Running is alive (mint); done is\n# your move (amber); idle and paused are grey.\npomo : row\n role ltimer\n of prop:role=pomodoro,prop:actor=\$me as t\n each timer\ntimer : row\n role ltimer\n let whole = \$t.focus * 60 when \$t.mode = \"focus\"\n let whole = \$t.rest * 60 otherwise\n let ends = \$t.started + \$t.left * 1m / 60\n let held = \$t.left - (\$t.paused - \$t.started) / 1m * 60\n let label = \"focus done\" when \$t.state = \"done\" and \$t.mode = \"focus\"\n let label = \"break over\" when \$t.state = \"done\"\n let label = \"focus\" when \$t.mode = \"focus\"\n let label = \"break\" otherwise\n mode : text \"\$(label)\"\n  role ltmode\n  role ltmode.on when \$t.state = \"running\"\n  role ltmode.done when \$t.state = \"done\"\n running : text \"\$(ends) of \$(whole)\"\n  live until\n  role lttime.on\n  only when \$t.state = \"running\"\n  on end do prop \$t state=done\n paused : text \"\$(held) of \$(whole)\"\n  live until\n  role lttime\n  only when \$t.state = \"paused\"\n idle : text \"\$(whole) of \$(whole)\"\n  live until\n  role lttime\n  only when (\$t.state or \"idle\") = \"idle\"\n start : text \"Start\"\n  role ltgo\n  only when (\$t.state or \"idle\") = \"idle\"\n  let seen = (\$t.started or \"\") + (\$t.left or \"\")\n  on click do prop \$t state=running started=\$now left=\$(whole)\n pause : text \"Pause\"\n  role ltbtn\n  only when \$t.state = \"running\"\n  let seen = \$t.paused or \"\"\n  on click do prop \$t state=paused paused=\$now\n resume : text \"Resume\"\n  role ltgo\n  only when \$t.state = \"paused\"\n  let seen = (\$t.started or \"\") + (\$t.left or \"\")\n  on click do prop \$t state=running started=\$now left=\$(held)\n rest : text \"Break\"\n  role ltgo.done\n  only when \$t.state = \"done\" and \$t.mode = \"focus\"\n  let seen = (\$t.started or \"\") + (\$t.left or \"\")\n  on click do prop \$t mode=break state=running started=\$now left=\$(\$t.rest * 60)\n back : text \"Focus\"\n  role ltgo.done\n  only when \$t.state = \"done\" and \$t.mode = \"break\"\n  let seen = (\$t.started or \"\") + (\$t.left or \"\")\n  on click do prop \$t mode=focus state=running started=\$now left=\$(\$t.focus * 60)\n reset : text \"×\"\n  role ltx\n  only when (\$t.state or \"idle\") != \"idle\"\n  on click do prop \$t state=idle"
do create f5204 kind=note title=home-timer-bar tags=lens,widget style=home-style slot=bar order=3 size=s text="# home-timer-bar: the timer in the top bar, only while The house is not showing (a6057). The timer lives in The house's\n# You row; when Alex shelves that panel (or keeps no panel tagged glance-work), or fills the room with another panel\n# (The house is then only a title on the rail), it comes up here, so it is never lost and never shown twice (and its\n# `on end` is drawn once). A widget: tag widget, slot=bar, order=3.\nbar : row\n role ltimer\n of prop:role=home-layout,prop:actor=\$me as lay\n each place\nplace : row\n role ltimer\n away : row\n  only when count(prop:role=home-panel,prop:actor=\$me,tag:glance-work,prop:shelf=no) = 0\n  lens home-timer\n railed : row\n  of prop:role=home-panel,prop:actor=\$me,tag:glance-work,prop:shelf=no as hp\n  each railtimer\nrailtimer : row\n only when \$index = 1 and (\$lay.full or \"\") != \"\" and \$item != (\$lay.full or \"\")\n lens home-timer"
do create f5204 kind=note title=home-glance tags=lens,widget style=home-style slot=bar order=1 size=m text="# home-glance: the two-second glance at the top left of the home base (a6057, the HUD sprint's lane 3, LAMPLIT). The time,\n# then one sentence of the state of everything, in numbers: what waits on you (amber, the only warm colour on the\n# screen), who is at work this moment (mint: something alive), then the machine's queue in grey. A count of nothing is\n# left out, so the sentence is as short as the day is quiet; when nothing waits on you it says so, faint.\n# Round 2 (borrowed from lane 2, a5994: full= on the layout): each number is also the way in. A press fills the room\n# with the panel that answers it (a press again gives the room back), taking it off the shelf if it was there. Which\n# panel answers is the panel's own tag: glance-you, glance-work, glance-board (one panel may answer several: lane 1's\n# inbox answers you and board), so whichever panel Alex keeps claims a number by one tag, and this lens names none. A\n# number no panel claims is still said; it just opens nothing. When two panels claim one (Waiting on you and lane 1's\n# inbox both answer 'you'), the one that is out wins (by shelf: no before yes), else the first in the room.\n# What waits on you is counted as lane 1's NEEDS YOU counts it (a6010, round 2): a look, a design waiting on your word,\n# and a stuck commission you asked for (one a resident asked for is JEFF's to answer); kept the same as the panel it\n# opens, so the two numbers always agree.\n# A widget: tag widget, slot=bar, order=1 (it takes the clock's place: home-clock is untagged where this is worn).\nglance : row\n role lgband\n let you = count(tag:ready-for-review,-prop:review=later) + count(prop:design=waiting,-prop:review=later) + count(prop:commission=failed,prop:asked_by=\$me,-prop:review=later)\n let busy = count(house doing=working)\n let queued = count(prop:commission=asked)\n let ready = count(prop:commission=ready)\n let landing = count(prop:commission=landing)\n let youword = \"waits on you\" when you = 1\n let youword = \"wait on you\" otherwise\n clock : column\n  role lgclock\n  time : text \"\$today\"\n   live clock\n   role lgtime\n  day : text \"\$today\"\n   live date\n   role lgday\n sentence : row\n  role lgsentence\n  lays : row\n   role lgsentence\n   of prop:role=home-layout,prop:actor=\$me as lay\n   each stats\n  plain : text \"\$(you) \$(youword) · \$(busy) at work\"\n   role lgword\n   only when count(prop:role=home-layout,prop:actor=\$me) = 0\nstats : row\n role lgsentence\n let byou = count(prop:role=home-panel,prop:actor=\$me,tag:glance-you)\n let bwork = count(prop:role=home-panel,prop:actor=\$me,tag:glance-work)\n let bboard = count(prop:role=home-panel,prop:actor=\$me,tag:glance-board)\n you : row\n  only when you > 0\n  of prop:role=home-panel,prop:actor=\$me,tag:glance-you as p\n  by shelf\n  each youstat\n youplain : row\n  role lgstat\n  only when you > 0 and byou = 0\n  n : text \"\$(you)\"\n   role lgnum.you\n  w : text \"\$(youword)\"\n   role lgword.you\n calm : text \"nothing waits on you\"\n  role lgcalm\n  only when you = 0\n busy : row\n  only when busy > 0\n  of prop:role=home-panel,prop:actor=\$me,tag:glance-work as p\n  by shelf\n  each busystat\n busyplain : row\n  role lgstat\n  only when busy > 0 and bwork = 0\n  n : text \"\$(busy)\"\n   role lgnum.lit\n  w : text \"at work\"\n   role lgword.lit\n queued : row\n  only when queued > 0\n  of prop:role=home-panel,prop:actor=\$me,tag:glance-board as p\n  by shelf\n  each queuedstat\n queuedplain : row\n  role lgstat\n  only when queued > 0 and bboard = 0\n  n : text \"\$(queued)\"\n   role lgnum\n  w : text \"queued\"\n   role lgword\n ready : row\n  only when ready > 0\n  of prop:role=home-panel,prop:actor=\$me,tag:glance-board as p\n  by shelf\n  each readystat\n readyplain : row\n  role lgstat\n  only when ready > 0 and bboard = 0\n  n : text \"\$(ready)\"\n   role lgnum\n  w : text \"ready to land\"\n   role lgword\n landing : row\n  only when landing > 0\n  of prop:role=home-panel,prop:actor=\$me,tag:glance-board as p\n  by shelf\n  each landingstat\n landingplain : row\n  role lgstat\n  only when landing > 0 and bboard = 0\n  n : text \"\$(landing)\"\n   role lgnum\n  w : text \"landing\"\n   role lgword\n# one number and its words; pressed, the room is its panel's (or given back)\nyoustat : row\n role lgstat\n role lgstat.on when \$item = (\$lay.full or \"\")\n only when \$index = 1\n let was = (\$lay.full or \"\")\n let out = (\$p.shelf or \"\")\n on click when \$item != (\$lay.full or \"\") and (\$p.shelf or \"\") = \"yes\" do prop \$p shelf=no; do prop \$lay full=\$p\n on click when \$item != (\$lay.full or \"\") and (\$p.shelf or \"\") != \"yes\" do prop \$lay full=\$p\n on click when \$item = (\$lay.full or \"\") do prop \$lay full=\"\"\n n : text \"\$(you)\"\n  role lgnum.you\n w : text \"\$(youword)\"\n  role lgword.you\nbusystat : row\n role lgstat\n role lgstat.on when \$item = (\$lay.full or \"\")\n only when \$index = 1\n let was = (\$lay.full or \"\")\n let out = (\$p.shelf or \"\")\n on click when \$item != (\$lay.full or \"\") and (\$p.shelf or \"\") = \"yes\" do prop \$p shelf=no; do prop \$lay full=\$p\n on click when \$item != (\$lay.full or \"\") and (\$p.shelf or \"\") != \"yes\" do prop \$lay full=\$p\n on click when \$item = (\$lay.full or \"\") do prop \$lay full=\"\"\n n : text \"\$(busy)\"\n  role lgnum.lit\n w : text \"at work\"\n  role lgword.lit\nqueuedstat : row\n role lgstat\n role lgstat.on when \$item = (\$lay.full or \"\")\n only when \$index = 1\n let was = (\$lay.full or \"\")\n let out = (\$p.shelf or \"\")\n on click when \$item != (\$lay.full or \"\") and (\$p.shelf or \"\") = \"yes\" do prop \$p shelf=no; do prop \$lay full=\$p\n on click when \$item != (\$lay.full or \"\") and (\$p.shelf or \"\") != \"yes\" do prop \$lay full=\$p\n on click when \$item = (\$lay.full or \"\") do prop \$lay full=\"\"\n n : text \"\$(queued)\"\n  role lgnum\n w : text \"queued\"\n  role lgword\nreadystat : row\n role lgstat\n role lgstat.on when \$item = (\$lay.full or \"\")\n only when \$index = 1\n let was = (\$lay.full or \"\")\n let out = (\$p.shelf or \"\")\n on click when \$item != (\$lay.full or \"\") and (\$p.shelf or \"\") = \"yes\" do prop \$p shelf=no; do prop \$lay full=\$p\n on click when \$item != (\$lay.full or \"\") and (\$p.shelf or \"\") != \"yes\" do prop \$lay full=\$p\n on click when \$item = (\$lay.full or \"\") do prop \$lay full=\"\"\n n : text \"\$(ready)\"\n  role lgnum\n w : text \"ready to land\"\n  role lgword\nlandingstat : row\n role lgstat\n role lgstat.on when \$item = (\$lay.full or \"\")\n only when \$index = 1\n let was = (\$lay.full or \"\")\n let out = (\$p.shelf or \"\")\n on click when \$item != (\$lay.full or \"\") and (\$p.shelf or \"\") = \"yes\" do prop \$p shelf=no; do prop \$lay full=\$p\n on click when \$item != (\$lay.full or \"\") and (\$p.shelf or \"\") != \"yes\" do prop \$lay full=\$p\n on click when \$item = (\$lay.full or \"\") do prop \$lay full=\"\"\n n : text \"\$(landing)\"\n  role lgnum\n w : text \"landing\"\n  role lgword"
do create f5204 kind=note title=home-house-small tags=lens style=home-style text="# home-house-small: The house in one line (a6057), beside its panel's title and on its chip in the dock.\nn : row\n role lhsmall\n lit : text \"\$(count(house doing=working)) at work\"\n  role lhsmall.lit\n  only when count(house doing=working) > 0\n rest : text \"\$(count(house doing!=working)) resting\"\n  role summary\n  only when count(house doing!=working) > 0"
do create f5204 kind=note title=home-house tags=lens style=home-style text="# home-house: The house, who is here and what each is on right now (a6057, the HUD sprint's lane 3, LAMPLIT). A panel\n# (its panel note's lens=; it takes At work's place). One grammar for everyone, Alex included: who, what they are on,\n# since when, their word now. You first: your Now (shown only when set: nothing here asks you to type) and the timer.\n# Then each one at work: a worker by WHAT it is on (its card's brief=, else its title) and its maker (Claude, Codex),\n# never an id; its word is its card's now= (one line it keeps of what it is doing this minute), else its own latest\n# comment. A resident by name, its own Now (its corner's focus=) and its last reply. Who rests is one faint line of\n# names. A press on anyone opens their live feed in the middle (home-feed, a5988; the viewer's with=); the one you\n# watch has a white edge. The rail says whose move it is: mint (accent), at work this moment; lilac (jeff), it asks a\n# resident; amber (warm), it asks you. Placed: home-timer (the You row).\nhouse : column\n role lhouse\n mine : column\n  of prop:role=home-view,prop:actor=\$me as v\n  each roster\n plain : text \"No viewer note for you here (role=home-view, actor=you): a press has nowhere to open a feed.\"\n  role hint\n  only when count(prop:role=home-view,prop:actor=\$me) = 0\nroster : column\n role lhouse\n you : column\n  of prop:role=now,prop:actor=\$me as nw\n  each me\n lit : column\n  role lhlist\n  of house doing=working as h\n  each being\n rest : row\n  role lhrest\n  only when count(house doing!=working) > 0\n  label : text \"resting\"\n   role lhrestlabel\n  names : row\n   role lhrestnames\n   share 1\n   of house doing!=working as r\n   each restname\n empty : text \"No house is running here: no one is at work, and no one rests.\"\n  role lhcalm\n  only when count(house) = 0\nme : row\n role lhme\n name : text \"You\"\n  role lhname.you\n doing : text \"\$nw.doing\"\n  role lhdoing\n  share 1\n  clamp 1\n  only when (\$nw.doing or \"\") != \"\"\n gap : column\n  share 1\n  only when (\$nw.doing or \"\") = \"\"\n timer : row\n  lens home-timer\nbeing : column\n the \$h.corner as c\n role lhbeing\n role lhbeing.asks when \$c.commission = \"waiting\" and (\$c.asked_by or \"\") != \$me\n role lhbeing.you when \$c.commission = \"waiting\" and (\$c.asked_by or \"\") = \$me\n role lhbeing.on when \$v.viewing = \$h.corner and \$v.with = \"home-feed\"\n let was = \$v.viewing\n on click do prop \$v viewing=\$h.corner back=\"\$v.viewing\" find=\"\" with=home-feed\n work : column\n  role lhcol\n  only when (\$c.commission or \"\") != \"\"\n  let maker = \"Codex\" when (\$c.worker_provider or \"\") = \"codex\"\n  let maker = \"Claude\" otherwise\n  head : row\n   role lhhead\n   what : text \"\$((\$c.brief or \$c.title))\"\n    role lhwhat\n    share 1\n    clamp 1\n   asks : text \"asks \$c.asked_by\"\n    role lhstate.asks\n    role lhstate.you when (\$c.asked_by or \"\") = \$me\n    only when \$c.commission = \"waiting\"\n   who : text \"\$(maker)\"\n    role lhwho\n   since : text \"\$(day-or-time(\$changed.commission, \$today))\"\n    role lhsince\n    only when (\$changed.commission or \"\") != \"\"\n  now : text \"\$c.now\"\n   role lhword.now\n   clamp 1\n   only when (\$c.now or \"\") != \"\"\n  said : row\n   only when (\$c.now or \"\") = \"\"\n   of comments:\$c.item by=\$h.resident as m\n   each lastword\n dweller : column\n  role lhcol\n  only when (\$c.commission or \"\") = \"\"\n  let shown = \"JEFF\" when \$h.resident = \"jeff\"\n  let shown = \$h.resident otherwise\n  head : row\n   role lhhead\n   name : text \"\$(shown)\"\n    role lhname\n    role lhname.jeff when \$h.resident = \"jeff\"\n   focus : text \"\$c.focus\"\n    role lhfocus\n    share 1\n    clamp 1\n    only when (\$c.focus or \"\") != \"\"\n   gap : column\n    share 1\n    only when (\$c.focus or \"\") = \"\"\n   since : text \"\$h.since\"\n    role lhsince\n    only when (\$h.since or \"\") != \"\"\n  said : row\n   of turns:\$h.corner as t\n   each lastturn\nlastword : text \"\$m.text\"\n role lhword\n only when \$index = \$count\n clamp 1\n share 1\nlastturn : text \"\$t.said\"\n role lhword\n only when \$index = \$count\n clamp 1\n share 1\nrestname : text \"\$r.resident\"\n role lhrestname\n role lhrestname.on when \$v.viewing = \$r.corner and \$v.with = \"home-feed\"\n let was = \$v.viewing\n on click do prop \$v viewing=\$r.corner back=\"\$v.viewing\" find=\"\" with=home-feed"
read a5715
do rewrite a5715 text="# home-notices: the notices widget in LAMPLIT (a6057, the HUD sprint's lane 3, rewriting a5530's, whose\n# facts are the same: notes role=notice to=\$me, calls not yet answered, held while a focus runs). What changed: the\n# light says whose move it is, so something that asks you (a worker asks, a review, a design, a call) is amber and\n# something that only happened (landed) is grey; the bar shows the newest that waits on you before the newest that\n# only happened; the count beside it says how many of each; and the bar never prints the painter's clamp note.\n# A widget: tag widget, slot=bar, order=4 (home-notices is untagged where this is worn).\nbar : row\n  role nbar\n  of kind:surface,prop:role=notices,prop:actor=\$me as nb\n  each bell\n  none : text \"no notices surface (role=notices actor=you) in the Home base room\"\n    role hint\n    only when count(kind:surface,prop:role=notices,prop:actor=\$me) = 0\nbell : row\n  role nbell\n  let landed = count(prop:role=notice,prop:to=\$me,prop:topic=landed)\n  let asks = count(prop:role=notice,prop:to=\$me,-prop:topic=landed)\n  let calls = count(sayings for:\$me answered=no item!=\$nb.skip eid>\$nb.cleared)\n  let yours = asks + calls\n  let total = landed + yours\n  let focusing = count(prop:role=pomodoro,prop:actor=\$me,prop:state=running,prop:mode=focus)\n  quiet : text \"all quiet\"\n    role nquiet\n    only when total = 0\n  held : text \"\$(total) held until your break\"\n    role nheld\n    only when total > 0 and focusing > 0\n  first : row\n    role nfirst\n    share 1\n    only when total > 0 and focusing = 0\n    ask : row\n      share 1\n      only when asks > 0\n      of prop:role=notice,prop:to=\$me,-prop:topic=landed as nt\n      by -came\n      each noticeline\n    call : row\n      share 1\n      only when asks = 0 and calls > 0\n      of sayings for:\$me answered=no item!=\$nb.skip eid>\$nb.cleared as s\n      by -eid\n      each callline\n    news : row\n      share 1\n      only when yours = 0\n      of prop:role=notice,prop:to=\$me,prop:topic=landed as nt\n      by -came\n      each noticeline\n  counts : row\n    role ncounts\n    only when total > 0 and focusing = 0\n    yours : text \"\$(yours)\"\n      role ncount.you\n      only when yours > 0\n    landed : text \"\$(landed)\"\n      role ncount\n      only when landed > 0\n  open : column\n    role nopen\n    only when total > 0 and focusing = 0\n    fold \"all\" float handle nmore\n    list : column\n      role nlist\n      of prop:role=home-view,prop:actor=\$me as hv\n      each feed\nfeed : column\n  role nfeed\n  yourshead : text \"FOR YOU\"\n    role nhead.you\n    only when yours > 0\n  asks : column\n    role nitems\n    of prop:role=notice,prop:to=\$me,-prop:topic=landed as nt\n    by -came\n    clamp 8\n    each notice\n  calls : column\n    role nitems\n    of sayings for:\$me answered=no item!=\$nb.skip eid>\$nb.cleared as s\n    by -eid\n    clamp 8\n    each call\n  newshead : text \"HAPPENED\"\n    role nhead\n    only when landed > 0\n  news : column\n    role nitems\n    of prop:role=notice,prop:to=\$me,prop:topic=landed as nt\n    by -came\n    clamp 5\n    each notice\n# one line in the bar: the newest notice or call (the rest are built and not drawn, so no clamp note is painted)\nnoticeline : row\n  role nline\n  only when \$index = 1\n  let label = \"Landed\" when \$nt.topic = \"landed\"\n  let label = \"Asks you\" when \$nt.topic = \"asking\"\n  let label = \"For your review\" when \$nt.topic = \"review\"\n  let label = \"Waits on your word\" when \$nt.topic = \"design\"\n  let label = \$nt.topic otherwise\n  dot : text \"●\"\n    role ndot.you\n    role ndot when \$nt.topic = \"landed\"\n  what : text \"\$(label)\"\n    role nlabel.you\n    role nlabel when \$nt.topic = \"landed\"\n  about : row\n    share 1\n    the \$nt.about as a\n    title : text \"\$a.title\"\n      role ntitle\n      clamp 1\ncallline : row\n  role nline\n  only when \$index = 1\n  dot : text \"●\"\n    role ndot.you\n  what : text \"\$s.name\"\n    role nlabel.you\n  said : text \"\$s.said\"\n    role ntitle\n    share 1\n    clamp 1\n# in the list: one notice, its time, what it is about, and its ×; the newest 8 that ask you and 5 that happened are\n# built (a clamp: the rest are not built at all, which is what keeps this widget cheap; the list says how many wait)\nnotice : row\n  role nitem\n  role nitem.you when \$nt.topic != \"landed\"\n  let label = \"Landed\" when \$nt.topic = \"landed\"\n  let label = \"Asks you\" when \$nt.topic = \"asking\"\n  let label = \"For your review\" when \$nt.topic = \"review\"\n  let label = \"Waits on your word\" when \$nt.topic = \"design\"\n  let label = \$nt.topic otherwise\n  main : column\n    role nmain\n    share 1\n    on click do prop \$hv viewing=\$nt.about back=\"\$hv.viewing\" find=\"\"; do remove \$nt\n    top : row\n      role ntop\n      what : text \"\$(label)\"\n        role nlabel.you\n        role nlabel when \$nt.topic = \"landed\"\n      at : text \"\$(time(\$nt.came))\"\n        role nat\n    about : column\n      the \$nt.about as a\n      title : text \"\$a.title\"\n        role ntitle\n        clamp 1\n  x : text \"×\"\n    role nx\n    on click do remove \$nt\n# one call: who, where, a line of what they said; × is 'seen up to here'\ncall : row\n  role nitem.you\n  main : column\n    role nmain\n    share 1\n    let was = \$hv.back\n    on click do prop \$hv viewing=\$s.item back=\"\$hv.viewing\" find=\"\"\n    top : row\n      role ntop\n      who : text \"\$s.name\"\n        role nlabel.you\n      where : text \"in \$s.in · \$s.at\"\n        role nat\n        clamp 1\n    said : text \"\$s.said\"\n      role ntitle\n      clamp 1\n  x : text \"×\"\n    role nx\n    let was = \$nb.cleared\n    on click do prop \$nb cleared=\$s.eid"
