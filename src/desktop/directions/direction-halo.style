# direction-halo (a5534, worker-a5534, 15 Oct): the home base as light in a dark room. Pearly glass with deep round
# corners over the frost, a wide geometric display face, lilac for JEFF and mint for Alex, peach for what is alive.
# Pinned panels sit in a raised, glowing tray; loose ones lie flat. Living cards breathe. Every role of home-style is here.
font display = Unbounded, Segoe UI Variable Display, sans-serif
font sans = Manrope, Segoe UI Variable Text, sans-serif
font mono = DM Mono, Cascadia Code, monospace
token night = #0D0B1A
token paper = #0D0B1A
token ink = #F5F2FF
token accent = #9DF2D6
token warm = #FFC2A0
token jeff = #C9B8FF
token glass = #FFFFFF12
token glassdeep = #1B1833C4
token rim = #FFFFFF29
token soft = ink at 64%
token faint = #FFFFFF17
token mine = #9DF2D629
token jeffwash = #C9B8FF29
token warmwash = #FFC2A026
token wash = #FFFFFF10
token tray = #FFFFFF0A
token focus = #C9B8FF
token scrollbar = #FFFFFF33
token scrollbar_w = 4
token gap = 10
token ramp = 1.22
token text = sans 15/1.6
token text.mono = mono 12/1.5
token text.display = display 15/1.2
