+            parents = self._parents()
+            current, seen, chain = pid, set(), []
+            for _ in range(16):
+                if current in seen or current not in parents:
+                    raise Refused("host ancestry missing or cyclic")
+                seen.add(current)
+                birth = self._identity(current)
