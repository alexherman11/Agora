# home-viewer: the home base's middle (a5398). Find anything in the world, or press a pin, and it opens here, on the left
# of JEFF's chat (a5949, Alex 16 Oct: 'I want it open on the left side of this chat'); × gives the chat its room back
# and Back goes one step. What is open is the viewer's own note (role=home-view, actor=$me): viewing= the thing, back=
# the one before, find= the words in the box, pins= ids with commas, with= a lens to stand on the thing.
# Any lens opens here (a5949; Sable's a4270, a lens stood on a thing): with=<lens> draws the thing with that lens (Open
# with, or type a lens's name); a lens itself, opened here, runs (the dock's Writing opens the lens writing). Otherwise
# a document is drawn by doc-page (its words, comments and Talk); each other kind by its own lens, home-<kind>
# (home-note, home-chat, home-surface); anything else gets the plain card below.
# JEFF may set viewing= only when Alex asked to be shown something.
viewer : column
  share 1
  role viewer
  mine : column
    share 1
    of prop:role=home-view,prop:actor=$me as v
    each view
  lost : column
    share 1
    only when count(prop:role=home-view,prop:actor=$me) = 0
    chat : column
      share 1
      lens jeff-chat
view : column
  share 1
  role viewer
  let open = "yes" when ($v.viewing or "") != "" and $v.viewing != "a5080"
  let open = "no" otherwise
  let finding = "yes" when ($v.find or "") != ""
  let finding = "no" otherwise
  bar : row
    role findbar
    box : text "$v.find"
      role find
      hint "Find anything: a note, a chat, a board, a lens…"
      lines 1..1
      share 1
      commit enter only
      on edit do prop $v find="$value"
    clear : text "×"
      role tool
      only when ($v.find or "") != ""
      on click do prop $v find=""
    back : text "Back"
      role chip
      only when ($v.back or "") != ""
      on click do prop $v viewing="$v.back" back="$v.viewing" with=""
  pins : row
    role pins
    only when ($v.pins or "") != ""
    of $v.pins as p
    each pin
  split : row
    share 1
    gap
    left : column
      share 3
      only when open = "yes" or finding = "yes"
      found : column
        share 1
        role found
        scroll scroll
        let q = words-of($v.find)
        only when finding = "yes"
        none : text "Nothing holds those words."
          role meta
          only when count(?$q) = 0
        titles : column
          role foundlist
          of ?$q as f
          clamp 60
          each titled
        rest : column
          role foundlist
          of ?$q as f
          clamp 60
          each mentioned
      open : column
        share 1
        only when open = "yes" and finding = "no"
        of $v.viewing as r
        each shown
    chat : column
      share 2
      lens jeff-chat
pin : text "$title"
  role chip
  role chip.on when $item = $v.viewing
  clamp 1
  on click do prop $v viewing=$p back="$v.viewing" find="" with=""
titled : column
  only when $title has $v.find
  hit : row
    role hit
    on click do prop $v viewing=$f back="$v.viewing" find="" with=""
    kind : text "$kind"
      role meta
    title : text "$title"
      role who
      clamp 1
      share 1
mentioned : column
  only when $title !has $v.find
  hit : row
    role hit
    on click do prop $v viewing=$f back="$v.viewing" find="" with=""
    kind : text "$kind"
      role meta
    title : text "$title"
      role meta
      clamp 1
      share 1
shown : column
  share 1
  role shown
  let islens = "yes" when ($tags or "") has "lens" and $kind = "note"
  let islens = "no" otherwise
  let isdoc = "yes" when ($role or "") = "doc"
  let isdoc = "no" otherwise
  let using = ($v.with or "")
  head : row
    role viewhead
    title : text "$title"
      role heading
      clamp 2
      share 1
    kind : text "$kind · $item"
      role meta
    pop : text "Pop out"
      role chip
      only when islens = "yes" and using = ""
      on click host window $title
    close : text "×"
      role tool
      on click do prop $v viewing="" back="$v.viewing" with=""
  openwith : row
    role pins
    only when islens = "no"
    label : text "Open with"
      role meta
    page : text "page"
      role chip
      role chip.on when using = "doc-page" or (using = "" and isdoc = "yes")
      on click when using != "doc-page" do prop $v with=doc-page
    review : text "design-review"
      role chip
      role chip.on when using = "design-review"
      on click when using != "design-review" do prop $v with=design-review
    plain : text "its own look"
      role chip
      role chip.on when using = "" and isdoc = "no"
      only when using != "" or isdoc = "yes"
      on click when using != "" do prop $v with=""
    any : text "$v.with"
      role find
      hint "or a lens by name…"
      lines 1..1
      share 1
      commit enter only
      on edit do prop $v with="$value"
  with : column
    share 1
    only when using != ""
    lens $v.with
  run : column
    share 1
    only when using = "" and islens = "yes"
    lens $title
  doc : column
    share 1
    only when using = "" and islens = "no" and isdoc = "yes"
    lens doc-page
  known : column
    share 1
    only when using = "" and islens = "no" and isdoc = "no" and ($kind = "note" or $kind = "chat" or $kind = "surface")
    lens home-$kind
  plain : column
    share 1
    scroll scroll
    only when using = "" and islens = "no" and isdoc = "no" and $kind != "note" and $kind != "chat" and $kind != "surface"
    facts : text "status $status · owner $owner · asked by $asked_by"
      role meta
      only when ($status or "") != ""
    next : text "Next: $next"
      role meta
      marks
      only when ($next or "") != ""
    words : text "$text"
      role prose
      marks
