read a5206
do append a5206 line="# a5994: the tiling's rail (a panel fills the room, the rest are titles) and the landing box of a drag; white, the hand's own colour"
do append a5206 line="role rail : between gap, width 15em"
do append a5206 line="role railitem : soft, on glass, edge rim, corner gap x1.5, pad gap, between gap /4"
do append a5206 line="role railitem.on : ink, on glassdeep, edge ink, corner gap x1.5, pad gap, between gap /4"
do append a5206 line="role landing : on wash, edge ink, corner gap x2"
look f5204
do create f5204 kind=note title=drop-panel tags=verb on=f5189 text="# drop-panel <how> <panel> <next to> <column> <layout>: where a panel dragged in the home base lands (a5994; the lens home-tiling says it on each drop).\n# how: left or right = a new column beside <column>, holding the panel; first or last = a new column at that edge of <layout>;\n# top or bottom = above or below <next to>; swap = trade places with <next to>; end = last in <column> (its empty space).\n# A column the panel leaves empty goes, so the others take its room.\nset from = \$2.in\ndo create \$5 kind=surface title=column layout=column when \$1 = \"left\" or \$1 = \"right\" or \$1 = \"first\" or \$1 = \"last\"\ndo move \$new before=\$4 when \$1 = \"left\"\ndo move \$new after=\$4 when \$1 = \"right\"\ndo move \$new into=\$5 at=0 when \$1 = \"first\"\ndo move \$2 into=\$new when \$1 = \"left\" or \$1 = \"right\" or \$1 = \"first\" or \$1 = \"last\"\ndo move \$2 before=\$3 when \$1 = \"top\"\ndo move \$2 after=\$3 when \$1 = \"bottom\"\ndo swap \$2 \$3 when \$1 = \"swap\"\ndo move \$2 into=\$4 at=999 when \$1 = \"end\"\ndo remove \$from when count(in:\$from) = 0"
read a5690
do rewrite a5690 text="# home-panels: the menu from the bottom (a5496): every panel of the viewer's layout (home-tiling) as a chip in the dock,\n# with its one-line view; lit while the panel is out, dim while it is put away. A press puts it away, or brings it back\n# where it was. Placed at the right end of the dock (home-dock, a5500).\nshelf : row\n  role shelf\n  of prop:role=home-layout,prop:actor=\$me as lay\n  each chips\nchips : row\n  role shelf\n  of kind:note,in:\$lay.item,prop:role=home-panel as p\n  each chip\nchip : column\n  role dockchip\n  role dockchip.on when (\$p.shelf or \"\") != \"yes\"\n  let was = (\$lay.full or \"\")\n  on click when (\$p.shelf or \"\") = \"yes\" do prop \$p shelf=no\n  on click when (\$p.shelf or \"\") != \"yes\" and \$item = (\$lay.full or \"\") do prop \$p shelf=yes; do prop \$lay full=\"\"\n  on click when (\$p.shelf or \"\") != \"yes\" and \$item != (\$lay.full or \"\") do prop \$p shelf=yes\n  name : text \"\$title\"\n    role chipname\n    clamp 1\n  sum : column\n    role chipsum\n    only when (\$p.lesser or \"\") != \"\"\n    lens \$p.lesser"
read a5692
do rewrite a5692 text="# home-tiling: the home base's panels, laid out by each person (a5496; made to work by a5994). Alex, 16 Oct: 'I need\n# things to be draggable around this screen. It should snap to various sizes as I move it around, pushing other things\n# out of the way ... Double-clicking a window should make it fill the screen or the dominant space ... while leaving\n# the chat here.' Where each panel is, is the viewer's own world data: a surface (role=home-layout, actor=\$me) holding\n# column surfaces (span=1|2|3, its share of the width), each holding panel notes (role=home-panel): lens= what it shows,\n# lesser= its one-line view, shelf=yes put away. On the layout: full= the panel that fills the space, pin=left|right\n# the chat's side (right when unsaid).\n# Drag a panel by its title. Over another panel, the landing box shows where it goes: near its left or right edge, a\n# new column there; near its top or bottom, above or below it; its middle, the two trade places. Over a column's empty\n# foot, it goes last there and takes that room (near the foot's left or right edge, a new column there). A column left empty goes, and the others take its width. Each drop is\n# one use of the verb drop-panel (Home base). ⇔ widens a column: a third, a half, two thirds of the room. A\n# double-click on a title fills the room with that panel (the others become a rail of titles; the chat stays); again,\n# or ⤡, gives it back. – shelves it (home-panels, in the dock). Nothing scrolls, nothing moves by itself.\nstage : column\n  share 1\n  role stage\n  of prop:role=home-layout,prop:actor=\$me as lay\n  each desk\n  lost : text \"No layout of yours here: a surface in Home base with role=home-layout actor=<you>, holding column surfaces of panel notes (src/desktop/home-layout/layout-alex.desk makes Alex's).\"\n    role hint\n    only when count(prop:role=home-layout,prop:actor=\$me) = 0\ndesk : column\n  share 1\n  role stage\n  top : row\n    role top\n    widgets : row\n      lens home-widgets\n    brand : text \"AGORA\"\n      role brand\n    gap : column\n      share 1\n    how : text \"drag a title anywhere · double-click a title to fill the room · ⇔ widens · – shelves it\"\n      role hint\n    side : text \"chat ⇆\"\n      role tool\n      let at = (\$lay.pin or \"right\")\n      on click when (\$lay.pin or \"right\") = \"right\" do prop \$lay pin=left\n      on click when (\$lay.pin or \"right\") = \"left\" do prop \$lay pin=right\n    keys : text \"Ctrl+Alt+J or Esc closes\"\n      role meta\n  body : row\n    share 1\n    role body\n    scroll none\n    chatleft : column\n      let wide = 7 when (\$lay.full or \"\") != \"\"\n      let wide = 32 when (\$lay.full or \"\") = \"\" and count(prop:role=home-view,prop:actor=\$me,prop:viewing,-prop:viewing=a5080) + count(prop:role=home-view,prop:actor=\$me,prop:find) > 0\n      let wide = 7 otherwise\n      share \$wide\n      role pinned\n      scroll none\n      only when (\$lay.pin or \"right\") = \"left\"\n      lens home-viewer\n    tiling : row\n      share 13\n      role tiling\n      scroll none\n      only when (\$lay.full or \"\") = \"\"\n      of kind:surface,in:\$lay.item as col\n      each column\n    filled : row\n      share 13\n      role tiling\n      scroll none\n      only when (\$lay.full or \"\") != \"\"\n      rail : column\n        role rail\n        scroll none\n        of kind:note,in:\$lay.item,prop:role=home-panel,prop:shelf=no as r\n        each railitem\n      room : column\n        share 1\n        role tilecol\n        scroll none\n        of kind:note,in:\$lay.item,prop:role=home-panel,prop:shelf=no as p\n        each fullpanel\n    chatright : column\n      let wide = 7 when (\$lay.full or \"\") != \"\"\n      let wide = 32 when (\$lay.full or \"\") = \"\" and count(prop:role=home-view,prop:actor=\$me,prop:viewing,-prop:viewing=a5080) + count(prop:role=home-view,prop:actor=\$me,prop:find) > 0\n      let wide = 7 otherwise\n      share \$wide\n      role pinned\n      scroll none\n      only when (\$lay.pin or \"right\") != \"left\"\n      lens home-viewer\ncolumn : column\n  let span = (\$col.span or 1)\n  share \$span\n  role tilecol\n  scroll none\n  only when count(kind:note,in:\$col.item,prop:role=home-panel,prop:shelf=no) > 0\n  of kind:note,in:\$col.item,prop:role=home-panel,prop:shelf=no as p\n  each panel\n  foot : column\n    share 1\n    role tilefoot\n    on drop grip at left do drop-panel left \$carried \$col \$col \$lay\n    on drop grip at right do drop-panel right \$carried \$col \$col \$lay\n    on drop grip do drop-panel end \$carried \$col \$col \$lay\npanel : column\n  role pane\n  scroll none\n  on drop grip at left do drop-panel left \$carried \$p \$col \$lay\n  on drop grip at right do drop-panel right \$carried \$p \$col \$lay\n  on drop grip at top do drop-panel top \$carried \$p \$col \$lay\n  on drop grip at bottom do drop-panel bottom \$carried \$p \$col \$lay\n  on drop grip do drop-panel swap \$carried \$p \$col \$lay\n  grip : row\n    role panehead\n    carry\n    let was = (\$lay.full or \"\")\n    on double when (\$lay.full or \"\") = \"\" do prop \$lay full=\$p\n    title : text \"\$title\"\n      role panetitle\n    sum : column\n      role panesum\n      share 1\n      only when (\$p.lesser or \"\") != \"\"\n      lens \$p.lesser\n    gap : column\n      share 1\n      only when (\$p.lesser or \"\") = \"\"\n    wider : text \"⇔\"\n      role tool\n      let next = 2 when (\$col.span or 1) = 1\n      let next = 3 when (\$col.span or 1) = 2\n      let next = 1 otherwise\n      on click do prop \$col span=\$next\n    away : text \"–\"\n      role tool\n      let out = (\$shelf or \"\")\n      on click do prop \$p shelf=yes\n  body : column\n    role panebody\n    lens \$p.lens\nrailitem : column\n  role railitem\n  role railitem.on when \$item = (\$lay.full or \"\")\n  let was = (\$lay.full or \"\")\n  on click when \$item != (\$lay.full or \"\") do prop \$lay full=\$r\n  name : text \"\$title\"\n    role chipname\n    clamp 1\n  sum : column\n    role chipsum\n    only when (\$r.lesser or \"\") != \"\"\n    lens \$r.lesser\nfullpanel : column\n  share 1\n  role pane\n  scroll none\n  only when \$item = (\$lay.full or \"\")\n  grip : row\n    role panehead\n    let was = (\$lay.full or \"\")\n    on double when (\$lay.full or \"\") != \"\" do prop \$lay full=\"\"\n    title : text \"\$title\"\n      role panetitle\n    gap : column\n      share 1\n    back : text \"⤡\"\n      role tool\n      let was = (\$lay.full or \"\")\n      on click when (\$lay.full or \"\") != \"\" do prop \$lay full=\"\"\n    away : text \"–\"\n      role tool\n      let out = (\$shelf or \"\")\n      on click do prop \$p shelf=yes; do prop \$lay full=\"\"\n  body : column\n    role panebody\n    share 1\n    scroll none\n    lens \$p.lens"
read "home-style"
do append "home-style" line="# a5988: an agent's live feed in the viewer (home-feed), and the At work row being watched (home-work)\nrole busy.on : between gap, pad top gap /2, on wash, corner gap\nrole wfline : between gap, pad gap /4\nrole wftime : text.mono, soft\nrole wfkind : text down 2 medium tracked, accent, width gap x8\nrole wfkind.thoughts : text down 2 medium tracked, jeff, width gap x8\nrole wfkind.errors : text down 2 medium tracked, warm, width gap x8\nrole wfkind.life : text down 2 medium tracked, soft, width gap x8\nrole wfwords : text down, ink\nrole wfwords.errors : text down, warm"
look f5204
do create f5204 kind=note title=home-feed tags=lens style=home-style text="# home-feed (a5988, Alex 16 Oct: 'clicking on At work should allow me a view into their live conversation feed, all\n# their thoughts and actions taken'): what the agent of a thing is doing, live. Stood on a card (its worker=) or a\n# resident's corner (its actor=): At work (home-work) opens the one pressed in the viewer with with=home-feed, and the\n# house writes its feed while a viewer stands this lens on it: witnessed:feed-<id> (feeds.py), the last 500 lines,\n# secrets redacted; the newest 150 are drawn. Hidden reasoning is not readable: a thought is 'thought for N s' unless\n# its words were written. The viewer's note keeps what this view chose: feed_show= (thoughts, actions or errors; none\n# is all) and feed_held= (the newest line when Pause was pressed: the tail stands still there until Follow).\nfeed : column\n  share 1\n  let card = \$item\n  of prop:role=home-view,prop:actor=\$me as v\n  each watch\nwatch : column\n  share 1\n  role viewer\n  heads : column\n    of witnessed:feed-\$card kind=head as h\n    each top\n  none : text \"No feed yet: the house writes one while it is open here. If this stays, no house is running for this world.\"\n    role meta\n    only when count(witnessed:feed-\$card kind=head) = 0\n  follow : column\n    share 1\n    scroll end\n    only when (\$v.feed_held or 0) = 0 and (\$v.feed_show or \"\") = \"\"\n    of witnessed:feed-\$card kind!=head as e\n    clamp last 150\n    each line\n  followone : column\n    share 1\n    scroll end\n    only when (\$v.feed_held or 0) = 0 and (\$v.feed_show or \"\") != \"\"\n    of witnessed:feed-\$card kind!=head group=\$v.feed_show as e\n    clamp last 150\n    each line\n  held : column\n    share 1\n    scroll end\n    only when (\$v.feed_held or 0) > 0 and (\$v.feed_show or \"\") = \"\"\n    of witnessed:feed-\$card kind!=head n<=\$v.feed_held as e\n    clamp last 150\n    each line\n  heldone : column\n    share 1\n    scroll end\n    only when (\$v.feed_held or 0) > 0 and (\$v.feed_show or \"\") != \"\"\n    of witnessed:feed-\$card kind!=head group=\$v.feed_show n<=\$v.feed_held as e\n    clamp last 150\n    each line\ntop : column\n  role busy\n  title : row\n    who : text \"\$h.who\"\n      role who\n    state : text \"\$h.state\"\n      role chip\n      role chip.on when \$h.state = \"working\"\n    since : text \"at work since \$h.since, \$h.for\"\n      role meta\n      only when (\$h.since or \"\") != \"\"\n    room : text \"\"\n      share 1\n    kept : text \"\$h.events lines, \$h.from to \$h.newest\"\n      role meta\n      only when (\$h.from or \"\") != \"\"\n  tools : row\n    role pins\n    all : text \"All\"\n      role chip\n      role chip.on when (\$v.feed_show or \"\") = \"\"\n      on click when (\$v.feed_show or \"\") != \"\" do prop \$v feed_show=\"\"\n    thoughts : text \"Thoughts\"\n      role chip\n      role chip.on when \$v.feed_show = \"thoughts\"\n      on click when (\$v.feed_show or \"\") != \"thoughts\" do prop \$v feed_show=thoughts\n    actions : text \"Actions\"\n      role chip\n      role chip.on when \$v.feed_show = \"actions\"\n      on click when (\$v.feed_show or \"\") != \"actions\" do prop \$v feed_show=actions\n    errors : text \"Errors\"\n      role chip\n      role chip.on when \$v.feed_show = \"errors\"\n      on click when (\$v.feed_show or \"\") != \"errors\" do prop \$v feed_show=errors\n    room : text \"\"\n      share 1\n    pause : text \"Pause\"\n      role chip\n      only when (\$v.feed_held or 0) = 0\n      on click when (\$v.feed_held or 0) = 0 do prop \$v feed_held=\$h.last\n    heldat : text \"held at line \$v.feed_held of \$h.last\"\n      role meta\n      only when (\$v.feed_held or 0) > 0\n    go : text \"Follow\"\n      role chip.on\n      only when (\$v.feed_held or 0) > 0\n      on click when (\$v.feed_held or 0) > 0 do prop \$v remove=feed_held\nline : row\n  role wfline\n  at : text \"\$e.at\"\n    role wftime\n  kind : text \"\$e.kind\"\n    role wfkind\n    role wfkind.thoughts when \$e.group = \"thoughts\"\n    role wfkind.errors when \$e.group = \"errors\"\n    role wfkind.life when \$e.group = \"life\"\n  words : text \"\$e.text\"\n    role wfwords\n    role wfwords.errors when \$e.group = \"errors\"\n    share 1"
read "home-work"
do rewrite "home-work" text="# home-work: who of the house is at work now, one panel of the home base (a5208). Split out of home-base by a5496.\n# a5988 (Alex, 16 Oct: 'clicking on At work should allow me a view into their live conversation feed'): residents at\n# work and the workers of the cards at work (commission=working); pressing one opens its card (or the resident's corner)\n# in the viewer with its feed (the viewer's note, role=home-view, is given viewing=<id> with=home-feed; a5949's viewer\n# stands any lens on the thing open).\nwork : column\n  mine : column\n    of prop:role=home-view,prop:actor=\$me as v\n    each at\n  plain : column\n    only when count(prop:role=home-view,prop:actor=\$me) = 0\n    busy : column\n      of house doing=working as h\n      each still\nat : column\n  busy : column\n    of house doing=working as h\n    each busy\n  workers : column\n    of prop:commission=working as c\n    each worker\n  quiet : text \"Everyone is resting.\"\n    role meta\n    only when count(house doing=working) = 0 and count(prop:commission=working) = 0\nbusy : row\n  role busy\n  role busy.on when \$v.viewing = \$h.corner and \$v.with = \"home-feed\"\n  on click do prop \$v viewing=\$h.corner back=\"\$v.viewing\" find=\"\" with=home-feed\n  dot : text \"•\"\n    role live\n  who : text \"\$h.resident\"\n    role who\n    share 1\n  what : text \"working\"\n    role meta\nworker : row\n  role busy\n  role busy.on when \$v.viewing = \$c and \$v.with = \"home-feed\"\n  on click do prop \$v viewing=\$c back=\"\$v.viewing\" find=\"\" with=home-feed\n  dot : text \"•\"\n    role live\n  who : text \"\$c.worker\"\n    role who\n  what : text \"\$c.title\"\n    role meta\n    clamp 1\n    share 1\nstill : row\n  role busy\n  dot : text \"•\"\n    role live\n  who : text \"\$h.resident\"\n    role who\n    share 1\n  what : text \"working\"\n    role meta"
read "home-work-small"
do replace "home-work-small" old="n : text \"\$(count(house doing=working)) at work\"" new="n : text \"\$(count(house doing=working) + count(prop:commission=working)) at work\""
read a5206
do append a5206 line="# a6010 board roles: begin (board-lab/apply.py replaces this block)\n# a6010: the board as an inbox (direction-board-inbox). Round 2: LAMPLIT's rule (a6057), colour says whose move it is:\n# warm (amber) only on what waits on Alex, jeff (lilac) on a resident's move, accent (mint) only on an agent acting this\n# moment; everything else soft grey on the glass, and controls white. Lists, not tiles; nothing moves.\nrole nb : between gap x2\nrole nbbands : between gap x3\nrole nbband : between gap /2\nrole nbhead : between gap, pad bottom gap /2, pad left gap /2\nrole nbname : text down 2 medium tracked, soft\nrole nbname.need : text down 2 medium tracked, warm\nrole nbname.link : text down 2 medium, ink\nrole nbcount : text down 2 medium, soft\nrole nbcount.need : text down 2 medium, night, on warm, corner gap x2, pad left gap /1.5, pad right gap /1.5\nrole nbquiet : text down 2, soft\nrole nblive : text down 2, accent\nrole nbcards : between gap /2\nrole nblater : between gap /2, space above gap /2\nrole nbjeff : between gap /4, space above gap /2\nrole nbfold : text down 2 medium tracked, soft, pad gap /4\nrole nbfold.jeff : text down 2 medium tracked, jeff, pad gap /4\nrole nbchev : text down 2, faint\n# leaves/away (a6010, round 3): a needs-you card is not drawn while a press on its own answer waits for the desk\nrole nbneed : on raised, rail warm, corner gap, pad gap /1.5, pad left gap x1.5, pad right gap, leaves\nrole nbneed.fail : on raised, rail warm, corner gap, pad gap /1.5, pad left gap x1.5, pad right gap, leaves\nrole nbline : between gap, align center\nrole nbbody : between gap, pad top gap /2, pad bottom gap /2\nrole nbtop : between gap\nrole nbkind : text down 2, soft\nrole nbkind.review : text down 2 medium tracked, warm\nrole nbkind.design : text down 2 medium tracked, warm\nrole nbkind.fail : text down 2 medium tracked, warm\nrole nbwhen : text down 2, soft\nrole nbtitle : text medium, ink\nrole nbgist : text down, soft\nrole nbacts : between gap\nrole nbgo : text down 2 medium, night, on ink, corner gap x2, pad gap /4, pad left gap x1.5, pad right gap x1.5, away\nrole nbbtn : text down 2, ink, edge rim, corner gap x2, pad gap /4, pad left gap x1.5, pad right gap x1.5\nrole nbaway : text down 2, ink, edge rim, corner gap x2, pad gap /4, pad left gap x1.5, pad right gap x1.5, away\nrole nbinput : text down, ink, on wash, corner gap, pad gap\nrole nbrows : between gap /4\nrole nbrow : corner gap, pad gap /2, pad left gap x1.5, pad right gap\nrole nbrow.live : corner gap, pad gap /2, pad left gap x1.5, pad right gap\nrole nbrowtitle : text down, ink\nrole nbstage : text down 2, soft\nrole nbstage.live : text down 2 medium, accent\nrole nbstage.jeff : text down 2 medium, jeff\nrole nbstage.queued : text down 2, soft\nrole nbstage.working : text down 2, soft\nrole nbstage.asks : text down 2 medium, jeff\nrole nbstage.ready : text down 2, soft\nrole nbstage.landing : text down 2, soft\nrole nbnow : text down 2, accent\nrole nbnote : between gap /4, pad left gap, border left rim\nrole nbnoteby : text down 2 medium, soft\nrole nbnotetext : text down, ink\nrole nbdone : between gap, pad gap /4, pad left gap x1.5, pad right gap\nrole nbdonetitle : text down, soft\n# home-board-small, the one line: what needs Alex in amber, what waits on JEFF in lilac, the rest grey\nrole nbsmall : between gap\nrole nbsmall.need : text down medium, warm\nrole nbsmall.jeff : text down, jeff\n# the track of steps, and direction-board-focus (round 1, kept for the record)\nrole nbfocus : on raised, rail warm, corner gap x1.5, pad gap x2, pad left gap x2.5, between gap\nrole nbtitle.big : text up 2 medium, ink\nrole nbwho : text down 2, soft\nrole nbsteps : between gap /2\nrole nbstep : text down 2, faint\nrole nbstep.done : text down 2, soft\nrole nbstep.on : text down 2 medium, night, on ink, corner gap x2, pad left gap /1.5, pad right gap /1.5\nrole nbstep.jeff : text down 2 medium, night, on jeff, corner gap x2, pad left gap /1.5, pad right gap /1.5\nrole nbstep.ask : text down 2 medium, night, on jeff, corner gap x2, pad left gap /1.5, pad right gap /1.5\n# a6010 board roles: end"
read a5548
do rewrite a5548 text="# home-board: the board, one panel of the home base (a5674). The HUD sprint's lane 1, round 3 (a6010): an inbox. NEEDS\n# YOU (what waits on Alex: things to look at, designs waiting on his word, his own stuck commissions; it answers what\n# waiting-on-me did), IN MOTION, LANDED, one line per card. A line says what it is (brief= when the card has one, else\n# its title), how far along (a word at the right edge, and since when) and, on a line that needs Alex, its answer: one\n# press, never typing (Looks good, Send back, Later; Build it on a design; Try again). Colour says whose move it is\n# (LAMPLIT, lane 3): amber Alex's, lilac a resident's (what waits on JEFF folds into one line), mint an agent at work\n# this moment; the rest grey, buttons white. A press anywhere else on a line opens it in place at once (the viewer's own\n# fold): its track, who has it (names, never ids), its worker's latest word, Open in the middle, where its talk is\n# (one box for words, the middle's; agreed with lane 3 in a6049). Roles: the nb* block in home-style.\nboard : column\n  role nb\n  views : column\n    of prop:role=home-view,prop:actor=\$me as hv\n    each bands\n  lost : text \"No viewer note for you here (role=home-view, actor=you): Open has nowhere to show a card.\"\n    role hint\n    only when count(prop:role=home-view,prop:actor=\$me) = 0\nbands : column\n  role nbbands\n  let nneed = count(tag:ready-for-review,-prop:review=later) + count(prop:design=waiting,-prop:review=later) + count(prop:commission=failed,prop:asked_by=alex,-prop:review=later)\n  let nlater = count(tag:ready-for-review,prop:review=later) + count(prop:design=waiting,prop:review=later) + count(prop:commission=failed,prop:asked_by=alex,prop:review=later)\n  let nmove = count(prop:commission=asked) + count(prop:commission=working) + count(prop:commission=ready) + count(prop:commission=landing)\n  let njeff = count(prop:commission=waiting) + count(prop:commission=failed,prop:asked_by!=alex)\n  let nlanded = count(prop:commission=landed)\n  let busy = count(house doing=working)\n  need : column\n    role nbband\n    head : row\n      role nbhead\n      name : text \"NEEDS YOU\"\n        role nbname.need\n      n : text \"\$(nneed)\"\n        role nbcount.need\n        only when nneed > 0\n      gap : text \"\"\n        share 1\n      none : text \"nothing waits on you\"\n        role nbquiet\n        only when nneed = 0\n    reviews : column\n      role nbcards\n      of tag:ready-for-review,-prop:review=later as c\n      each review\n    designs : column\n      role nbcards\n      of prop:design=waiting,-prop:review=later as c\n      each design\n    failed : column\n      role nbcards\n      of prop:commission=failed,prop:asked_by=alex,-prop:review=later as c\n      each failure\n    later : column\n      role nblater\n      only when nlater > 0\n      fold \"Later · \$(nlater)\" handle nbfold\n      a : column\n        role nbcards\n        of tag:ready-for-review,prop:review=later as c\n        each review\n      b : column\n        role nbcards\n        of prop:design=waiting,prop:review=later as c\n        each design\n      f : column\n        role nbcards\n        of prop:commission=failed,prop:asked_by=alex,prop:review=later as c\n        each failure\n  move : column\n    role nbband\n    head : row\n      role nbhead\n      name : text \"IN MOTION\"\n        role nbname\n      n : text \"\$(nmove)\"\n        role nbcount\n      gap : text \"\"\n        share 1\n      live : text \"\$(busy) at work now\"\n        role nblive\n        only when busy > 0\n    landing : column\n      role nbrows\n      of prop:commission=landing as c\n      each moving\n    ready : column\n      role nbrows\n      of prop:commission=ready as c\n      each moving\n    working : column\n      role nbrows\n      of prop:commission=working as c\n      each moving\n    queued : column\n      role nbrows\n      of prop:commission=asked as c\n      each moving\n    jeff : column\n      role nbjeff\n      only when njeff > 0\n      fold \"WAITING ON JEFF · \$(njeff)\" handle nbfold.jeff\n      asking : column\n        role nbrows\n        of prop:commission=waiting as c\n        each moving\n      stuck : column\n        role nbrows\n        of prop:commission=failed,prop:asked_by!=alex as c\n        each moving\n  landed : column\n    role nbband\n    fold \"LANDED · \$(nlanded)\" handle nbfold\n    rows : column\n      role nbrows\n      of prop:commission=landed as c\n      each done\n# a thing waiting on Alex's look: a note, a demo, a report (tagged ready-for-review)\nreview : column\n  role nbneed\n  fold inline group open handle nbchev\n  line : row\n    peek\n    role nbline\n    what : text \"\$((\$c.brief or \$c.title))\"\n      role nbtitle\n      clamp 1\n      share 1\n    ok : text \"Looks good\"\n      role nbgo\n      on click do tag \$c remove=ready-for-review; do comment \$c line=\"@jeff: looks good (from the board)\"\n    no : text \"Send back\"\n      role nbaway\n      on click do tag \$c remove=ready-for-review; do comment \$c line=\"@jeff: not yet: send this back (from the board)\"\n    later : text \"Later\"\n      role nbaway\n      only when (\$c.review or \"\") != \"later\"\n      on click do prop \$c review=later\n    back : text \"Now\"\n      role nbaway\n      only when \$c.review = \"later\"\n      on click do prop \$c remove=review\n  body : column\n    role nbbody\n    facts : row\n      role nbtop\n      kind : text \"to look at\"\n        role nbwhen\n      demo : text \"· a demo inside\"\n        role nbwhen\n        only when (\$c.demo or \"\") != \"\"\n      when : text \"· waiting since \$(day-or-time(\$changed.tags, \$today))\"\n        role nbwhen\n        only when (\$changed.tags or \"\") != \"\"\n    gist : text \"\$c.text\"\n      role nbgist\n      clamp 4\n      only when (\$c.text or \"\") != \"\"\n    acts : row\n      role nbacts\n      open : text \"Open in the middle\"\n        role nbbtn\n        on click do read \$hv; do prop \$hv viewing=\$c back=\"\$hv.viewing\" find=\"\"\n# a design waiting on Alex's word: Build it is his word in one press (design=answered verdict=build, and a line in its\n# own talk, which reaches its author); Later puts it off; Read it opens it in the middle\ndesign : column\n  role nbneed\n  fold inline group open handle nbchev\n  line : row\n    peek\n    role nbline\n    what : text \"\$((\$c.brief or \$c.title))\"\n      role nbtitle\n      clamp 1\n      share 1\n    build : text \"Build it\"\n      role nbgo\n      on click when \$c.design = \"waiting\" and (\$c.talk or \"\") != \"\" do prop \$c design=answered verdict=build; do append \$c.talk line=\"Build it. (from the board)\"\n      on click when \$c.design = \"waiting\" and (\$c.talk or \"\") = \"\" do prop \$c design=answered verdict=build; do comment \$c line=\"@jeff: build it (from the board)\"\n    later : text \"Later\"\n      role nbaway\n      only when (\$c.review or \"\") != \"later\"\n      on click do prop \$c review=later\n    back : text \"Now\"\n      role nbaway\n      only when \$c.review = \"later\"\n      on click do prop \$c remove=review\n  body : column\n    role nbbody\n    by : text \"a design by \$((\$c.by or \"someone\")), waiting on your word\"\n      role nbwhen\n    acts : row\n      role nbacts\n      read : text \"Read it in the middle\"\n        role nbbtn\n        on click do read \$hv; do prop \$hv viewing=\$c back=\"\$hv.viewing\" find=\"\"\n# a commission Alex asked for that did not land and its worker could not mend: Try again starts its worker once more\nfailure : column\n  role nbneed\n  fold inline group open handle nbchev\n  line : row\n    peek\n    role nbline\n    what : text \"\$((\$c.brief or \$c.title))\"\n      role nbtitle\n      clamp 1\n      share 1\n    again : text \"Try again\"\n      role nbgo\n      on click when \$c.commission = \"failed\" do prop \$c commission=asked\n    later : text \"Later\"\n      role nbaway\n      only when (\$c.review or \"\") != \"later\"\n      on click do prop \$c review=later\n  body : column\n    role nbbody\n    who : text \"did not land; its worker could not mend it\"\n      role nbwhen\n    last : column\n      of comments:\$c.item as m\n      each note\n    acts : row\n      role nbacts\n      open : text \"Open in the middle\"\n        role nbbtn\n        on click do read \$hv; do prop \$hv viewing=\$c back=\"\$hv.viewing\" find=\"\"\n# one commission on its way: what, then at the right edge how far and since when; pressed, who has it and their word\nmoving : column\n  role nbrow\n  fold inline group open handle nbchev\n  line : row\n    peek\n    role nbline\n    what : text \"\$((\$c.brief or \$c.title))\"\n      role nbrowtitle\n      clamp 1\n      share 1\n    queued : text \"queued\"\n      role nbstage\n      only when \$c.commission = \"asked\"\n    live : text \"working\"\n      role nbstage.live\n      only when \$c.commission = \"working\" and count(house doing=working resident=\$c.worker) > 0\n    idle : text \"working\"\n      role nbstage\n      only when \$c.commission = \"working\" and count(house doing=working resident=\$c.worker) = 0\n    asks : text \"asks JEFF\"\n      role nbstage.jeff\n      only when \$c.commission = \"waiting\"\n    stuck : text \"stuck\"\n      role nbstage.jeff\n      only when \$c.commission = \"failed\"\n    ready : text \"ready to land\"\n      role nbstage\n      only when \$c.commission = \"ready\"\n    landing : text \"landing\"\n      role nbstage\n      only when \$c.commission = \"landing\"\n    since : text \"\$(day-or-time(\$changed.commission, \$today))\"\n      role nbwhen\n      only when (\$changed.commission or \"\") != \"\"\n  body : column\n    role nbbody\n    steps : row\n      role nbsteps\n      q : text \"queued\"\n        role nbstep\n        role nbstep.done when \$c.commission != \"asked\"\n        role nbstep.on when \$c.commission = \"asked\"\n      w : text \"working\"\n        role nbstep\n        role nbstep.done when \$c.commission = \"ready\" or \$c.commission = \"landing\"\n        role nbstep.on when \$c.commission = \"working\"\n        role nbstep.jeff when \$c.commission = \"waiting\" or \$c.commission = \"failed\"\n      r : text \"ready\"\n        role nbstep\n        role nbstep.done when \$c.commission = \"landing\"\n        role nbstep.on when \$c.commission = \"ready\"\n      l : text \"landing\"\n        role nbstep\n        role nbstep.on when \$c.commission = \"landing\"\n      d : text \"landed\"\n        role nbstep\n    who : row\n      role nbtop\n      codex : text \"a Codex builder\"\n        role nbname.link\n        only when \$c.worker_provider = \"codex\"\n        on click do read \$hv; do prop \$hv viewing=\$c back=\"\$hv.viewing\" find=\"\"\n      claude : text \"a Claude builder\"\n        role nbname.link\n        only when (\$c.worker_provider or \"\") != \"codex\" and (\$c.worker or \"\") != \"\"\n        on click do read \$hv; do prop \$hv viewing=\$c back=\"\$hv.viewing\" find=\"\"\n      owner : text \"\$c.owner\"\n        role nbname.link\n        only when (\$c.worker or \"\") = \"\" and (\$c.owner or \"\") != \"\"\n        on click do read \$hv; do prop \$hv viewing=\$c back=\"\$hv.viewing\" find=\"\"\n      now : text \"at work this moment\"\n        role nbnow\n        only when count(house doing=working resident=\$c.worker) > 0\n      jeff : text \"· asked by JEFF\"\n        role nbwhen\n        only when \$c.asked_by = \"jeff\"\n      for : text \"· asked by \$((\$c.asked_by or \"nobody\"))\"\n        role nbwhen\n        only when \$c.asked_by != \"jeff\"\n    # now= on a worker's own card: what it is doing this minute, in its own words (lane 3's proposal, a6049 c6262)\n    now : text \"\$c.now\"\n      role nbnotetext\n      clamp 2\n      only when (\$c.now or \"\") != \"\"\n    last : column\n      of comments:\$c.item as m\n      each note\n    acts : row\n      role nbacts\n      open : text \"Open in the middle\"\n        role nbbtn\n        on click do read \$hv; do prop \$hv viewing=\$c back=\"\$hv.viewing\" find=\"\"\n# the latest comment only (a clamp would print how many it cut, in the card)\nnote : column\n  role nbnote\n  only when \$index = \$count\n  by : text \"latest, from \$m.by\"\n    role nbnoteby\n  said : text \"\$m.text\"\n    role nbnotetext\n    clamp 3\n# the last five landed (by \$index, not a clamp, which would print what it cut)\ndone : row\n  role nbdone\n  only when \$index > \$count - 5\n  on click do read \$hv; do prop \$hv viewing=\$c back=\"\$hv.viewing\" find=\"\"\n  what : text \"\$((\$c.brief or \$c.title))\"\n    role nbdonetitle\n    clamp 1\n    share 1\n  when : text \"\$(day-or-time(\$changed.commission, \$today))\"\n    role nbwhen\n    only when (\$changed.commission or \"\") != \"\""
read a5682
do rewrite a5682 text="# home-board-small: the board in one line (a5496), for its panel title, the shelf and a narrow room (a6010, round 3):\n# what needs Alex first, then what is moving; a count of nothing is left out, so a quiet day reads short.\nline : row\n  role nbsmall\n  let need = count(tag:ready-for-review,-prop:review=later) + count(prop:design=waiting,-prop:review=later) + count(prop:commission=failed,prop:asked_by=alex,-prop:review=later)\n  let move = count(prop:commission=asked) + count(prop:commission=working) + count(prop:commission=ready) + count(prop:commission=landing)\n  let jeff = count(prop:commission=waiting) + count(prop:commission=failed,prop:asked_by!=alex)\n  you : text \"\$(need) need you\"\n    role nbsmall.need\n    only when need > 0\n  moving : text \"\$(move) moving\"\n    role summary\n    only when move > 0\n  waits : text \"\$(jeff) wait on JEFF\"\n    role nbsmall.jeff\n    only when jeff > 0\n  quiet : text \"all quiet\"\n    role summary\n    only when need + move + jeff = 0"
read a5674
do tag a5674 add=glance-you,glance-board
