# dock-open <pin> <current layout> <current home-view>.
# Current columns and the staged partition layout are both supported.
table in:$2,prop:role=home-panel cols=lens,shows,shelf
do create $2 kind=surface title=column layout=column when ($1.lens or "") != "" and ($2.tree or "") = "" and count(kind:surface,in:$2) = 0
do prop in:$2,prop:role=home-panel,prop:lens=$(($1.lens or 0)),-prop:shows,prop:shelf=yes shelf=no when ($1.lens or "") != "" and ($1.shows or "") = "" and (($2.tree or "") = "" or tree-activate($2.tree, 0) != "") and count(in:$2,prop:role=home-panel,prop:lens=$(($1.lens or 0)),-prop:shows,prop:shelf=yes) > 0
do create $2 kind=note title="$1.title" role=home-panel actor=$me lens=$1.lens shows="$(($1.shows or \"\"))" shelf=no glyph="$(($1.glyph or \"◆\"))" icon="$(($1.icon or \"\"))" tint="$(($1.tint or \"blue\"))" about="$(($1.about or \"\"))" filled="$(($1.filled or \"\"))" chrome="$(($1.chrome or \"\"))" sizing="$(($1.sizing or \"\"))" pin="$(($1.pin or \"\"))" when ($1.lens or "") != "" and ($1.shows or "") = "" and (($2.tree or "") = "" or tree-activate($2.tree, 0) != "") and ($2.tree or "") != "" and count(in:$2,prop:role=home-panel,prop:lens=$(($1.lens or 0)),-prop:shows) = 0
do create $(max($item of kind:surface,in:$2)) kind=note title="$1.title" role=home-panel actor=$me lens=$1.lens shows="$(($1.shows or \"\"))" shelf=no glyph="$(($1.glyph or \"◆\"))" icon="$(($1.icon or \"\"))" tint="$(($1.tint or \"blue\"))" about="$(($1.about or \"\"))" filled="$(($1.filled or \"\"))" chrome="$(($1.chrome or \"\"))" sizing="$(($1.sizing or \"\"))" pin="$(($1.pin or \"\"))" when ($1.lens or "") != "" and ($1.shows or "") = "" and (($2.tree or "") = "" or tree-activate($2.tree, 0) != "") and ($2.tree or "") = "" and count(in:$2,prop:role=home-panel,prop:lens=$(($1.lens or 0)),-prop:shows) = 0
do prop $2 tree="$(tree-activate($2.tree, (max($item of in:$2,prop:role=home-panel,prop:lens=$(($1.lens or 0)),-prop:shows) or 0)))" when ($1.lens or "") != "" and ($1.shows or "") = "" and (($2.tree or "") = "" or tree-activate($2.tree, 0) != "") and ($2.tree or "") != "" and tree-activate($2.tree, (max($item of in:$2,prop:role=home-panel,prop:lens=$(($1.lens or 0)),-prop:shows) or 0)) != $2.tree
do prop in:$2,prop:role=home-panel,prop:lens=$(($1.lens or 0)),prop:shows=$(($1.shows or 0)),prop:shelf=yes shelf=no when ($1.lens or "") != "" and ($1.shows or "") != "" and (($2.tree or "") = "" or tree-activate($2.tree, 0) != "") and count(in:$2,prop:role=home-panel,prop:lens=$(($1.lens or 0)),prop:shows=$(($1.shows or 0)),prop:shelf=yes) > 0
do create $2 kind=note title="$1.title" role=home-panel actor=$me lens=$1.lens shows="$(($1.shows or \"\"))" shelf=no glyph="$(($1.glyph or \"◆\"))" icon="$(($1.icon or \"\"))" tint="$(($1.tint or \"blue\"))" about="$(($1.about or \"\"))" filled="$(($1.filled or \"\"))" chrome="$(($1.chrome or \"\"))" sizing="$(($1.sizing or \"\"))" pin="$(($1.pin or \"\"))" when ($1.lens or "") != "" and ($1.shows or "") != "" and (($2.tree or "") = "" or tree-activate($2.tree, 0) != "") and ($2.tree or "") != "" and count(in:$2,prop:role=home-panel,prop:lens=$(($1.lens or 0)),prop:shows=$(($1.shows or 0))) = 0
do create $(max($item of kind:surface,in:$2)) kind=note title="$1.title" role=home-panel actor=$me lens=$1.lens shows="$(($1.shows or \"\"))" shelf=no glyph="$(($1.glyph or \"◆\"))" icon="$(($1.icon or \"\"))" tint="$(($1.tint or \"blue\"))" about="$(($1.about or \"\"))" filled="$(($1.filled or \"\"))" chrome="$(($1.chrome or \"\"))" sizing="$(($1.sizing or \"\"))" pin="$(($1.pin or \"\"))" when ($1.lens or "") != "" and ($1.shows or "") != "" and (($2.tree or "") = "" or tree-activate($2.tree, 0) != "") and ($2.tree or "") = "" and count(in:$2,prop:role=home-panel,prop:lens=$(($1.lens or 0)),prop:shows=$(($1.shows or 0))) = 0
do prop $2 tree="$(tree-activate($2.tree, (max($item of in:$2,prop:role=home-panel,prop:lens=$(($1.lens or 0)),prop:shows=$(($1.shows or 0))) or 0)))" when ($1.lens or "") != "" and ($1.shows or "") != "" and (($2.tree or "") = "" or tree-activate($2.tree, 0) != "") and ($2.tree or "") != "" and tree-activate($2.tree, (max($item of in:$2,prop:role=home-panel,prop:lens=$(($1.lens or 0)),prop:shows=$(($1.shows or 0))) or 0)) != $2.tree
do prop $2 full="" when ($1.lens or "") != "" and ($2.full or "") != "" and (($2.tree or "") = "" or tree-activate($2.tree, 0) != "")
do view $1.opens when ($1.opens or "") != "" and $1.opens != "chat"
do unview $3 when ($1.opens or "") = "chat"
