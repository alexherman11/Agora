# home-notices: the notification bar (a5530): what the world wants Alex to see now, newest first, calm. Two kinds.
# Notices: notes with role=notice to=$me, which world rules in the Home base room make (something landed, a worker
# asks, something is ready for his review, a design waits on his word); about= names the thing, came= when; a × takes
# one away. Calls: sayings for him not yet answered, newer than his notices surface's cleared= (a call's × is 'seen up
# to here'), leaving out the chat the home base already shows (skip= on that surface). While his focus timer runs they
# are held: the bar only counts them. A press on one opens its thing in the middle and takes the notice away.
# A widget: tag widget, slot=bar, order=4.
bar : row
  role nbar
  of kind:surface,prop:role=notices,prop:actor=$me as nb
  each bell
  none : text "no notices surface (role=notices actor=you) in the Home base room"
    role hint
    only when count(kind:surface,prop:role=notices,prop:actor=$me) = 0
bell : row
  role nbell
  let notes = count(prop:role=notice,prop:to=$me)
  let calls = count(sayings for:$me answered=no item!=$nb.skip eid>$nb.cleared)
  let total = notes + calls
  let focusing = count(prop:role=pomodoro,prop:actor=$me,prop:state=running,prop:mode=focus)
  quiet : text "all quiet"
    role nquiet
    only when total = 0
  held : text "$(total) held until your break"
    role nheld
    only when total > 0 and focusing > 0
  first : row
    role nfirst
    share 1
    only when total > 0 and focusing = 0
    note : row
      share 1
      of prop:role=notice,prop:to=$me as nt
      by -came
      clamp 1
      each noticeline
    call : row
      share 1
      only when notes = 0
      of sayings for:$me answered=no item!=$nb.skip eid>$nb.cleared as s
      by -eid
      clamp 1
      each callline
  open : column
    role nopen
    only when total > 0 and focusing = 0
    fold "$(total)" float handle ncount
    list : column
      role nlist
      of prop:role=home-view,prop:actor=$me as hv
      each feed
feed : column
  role nfeed
  notes : column
    role nitems
    of prop:role=notice,prop:to=$me as nt
    by -came
    clamp 12
    each notice
  callshead : text "FOR YOU"
    role nhead
    only when calls > 0
  calls : column
    role nitems
    of sayings for:$me answered=no item!=$nb.skip eid>$nb.cleared as s
    by -eid
    clamp 8
    each call
# one line in the bar: the newest notice or call
noticeline : row
  role nline
  let label = "Landed" when $nt.topic = "landed"
  let label = "Asks" when $nt.topic = "asking"
  let label = "For your review" when $nt.topic = "review"
  let label = "Waits on your word" when $nt.topic = "design"
  let label = $nt.topic otherwise
  dot : text "●"
    role ndot
    role ndot.landed when $nt.topic = "landed"
    role ndot.asking when $nt.topic = "asking"
  what : text "$(label)"
    role nlabel
  about : row
    share 1
    the $nt.about as a
    title : text "$a.title"
      role ntitle
      clamp 1
callline : row
  role nline
  dot : text "●"
    role ndot.call
  what : text "$s.name"
    role nlabel
  said : text "$s.said"
    role ntitle
    share 1
    clamp 1
# in the list: one notice, with its time, what it is about, and its ×
notice : row
  role nitem
  let label = "Landed" when $nt.topic = "landed"
  let label = "Asks" when $nt.topic = "asking"
  let label = "For your review" when $nt.topic = "review"
  let label = "Waits on your word" when $nt.topic = "design"
  let label = $nt.topic otherwise
  main : column
    role nmain
    share 1
    on click do prop $hv viewing=$nt.about back="$hv.viewing" find=""; do remove $nt
    top : row
      role ntop
      dot : text "●"
        role ndot
        role ndot.landed when $nt.topic = "landed"
        role ndot.asking when $nt.topic = "asking"
      what : text "$(label)"
        role nlabel
      at : text "$(time($nt.came))"
        role meta
    about : column
      the $nt.about as a
      title : text "$a.title"
        role ntitle
        clamp 2
  x : text "×"
    role nx
    on click do remove $nt
# one call: who, where, a line of what they said; × is 'seen up to here'
call : row
  role nitem
  main : column
    role nmain
    share 1
    let was = $hv.back
    on click do prop $hv viewing=$s.item back="$hv.viewing" find=""
    top : row
      role ntop
      dot : text "●"
        role ndot.call
      who : text "$s.name"
        role nlabel
      where : text "in $s.in · $s.at"
        role meta
        clamp 1
    said : text "$s.said"
      role ntitle
      clamp 2
  x : text "×"
    role nx
    let was = $nb.cleared
    on click do prop $nb cleared=$s.eid
