# reader: one thing waiting on Alex, set for reading (a6460; Alex, 17 Oct: 'I need some better way to read these
# need-you proposals. They are ugly af right now.'). Stood on the thing: anything tagged ready-for-review, or a design
# (design=waiting). On top, what it is in one plain sentence (its brief=, else its For Alex block's What line, else its
# first sentence of prose), who wrote it and when, how long it takes to read, what it recommends and what it asks of
# Alex; then the words set as an article in a column about 70 characters wide, or with Skim only each heading and its
# first sentence; at the foot a bar that stays in view: the answers that fit the thing, one press each, acting on the
# thing itself (Looks good, Later, Send back with a note; Build it, Not now on a design), and Previous / Next
# through everything waiting. The For Alex block is the Handbook's rule for anything tagged for Alex.
# What the reader keeps for its person is their reader note (role=reader, actor=$me): skim=yes, box= the answer being
# written (send) and for= the thing it is about. Questions and selection comments use the shared Conversation.
# Previous and Next are names (an id in the words, drawn as its name), so a press goes to the nearest `on link` above:
# the home base's viewer opens it in the middle, the Writing app in its page. Names in the words are drawn quiet by the
# painter (a6460: four words, the rest on hover, an arrow for a comment or an event, a number when named again).
reader : column
  share 1
  role rdpage
  let doc = $item
  stood : column
    share 1
    only when ($item or "") != ""
    of $doc as d
    each thing
  nothing : text "The reader stands on one thing: place it under a part that stands on one, or: scene reader on <id>"
    role meta
    only when ($item or "") = ""
thing : column
  share 1
  let isdesign = "yes" when ($d.design or "") != ""
  let isdesign = "no" otherwise
  let waiting = "yes" when ($d.tags or "") has "ready-for-review" or ($d.design or "") = "waiting"
  let waiting = "no" otherwise
  let isnote = "no" when $d.kind = "surface"
  let isnote = "yes" otherwise
  let words = (join($text of in:$d.item) or "") when isnote = "no"
  let words = ($d.text or "") otherwise
  let rest = (for-alex(words, "rest") or "")
  let what = ($d.brief or for-alex(words, "what") or lead(words) or "")
  let rec = (for-alex(words, "recommend") or "")
  let need = (for-alex(words, "need") or $d.question or "")
  let mins = read-minutes(words)
  let who = ($d.by or $d.author or "")
  let sender = ($d.sent_by or "")
  let since = day-or-time($changed.tags, $today) when isdesign = "no" and ($changed.tags or "") != ""
  let since = day-or-time($changed.design, $today) when isdesign = "yes" and ($changed.design or "") != ""
  let since = "" otherwise
  let na = count(tag:ready-for-review,-prop:design=waiting)
  let nb = count(prop:design=waiting)
  mine : column
    share 1
    of prop:role=reader,prop:actor=$me as r
    each page
  none : column
    role rdcol
    measure 72ch
    only when count(prop:role=reader,prop:actor=$me) = 0
    say : text "The reader keeps what you choose here (Skim, a note being written) on a note of yours: role=reader actor=you."
      role meta
    make : text "Make my reader note"
      role rdbtn
      on click do look f5204; do create f5204 kind=note title="Reader ($me)" role=reader actor=$me
page : column
  share 1
  role rdpage
  let skim = "yes" when ($r.skim or "") = "yes"
  let skim = "no" otherwise
  let boxed = ($r.box or "") when ($r.for or "") = $d.item
  let boxed = "" otherwise
  top : column
    role rdcol
    measure 72ch
    head : column
      role rdhead
      kicker : row
        role rdkicker
        look : text "TO LOOK AT"
          role rdkind
          only when isdesign = "no" and waiting = "yes"
        design : text "A DESIGN, WAITING ON YOUR WORD"
          role rdkind
          only when isdesign = "yes" and waiting = "yes"
        done : text "NOT WAITING ON YOU NOW"
          role rdfacts
          only when waiting = "no"
        mins : text "$(mins) min read"
          role rdfacts
        by : text "by $(who)"
          role rdfacts
          only when who != ""
        sender : text "Sent by $(sender)"
          role rdfacts
          only when who = "" and sender != ""
        unknown : text "Author not recorded"
          role rdfacts
          only when who = "" and sender = ""
        since : text "Sent $(since)"
          role rdfacts
          only when since != ""
      title : text "$d.title"
        role rdtitle
      what : text "$(what)"
        role rdwhat
        only when what != "" and what != $d.title
      rec : row
        role rdline
        only when rec != ""
        k : text "Recommends"
          role rdlabel
        v : text "$(rec)"
          role rdrec
          share 1
      ask : row
        role rdask
        only when need != ""
        k : text "Asks you"
          role rdlabel.ask
        v : text "$(need)"
          role rdasktext
          share 1
      word : row
        role rdask
        only when need = "" and isdesign = "yes" and waiting = "yes"
        k : text "Asks you"
          role rdlabel.ask
        v : text "Build it, or not now?"
          role rdasktext
          share 1
      modes : row
        role rdmodes
        read : text "Read"
          role rdtab
          role rdtab.on when skim = "no"
          on click when ($r.skim or "") = "yes" do read $r; do prop $r remove=skim
        skimit : text "Skim"
          role rdtab
          role rdtab.on when skim = "yes"
          on click when ($r.skim or "") != "yes" do read $r; do prop $r skim=yes
  body : column
    share 1
    scroll scroll
    role rdscroll
    col : column
      role rdcol
      measure 72ch
      note : column
        only when isnote = "yes" and skim = "no" and rest != ""
        writer : column
          of prop:role=writer,prop:actor=$me as w
          each article
        plain : text "$(rest)"
          role rdbody
          markdown
          only when count(prop:role=writer,prop:actor=$me) = 0
      skimming : column
        only when isnote = "yes" and skim = "yes"
        noteskim : column
          role rdskimlist
          of sections:$d.item as s
          each skimsec
      # `of in:` only under a guard on the part above it: a bind runs before its own part's guard, and in: on a note
      # or a task is refused, which stops the whole lens (and the viewer around it) compiling
      surface : column
        only when isnote = "no"
        paras : column
          role rdparas
          only when skim = "no"
          of in:$d.item as p
          run block
          each para
        parskim : column
          role rdskimlist
          only when skim = "yes"
          of in:$d.item as p
          each skimpara
      empty : text "There are no words in it to read."
        role meta
        only when words = ""
  foot : column
    role rdfoot
    box : column
      role rdcol
      measure 72ch
      only when boxed = "send"
      sendsay : text "Send it back to JEFF with a note: what should change?"
        role rdlabel
        only when boxed = "send"
      say : text ""
        role rdbox
        lines 2..6
        commit enter only
        hint "Enter sends, Shift+Enter for a new line"
        on edit when boxed = "send" and isdesign = "no" do look $d; do tag $d remove=ready-for-review; do comment $d line="@jeff: sent back from the reader: $value"; read $r; do prop $r box="" for="" last=$d.item answered=$now
        on edit when boxed = "send" and isdesign = "yes" and ($d.talk or "") != "" and ($d.tags or "") !has "ready-for-review" do look $d; do prop $d design=answered verdict=questions; do append $d.talk line="$value"; read $r; do prop $r box="" for="" last=$d.item answered=$now
        on edit when boxed = "send" and isdesign = "yes" and ($d.talk or "") != "" and ($d.tags or "") has "ready-for-review" do look $d; do tag $d remove=ready-for-review; do prop $d design=answered verdict=questions; do append $d.talk line="$value"; read $r; do prop $r box="" for="" last=$d.item answered=$now
        on edit when boxed = "send" and isdesign = "yes" and ($d.talk or "") = "" and ($d.tags or "") !has "ready-for-review" do look $d; do prop $d design=answered verdict=questions; do comment $d line="@jeff: sent back from the reader: $value"; read $r; do prop $r box="" for="" last=$d.item answered=$now
        on edit when boxed = "send" and isdesign = "yes" and ($d.talk or "") = "" and ($d.tags or "") has "ready-for-review" do look $d; do tag $d remove=ready-for-review; do prop $d design=answered verdict=questions; do comment $d line="@jeff: sent back from the reader: $value"; read $r; do prop $r box="" for="" last=$d.item answered=$now
      cancel : text "Cancel"
        role rdquiet
        on click when boxed != "" do read $r; do prop $r box="" for=""
    bar : row
      role rdbar
      good : text "Looks good"
        role rdgo
        only when isdesign = "no" and waiting = "yes"
        on click do look $d; do tag $d remove=ready-for-review; do comment $d line="@jeff: looks good (from the reader)"; read $r; do prop $r last=$d.item answered=$now
      build : text "Build it"
        role rdgo
        only when isdesign = "yes" and waiting = "yes"
        on click when ($d.talk or "") != "" and ($d.tags or "") !has "ready-for-review" do look $d; do prop $d design=answered verdict=build; do append $d.talk line="Build it. (from the reader)"; read $r; do prop $r last=$d.item answered=$now
        on click when ($d.talk or "") != "" and ($d.tags or "") has "ready-for-review" do look $d; do tag $d remove=ready-for-review; do prop $d design=answered verdict=build; do append $d.talk line="Build it. (from the reader)"; read $r; do prop $r last=$d.item answered=$now
        on click when ($d.talk or "") = "" and ($d.tags or "") !has "ready-for-review" do look $d; do prop $d design=answered verdict=build; do comment $d line="@jeff: build it (from the reader)"; read $r; do prop $r last=$d.item answered=$now
        on click when ($d.talk or "") = "" and ($d.tags or "") has "ready-for-review" do look $d; do tag $d remove=ready-for-review; do prop $d design=answered verdict=build; do comment $d line="@jeff: build it (from the reader)"; read $r; do prop $r last=$d.item answered=$now
      notnow : text "Not now"
        role rdbtn
        only when isdesign = "yes" and waiting = "yes"
        on click when ($d.talk or "") != "" and ($d.tags or "") !has "ready-for-review" do look $d; do prop $d design=answered verdict=not-now; do append $d.talk line="Not now. (from the reader)"; read $r; do prop $r last=$d.item answered=$now
        on click when ($d.talk or "") != "" and ($d.tags or "") has "ready-for-review" do look $d; do tag $d remove=ready-for-review; do prop $d design=answered verdict=not-now; do append $d.talk line="Not now. (from the reader)"; read $r; do prop $r last=$d.item answered=$now
        on click when ($d.talk or "") = "" and ($d.tags or "") !has "ready-for-review" do look $d; do prop $d design=answered verdict=not-now; do comment $d line="@jeff: not now (from the reader)"; read $r; do prop $r last=$d.item answered=$now
        on click when ($d.talk or "") = "" and ($d.tags or "") has "ready-for-review" do look $d; do tag $d remove=ready-for-review; do prop $d design=answered verdict=not-now; do comment $d line="@jeff: not now (from the reader)"; read $r; do prop $r last=$d.item answered=$now
      later : text "Later"
        role rdbtn
        only when waiting = "yes" and ($d.review or "") != "later"
        on click do look $d; do prop $d review=later
      unlater : text "Not later"
        role rdbtn
        only when waiting = "yes" and $d.review = "later"
        on click do look $d; do prop $d remove=review
      send : text "Send back…"
        role rdbtn
        role rdbtn.on when boxed = "send"
        only when waiting = "yes"
        on click when boxed != "send" do read $r; do prop $r box=send for=$d.item
      said : text "You said: $d.verdict"
        role rdfacts
        only when waiting = "no" and ($d.verdict or "") != ""
      gap : text ""
        share 1
      nava : row
        role rdnav
        only when waiting = "yes" and isdesign = "no"
        of tag:ready-for-review,-prop:design=waiting as tg
        each fromtagged
      navb : row
        role rdnav
        only when waiting = "yes" and isdesign = "yes"
        of prop:design=waiting as tg
        each fromdesign
      onward : row
        role rdnav
        only when waiting = "no" and na + nb > 0
        first : row
          only when na > 0
          one : row
            of tag:ready-for-review,-prop:design=waiting as nx
            each firstone
        firstd : row
          only when na = 0
          one : row
            of prop:design=waiting as nx
            each firstone
# Previous and Next from a tagged thing: only the instance that is the open thing draws; inside it, its neighbours
fromtagged : row
  role rdnav
  only when $item = $d.item
  let at = $index
  prev : row
    of tag:ready-for-review,-prop:design=waiting as nx
    each prevone
  pos : text "$(at) of $(na + nb)"
    role rdpos
  next : row
    of tag:ready-for-review,-prop:design=waiting as nx
    each nextone
  intodesigns : row
    only when at = na and nb > 0
    one : row
      of prop:design=waiting as nx
      each firstone
fromdesign : row
  role rdnav
  only when $item = $d.item
  let at = $index
  fromtags : row
    only when at = 1 and na > 0
    one : row
      of tag:ready-for-review,-prop:design=waiting as nx
      each lastone
  prev : row
    of prop:design=waiting as nx
    each prevone
  pos : text "$(na + at) of $(na + nb)"
    role rdpos
  next : row
    of prop:design=waiting as nx
    each nextone
prevone : text "Previous: $item"
  role rdnavlink
  only when $index = at - 1
nextone : text "Next: $item"
  role rdnavlink
  only when $index = at + 1
firstone : text "Next: $item"
  role rdnavlink
  only when $index = 1
lastone : text "Previous: $item"
  role rdnavlink
  only when $index = $count
# Skim: each heading and the first sentence under it (a section that is only a list gives its first item)
article : text "$(rest)"
  role rdbody
  markdown
  let held = $w.quote when ($w.quote_in or "") = $d.item and ($w.quote or "") != ""
  let held = "" otherwise
  light "" "$(held)"
  on select do read $w; do prop $w quoting=$d.item quote_in=$d.item quote="$value"
skimsec : column
  role rdskimsec
  only when $heading !has "For Alex"
  h : text "$heading"
    role rdskimh
    only when $heading != "(before the first heading)"
  g : text "$(gist($text) or "")"
    role rdskim
    marks
    only when (gist($text) or "") != ""
# a paragraph document (a surface of paragraphs, a design): each paragraph by its block, as an article
para : row
  role rdpara
  role rdpara.li when $block = "bullet" or $block = "number" or $block = "check"
  dot : text "•"
    role rdmark
    only when $block = "bullet"
  num : text "$run."
    role rdmark
    only when $block = "number"
  pic : text "$text"
    role rdfigure
    picture
    share 1
    only when $block = "figure"
  words : column
    share 1
    only when $block != "figure"
    writer : column
      of prop:role=writer,prop:actor=$me as w
      each paragraphtext
    plain : text "$text"
      role rdbody
      role rdh1 when $block = "h1"
      role rdh2 when $block = "h2"
      role rdh3 when $block = "h3"
      role rdquote when $block = "quote"
      marks
      only when count(prop:role=writer,prop:actor=$me) = 0
paragraphtext : text "$p.text"
  role rdbody
  role rdh1 when $p.block = "h1"
  role rdh2 when $p.block = "h2"
  role rdh3 when $p.block = "h3"
  role rdquote when $p.block = "quote"
  marks
  let held = $w.quote when ($w.quote_in or "") = $d.item and ($w.quoting or "") = $p.item
  let held = "" otherwise
  light "" "$(held)"
  on select do read $w; do prop $w quoting=$p.item quote_in=$d.item quote="$value"
skimpara : column
  role rdskimsec
  let beforeblock = (max($block of $before) or "")
  h : text "$text"
    role rdskimh
    marks
    only when $block = "h1" or $block = "h2" or $block = "h3"
  g : text "$(gist($text) or "")"
    role rdskim
    marks
    only when ($index = 1 or beforeblock = "h1" or beforeblock = "h2" or beforeblock = "h3") and ($block or "") != "h1" and ($block or "") != "h2" and ($block or "") != "h3" and ($block or "") != "figure" and (gist($text) or "") != ""
