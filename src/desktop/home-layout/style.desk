# the looks the layout wears, appended to home-style (a5206); `glide` (a5504's look) makes a panel travel to its new place
read a5206
do append a5206 line="# a5496: the home base's layout (home-tiling, home-panels, the *-small one-line views)"
do append a5206 line="role stage : between gap x2"
do append a5206 line="role top : between gap x2"
do append a5206 line="role clock : between gap"
do append a5206 line="role clocktime : text up 3 strong, ink"
do append a5206 line="role clockday : text down, soft"
do append a5206 line="role tiling : between gap x2"
do append a5206 line="role pinned : between gap"
do append a5206 line="role tilecol : between gap x2"
do append a5206 line="role tilefoot : height gap x6"
do append a5206 line="role pane : on glass, edge rim, corner gap x2, pad gap x2, between gap, glide"
do append a5206 line="role pane.big : on glassdeep, edge accent, corner gap x2, pad gap x2, between gap, glide"
do append a5206 line="role panehead : between gap"
do append a5206 line="role panetitle : text up medium, ink"
do append a5206 line="role panesum : text down, soft"
do append a5206 line="role panebody : between gap"
do append a5206 line="role summary : text down, soft"
do append a5206 line="role shelf : between gap /2"
do append a5206 line="role dockchip : soft, edge rim, corner gap, pad gap /2, pad left gap, pad right gap, glide"
do append a5206 line="role dockchip.on : ink, on wash, edge accent, corner gap, pad gap /2, pad left gap, pad right gap, glide"
do append a5206 line="role chipname : text down medium"
do append a5206 line="role chipsum : text down 2, soft"
