# Copy to .env (gitignored). The shell loads it at start; nothing else reads it.
# Astra through your OpenAI account (Codex-managed ChatGPT OAuth).
AGORA_JEFF_PROVIDER=openai-account
AGORA_JEFF_MODEL=gpt-6-astra
AGORA_JEFF_REASONING=medium
# Absolute path to a current Codex executable. Astra was verified with 0.153.4.
# The Python SDK's bundled 0.147.0 is too old for Astra.
AGORA_CODEX_BIN=

# Alternative: direct API billing through the OpenAI Agents SDK.
# AGORA_JEFF_PROVIDER=openai-agents
# OPENAI_API_KEY=

# Alternative: change PROVIDER to anthropic and MODEL to the provider's model ID.
# Existing configurations without PROVIDER retain the Anthropic backend.
# AGORA_JEFF_PROVIDER=anthropic
# AGORA_JEFF_MODEL=anthropic/claude-sonnet-4.5
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_API_KEY=

# Optional imports beyond the world's imports/ directory. Use ; on Windows, : on Linux.
# Each configured directory or exact file is an explicit local import authorization.
# AGORA_IMPORT_ROOTS=C:\Projects\Agora\sample-notes
