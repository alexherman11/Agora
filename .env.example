# Copy to .env (gitignored). The shell loads it at start; nothing else reads it.
# JEFF speaks the Anthropic Messages API. To route through OpenRouter, point the SDK there:
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_API_KEY=sk-or-v1-...your OpenRouter key...
# Model id in the provider's naming. A cheap, capable default for M1:
AGORA_JEFF_MODEL=anthropic/claude-haiku-4.5
