# Optional: select a tested native Codex executable when PATH has an older wrapper.
# The application reads process environment variables; it does not load this file.
# AGORA_CODEX_BIN=C:\path\to\codex.exe
AGORA_JEFF_MODEL=gpt-6-astra
AGORA_JEFF_REASONING=high
AGORA_JEFF_MAX_CALLS=100
AGORA_JEFF_TIMEOUT=900
# Set AGORA_JEFF_LOGIN=device for device-code sign-in instead of browser OAuth.
