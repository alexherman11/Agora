{
  "state": {
    "content": {
      "title": "The quiet life\nof leaves.",
      "subtitle": "A field guide to noticing what is already here.",
      "body": "A leaf is a small negotiation with light. Turn it, hold it, look again. The ordinary world becomes more interesting the longer we stay with it.",
      "kicker": "FIELD NOTES / VOLUME 04"
    },
    "appearance": {
      "accent": "#c86442",
      "paper": "#f4efe4",
      "ink": "#293d32",
      "headingSize": 76,
      "layout": "split",
      "bloom": 0.65,
      "rotation": 45,
      "caption": "A study in afternoon light."
    },
    "controls": {
      "light": 0.58
    },
    "items": [
      {
        "id": "field-notes",
        "kind": "publication",
        "role": "publication",
        "x": 28,
        "y": 46,
        "rotation": -1.3,
        "label": "Field Notes",
        "body": "A living publication.",
        "style": {
          "fill": "#f4efe4"
        }
      },
      {
        "id": "thought-1",
        "kind": "note",
        "role": "signal",
        "x": 705,
        "y": 85,
        "rotation": 6,
        "label": "What changes\nwhen you look again?",
        "body": "A thought for later.\nDrag me somewhere useful.",
        "style": {
          "fill": "#edc567"
        }
      },
      {
        "id": "specimen-1",
        "kind": "token",
        "role": "specimen",
        "x": 742,
        "y": 354,
        "rotation": -9,
        "label": "A little wildness",
        "body": "Collected in the clearing.",
        "style": {
          "fill": "#cf795a"
        }
      }
    ]
  },
  "program": {
    "version": 1,
    "rules": [
      {
        "id": "light-study",
        "on": "change",
        "steps": [
          {
            "op": "set",
            "path": "appearance.bloom",
            "value": [
              "clamp",
              [
                "add",
                0.15,
                [
                  "mul",
                  [
                    "get",
                    "controls.light"
                  ],
                  0.85
                ]
              ],
              0,
              1
            ]
          },
          {
            "op": "set",
            "path": "appearance.rotation",
            "value": [
              "mul",
              [
                "get",
                "controls.light"
              ],
              75
            ]
          },
          {
            "op": "set",
            "path": "appearance.caption",
            "value": [
              "if",
              [
                "gt",
                [
                  "get",
                  "controls.light"
                ],
                0.55
              ],
              "A study in afternoon light.",
              "A quieter kind of morning."
            ]
          }
        ]
      },
      {
        "id": "thoughts-follow-light",
        "on": "change",
        "steps": [
          {
            "op": "forEach",
            "collection": "items",
            "as": "item",
            "where": [
              "eq",
              [
                "var",
                "item.role"
              ],
              "signal"
            ],
            "steps": [
              {
                "op": "set",
                "target": "item",
                "path": "style.fill",
                "value": [
                  "if",
                  [
                    "gt",
                    [
                      "get",
                      "controls.light"
                    ],
                    0.55
                  ],
                  "#edc567",
                  "#aac7ba"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}