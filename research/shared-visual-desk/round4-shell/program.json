{
  "version": 1,
  "rules": [
    {
      "id": "open-shared-subject",
      "on": "select",
      "steps": [
        {
          "op": "forEach",
          "collection": "notes",
          "as": "note",
          "steps": [
            {
              "op": "set",
              "path": "selectedId",
              "value": [
                "var",
                "note.id"
              ]
            },
            {
              "op": "set",
              "path": "editor.noteId",
              "value": [
                "var",
                "note.id"
              ]
            },
            {
              "op": "set",
              "path": "editor.draft",
              "value": [
                "var",
                "note.text"
              ]
            },
            {
              "op": "set",
              "path": "editor.baseRev",
              "value": [
                "var",
                "note.rev"
              ]
            },
            {
              "op": "set",
              "path": "editor.dirty",
              "value": false
            },
            {
              "op": "set",
              "path": "editor.status",
              "value": "Reading shared subject"
            }
          ],
          "where": [
            "eq",
            [
              "var",
              "note.id"
            ],
            [
              "get",
              "event.id"
            ]
          ]
        }
      ]
    },
    {
      "id": "place-note",
      "on": "move",
      "steps": [
        {
          "op": "forEach",
          "collection": "notes",
          "as": "note",
          "steps": [
            {
              "op": "set",
              "target": "note",
              "path": "x",
              "value": [
                "clamp",
                [
                  "get",
                  "event.x"
                ],
                0,
                440
              ]
            },
            {
              "op": "set",
              "target": "note",
              "path": "y",
              "value": [
                "clamp",
                [
                  "get",
                  "event.y"
                ],
                0,
                340
              ]
            }
          ],
          "where": [
            "eq",
            [
              "var",
              "note.id"
            ],
            [
              "get",
              "event.id"
            ]
          ]
        }
      ]
    },
    {
      "id": "replace-tags-and-color",
      "on": "tag",
      "steps": [
        {
          "op": "forEach",
          "collection": "notes",
          "as": "note",
          "steps": [
            {
              "op": "set",
              "target": "note",
              "path": "tags",
              "value": [
                "get",
                "event.tags"
              ]
            },
            {
              "op": "set",
              "target": "note",
              "path": "color",
              "value": [
                "if",
                [
                  "eq",
                  [
                    "get",
                    "event.tags"
                  ],
                  [
                    "lit",
                    [
                      "priority"
                    ]
                  ]
                ],
                "#f6b85d",
                "#b9dbe8"
              ]
            }
          ],
          "where": [
            "eq",
            [
              "var",
              "note.id"
            ],
            [
              "get",
              "event.id"
            ]
          ]
        }
      ]
    },
    {
      "id": "hold-editor-draft",
      "on": "draft",
      "steps": [
        {
          "op": "set",
          "path": "editor.draft",
          "value": [
            "get",
            "event.text"
          ]
        },
        {
          "op": "set",
          "path": "editor.dirty",
          "value": true
        },
        {
          "op": "set",
          "path": "editor.status",
          "value": "Draft held; shared subject unchanged"
        }
      ]
    },
    {
      "id": "save-shared-subject",
      "on": "save",
      "steps": [
        {
          "op": "forEach",
          "collection": "notes",
          "as": "note",
          "steps": [
            {
              "op": "set",
              "target": "note",
              "path": "text",
              "value": [
                "get",
                "editor.draft"
              ]
            }
          ],
          "where": [
            "eq",
            [
              "var",
              "note.id"
            ],
            [
              "get",
              "editor.noteId"
            ]
          ]
        },
        {
          "op": "set",
          "path": "editor.dirty",
          "value": false
        },
        {
          "op": "set",
          "path": "editor.status",
          "value": "Saved to shared subject"
        }
      ]
    },
    {
      "id": "arrange-notes",
      "on": "arrange",
      "steps": [
        {
          "op": "forEach",
          "collection": "notes",
          "as": "note",
          "steps": [
            {
              "op": "set",
              "target": "note",
              "path": "x",
              "value": [
                "clamp",
                [
                  "add",
                  20,
                  [
                    "mul",
                    [
                      "var",
                      "note.order"
                    ],
                    150
                  ]
                ],
                0,
                440
              ]
            },
            {
              "op": "set",
              "target": "note",
              "path": "y",
              "value": [
                "clamp",
                [
                  "add",
                  30,
                  [
                    "mul",
                    [
                      "var",
                      "note.order"
                    ],
                    30
                  ]
                ],
                0,
                340
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "acknowledge-evidence",
      "on": "mark-seen",
      "steps": [
        {
          "op": "set",
          "path": "together.seenSeq",
          "value": [
            "get",
            "revision"
          ]
        },
        {
          "op": "set",
          "path": "together.summary",
          "value": "Read retained change evidence"
        }
      ]
    },
    {
      "id": "position-window",
      "on": "window",
      "steps": [
        {
          "op": "forEach",
          "collection": "windows",
          "as": "window",
          "where": [
            "eq",
            [
              "var",
              "window.id"
            ],
            [
              "get",
              "event.windowId"
            ]
          ],
          "steps": [
            {
              "op": "set",
              "target": "window",
              "path": "x",
              "value": [
                "clamp",
                [
                  "get",
                  "event.x"
                ],
                0,
                1600
              ]
            },
            {
              "op": "set",
              "target": "window",
              "path": "y",
              "value": [
                "clamp",
                [
                  "get",
                  "event.y"
                ],
                0,
                1200
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "explain-move",
      "on": "move",
      "steps": [
        {
          "op": "set",
          "path": "together.summary",
          "value": [
            "concat",
            [
              "get",
              "event.actor"
            ],
            " requested ",
            "move",
            " on ",
            [
              "get",
              "event.id"
            ]
          ]
        }
      ]
    },
    {
      "id": "explain-tag",
      "on": "tag",
      "steps": [
        {
          "op": "set",
          "path": "together.summary",
          "value": [
            "concat",
            [
              "get",
              "event.actor"
            ],
            " requested ",
            "tag",
            " on ",
            [
              "get",
              "event.id"
            ]
          ]
        }
      ]
    },
    {
      "id": "explain-save",
      "on": "save",
      "steps": [
        {
          "op": "set",
          "path": "together.summary",
          "value": [
            "concat",
            [
              "get",
              "event.actor"
            ],
            " requested ",
            "save",
            " on ",
            [
              "get",
              "event.id"
            ]
          ]
        }
      ]
    },
    {
      "id": "explain-arrange",
      "on": "arrange",
      "steps": [
        {
          "op": "set",
          "path": "together.summary",
          "value": [
            "concat",
            [
              "get",
              "event.actor"
            ],
            " requested ",
            "arrange",
            " on ",
            [
              "get",
              "event.id"
            ]
          ]
        }
      ]
    },
    {
      "id": "classify-created-subject",
      "on": "create",
      "steps": [
        {
          "op": "forEach",
          "collection": "notes",
          "as": "note",
          "where": [
            "eq",
            [
              "var",
              "note.id"
            ],
            [
              "get",
              "event.id"
            ]
          ],
          "steps": [
            {
              "op": "set",
              "target": "note",
              "path": "tags",
              "value": [
                "lit",
                [
                  "new"
                ]
              ]
            },
            {
              "op": "set",
              "target": "note",
              "path": "color",
              "value": "#d1edbb"
            }
          ]
        }
      ]
    },
    {
      "id": "reopen-saved-subject",
      "on": "reload-editor",
      "steps": [
        {
          "op": "forEach",
          "collection": "notes",
          "as": "note",
          "steps": [
            {
              "op": "set",
              "path": "selectedId",
              "value": [
                "var",
                "note.id"
              ]
            },
            {
              "op": "set",
              "path": "editor.noteId",
              "value": [
                "var",
                "note.id"
              ]
            },
            {
              "op": "set",
              "path": "editor.draft",
              "value": [
                "var",
                "note.text"
              ]
            },
            {
              "op": "set",
              "path": "editor.baseRev",
              "value": [
                "var",
                "note.rev"
              ]
            },
            {
              "op": "set",
              "path": "editor.dirty",
              "value": false
            },
            {
              "op": "set",
              "path": "editor.status",
              "value": "Reading shared subject"
            }
          ],
          "where": [
            "eq",
            [
              "var",
              "note.id"
            ],
            [
              "get",
              "event.id"
            ]
          ]
        }
      ]
    }
  ]
}
