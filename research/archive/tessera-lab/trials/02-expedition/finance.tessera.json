{
  "id": "finance",
  "claims": [
    {
      "kind": "field",
      "id": "projects.name",
      "type": "string",
      "default": ""
    },
    {
      "kind": "field",
      "id": "projects.available",
      "type": "number",
      "default": 0,
      "merge": "counter"
    },
    {
      "kind": "field",
      "id": "missions.charged",
      "type": "number",
      "default": 0
    },
    {
      "kind": "field",
      "id": "ledger.missionId",
      "type": "string",
      "default": ""
    },
    {
      "kind": "field",
      "id": "ledger.projectId",
      "type": "string",
      "default": ""
    },
    {
      "kind": "field",
      "id": "ledger.kind",
      "type": "string",
      "default": ""
    },
    {
      "kind": "field",
      "id": "ledger.amount",
      "type": "number",
      "default": 0
    },
    {
      "kind": "seed",
      "id": "projects/alpine",
      "values": {
        "name": "Alpine research",
        "available": 1000
      }
    },
    {
      "kind": "seed",
      "id": "projects/ocean",
      "values": {
        "name": "Coastal research",
        "available": 400
      }
    },
    {
      "kind": "action",
      "id": "finance.topUp",
      "requires": [
        "and",
        [
          "gt",
          [
            "number",
            [
              "arg",
              "amount"
            ]
          ],
          0
        ],
        [
          "eq",
          [
            "number",
            [
              "arg",
              "amount"
            ]
          ],
          [
            "round",
            [
              "number",
              [
                "arg",
                "amount"
              ]
            ]
          ]
        ],
        [
          "ne",
          [
            "record",
            "projects",
            [
              "arg",
              "id"
            ]
          ],
          null
        ]
      ],
      "effects": [
        {
          "op": "add",
          "collection": "projects",
          "id": [
            "arg",
            "id"
          ],
          "field": "available",
          "value": [
            "number",
            [
              "arg",
              "amount"
            ]
          ]
        }
      ]
    },
    {
      "kind": "reaction",
      "id": "finance.onDispatch",
      "on": "mission.dispatch",
      "when": true,
      "effects": [
        {
          "op": "set",
          "collection": "missions",
          "id": [
            "arg",
            "id"
          ],
          "field": "charged",
          "value": [
            "sum",
            [
              "map",
              [
                "filter",
                [
                  "all",
                  "lines"
                ],
                [
                  "eq",
                  [
                    "row",
                    "missionId"
                  ],
                  [
                    "arg",
                    "id"
                  ]
                ]
              ],
              [
                "mul",
                [
                  "row",
                  "qty"
                ],
                [
                  "get",
                  [
                    "record",
                    "stock",
                    [
                      "row",
                      "sku"
                    ]
                  ],
                  "unitCost"
                ]
              ]
            ]
          ]
        },
        {
          "op": "add",
          "collection": "projects",
          "id": [
            "get",
            [
              "record",
              "missions",
              [
                "arg",
                "id"
              ]
            ],
            "projectId"
          ],
          "field": "available",
          "value": [
            "sub",
            0,
            [
              "sum",
              [
                "map",
                [
                  "filter",
                  [
                    "all",
                    "lines"
                  ],
                  [
                    "eq",
                    [
                      "row",
                      "missionId"
                    ],
                    [
                      "arg",
                      "id"
                    ]
                  ]
                ],
                [
                  "mul",
                  [
                    "row",
                    "qty"
                  ],
                  [
                    "get",
                    [
                      "record",
                      "stock",
                      [
                        "row",
                        "sku"
                      ]
                    ],
                    "unitCost"
                  ]
                ]
              ]
            ]
          ]
        },
        {
          "op": "create",
          "collection": "ledger",
          "id": [
            "arg",
            "eventId"
          ],
          "values": {
            "missionId": [
              "arg",
              "id"
            ],
            "projectId": [
              "get",
              [
                "record",
                "missions",
                [
                  "arg",
                  "id"
                ]
              ],
              "projectId"
            ],
            "kind": "dispatch",
            "amount": [
              "sum",
              [
                "map",
                [
                  "filter",
                  [
                    "all",
                    "lines"
                  ],
                  [
                    "eq",
                    [
                      "row",
                      "missionId"
                    ],
                    [
                      "arg",
                      "id"
                    ]
                  ]
                ],
                [
                  "mul",
                  [
                    "row",
                    "qty"
                  ],
                  [
                    "get",
                    [
                      "record",
                      "stock",
                      [
                        "row",
                        "sku"
                      ]
                    ],
                    "unitCost"
                  ]
                ]
              ]
            ]
          }
        }
      ]
    },
    {
      "kind": "reaction",
      "id": "finance.onCancel",
      "on": "mission.cancel",
      "when": true,
      "effects": [
        {
          "op": "add",
          "collection": "projects",
          "id": [
            "get",
            [
              "record",
              "missions",
              [
                "arg",
                "id"
              ]
            ],
            "projectId"
          ],
          "field": "available",
          "value": [
            "get",
            [
              "record",
              "missions",
              [
                "arg",
                "id"
              ]
            ],
            "charged"
          ]
        },
        {
          "op": "create",
          "collection": "ledger",
          "id": [
            "arg",
            "eventId"
          ],
          "values": {
            "missionId": [
              "arg",
              "id"
            ],
            "projectId": [
              "get",
              [
                "record",
                "missions",
                [
                  "arg",
                  "id"
                ]
              ],
              "projectId"
            ],
            "kind": "refund",
            "amount": [
              "get",
              [
                "record",
                "missions",
                [
                  "arg",
                  "id"
                ]
              ],
              "charged"
            ]
          }
        }
      ]
    },
    {
      "kind": "constraint",
      "id": "finance.nonnegativeFunds",
      "check": [
        "eq",
        [
          "count",
          [
            "filter",
            [
              "all",
              "projects"
            ],
            [
              "lt",
              [
                "row",
                "available"
              ],
              0
            ]
          ]
        ],
        0
      ],
      "message": "Project funds cannot go below zero"
    },
    {
      "kind": "constraint",
      "id": "finance.projectReferences",
      "check": [
        "eq",
        [
          "count",
          [
            "filter",
            [
              "all",
              "missions"
            ],
            [
              "eq",
              [
                "record",
                "projects",
                [
                  "row",
                  "projectId"
                ]
              ],
              null
            ]
          ]
        ],
        0
      ],
      "message": "Every mission must reference an existing project"
    },
    {
      "kind": "query",
      "id": "finance.projects",
      "from": "projects",
      "sort": "name"
    },
    {
      "kind": "query",
      "id": "finance.ledger",
      "from": "ledger"
    },
    {
      "kind": "view",
      "id": "finance.panel",
      "parent": "workspace",
      "widget": "panel",
      "title": "Project finance",
      "order": 30
    },
    {
      "kind": "view",
      "id": "finance.projects",
      "parent": "finance.panel",
      "widget": "list",
      "query": "finance.projects",
      "order": 10
    },
    {
      "kind": "view",
      "id": "finance.project",
      "parent": "finance.projects",
      "widget": "panel",
      "role": "finance-project",
      "order": 10
    },
    {
      "kind": "view",
      "id": "finance.project.name",
      "parent": "finance.project",
      "widget": "text",
      "text": [
        "row",
        "name"
      ],
      "order": 10
    },
    {
      "kind": "view",
      "id": "finance.project.funds",
      "parent": "finance.project",
      "widget": "text",
      "text": [
        "concat",
        "Available funds: ",
        [
          "row",
          "available"
        ]
      ],
      "order": 20
    },
    {
      "kind": "view",
      "id": "finance.project.topup",
      "parent": "finance.project",
      "widget": "row",
      "order": 30
    },
    {
      "kind": "view",
      "id": "finance.project.amount",
      "parent": "finance.project.topup",
      "widget": "input",
      "bind": "topUpAmount",
      "inputType": "number",
      "placeholder": "Top-up amount",
      "order": 10
    },
    {
      "kind": "view",
      "id": "finance.project.submit",
      "parent": "finance.project.topup",
      "widget": "button",
      "text": "Add funds",
      "action": "finance.topUp",
      "args": {
        "id": [
          "row",
          "id"
        ],
        "amount": [
          "local",
          "topUpAmount"
        ]
      },
      "order": 20
    },
    {
      "kind": "view",
      "id": "finance.ledgerTitle",
      "parent": "finance.panel",
      "widget": "text",
      "text": "Transaction ledger",
      "order": 20
    },
    {
      "kind": "view",
      "id": "finance.ledger",
      "parent": "finance.panel",
      "widget": "list",
      "query": "finance.ledger",
      "order": 30
    },
    {
      "kind": "view",
      "id": "finance.ledger.entry",
      "parent": "finance.ledger",
      "widget": "text",
      "text": [
        "concat",
        [
          "row",
          "kind"
        ],
        " · ",
        [
          "row",
          "missionId"
        ],
        " · ",
        [
          "row",
          "amount"
        ],
        " (",
        [
          "row",
          "projectId"
        ],
        ")"
      ],
      "order": 10
    },
    {
      "kind": "view",
      "id": "finance.mission.quote",
      "parent": "missions.card",
      "widget": "text",
      "text": [
        "concat",
        "Cost quote: ",
        [
          "sum",
          [
            "map",
            [
              "filter",
              [
                "all",
                "lines"
              ],
              [
                "eq",
                [
                  "row",
                  "missionId"
                ],
                [
                  "parent",
                  "id"
                ]
              ]
            ],
            [
              "mul",
              [
                "row",
                "qty"
              ],
              [
                "get",
                [
                  "record",
                  "stock",
                  [
                    "row",
                    "sku"
                  ]
                ],
                "unitCost"
              ]
            ]
          ]
        ]
      ],
      "order": 60
    },
    {
      "kind": "view",
      "id": "finance.mission.charged",
      "parent": "missions.card",
      "widget": "text",
      "text": [
        "concat",
        "Charged: ",
        [
          "row",
          "charged"
        ]
      ],
      "visible": [
        "ne",
        [
          "row",
          "status"
        ],
        "draft"
      ],
      "order": 61
    },
    {
      "kind": "view",
      "id": "finance.mission.budget",
      "parent": "missions.card",
      "widget": "text",
      "text": [
        "concat",
        "Project funds: ",
        [
          "get",
          [
            "record",
            "projects",
            [
              "row",
              "projectId"
            ]
          ],
          "available"
        ]
      ],
      "order": 62
    }
  ]
}
