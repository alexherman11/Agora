root : board-shell, title "Seabright"
  watch reading:"board.badges"
  watch reading:"rows board-mark"
  watch reading:"rows kind"
  watch reading:"rows board-channel"
  watch reading:"rows board-order"
  watch reading:"rows board-settings"
  watch reading:"rows board-rsvp"
  channels : board-navigation
    watch reading:"rows board-seen"
    watch reading:"board.queue"
  centre : column, role nb-centre
    action-result : action-notice, scopeKeys "channel opens thread search queue asksThread documentsFolder documentsOpen"
      on undo do undo $value
    tools : board-toolbar
    calendar : calendar, of reading:"board.events in=$view.channel around=$view.calendarDate" as e, limit 100, each calendar-event, openKey "thread replyTo", label "Calendar"
      only when $view.opens = calendar and $view.search = "" and $view.queue != yes
      on add do board.post post_kind=event in=$view.channel $fields
      on rsvp do board.rsvp $target status=$value
    asks : lens, name seabright-asks
      only when $view.opens = asks and $view.search = "" and $view.queue != yes
    documents : lens, name seabright-documents
      only when $view.opens = documents and $view.search = "" and $view.queue != yes
    catchup : board-catchup, of reading:"board.catch-up in=$view.channel" as c, limit 100, each catchup-item
      only when $view.channel != "" and $view.search = "" and $view.queue != yes
      on seen do board.seen in=$view.channel
      on snapshot do make kind=board-catch-up sees=me title="Catch-up summary context" text=$value
      on summarize do model.ask "Summarise this neighbourhood catch-up in two short sentences." about=$target
    notices : column, of reading:"forgotten" as n, each notice
    feed : board-feed, of reading:"board.feed order=$view.order in=$view.channel" as p, limit 12, offset $view.offset, each post
      only when $view.search = "" and $view.queue != yes and $view.opens = ""
    results : board-search, of reading:"board.search q=$view.search in=$view.channel kind=$view.kind person=$view.person since=$view.since before=$view.before" as r, limit 12, each result
      only when $view.search != ""
    queue : board-search, of reading:"board.queue in=$view.channel" as r, each catchup-item
      only when $view.queue = yes
  map : map-panel, map Seabright, board yes, height 520px
  conversation : board-thread
    only when $view.thread != ""
    on reply do board.reply $target $fields
    hidden : column, of reading:"forgotten", prop:id=$view.thread as n, each notice
    selected : column, of tag:post, prop:id=$view.thread as p, each detail
    replies : column, of tag:post, prop:thread=$view.thread as p, by made, each detail
      only when $view.thread != ""
  compose : board-composer
    only when $view.compose = yes or $view.hide != "" or $view.report != "" or $view.decide != "" or $view.edit != "" or $view.pin != ""
    on post do board.post $fields
    on attach do attach $file to=$target
    on hide do forget $target reason=$value
    on report do board.report $target reason=$value
    on decide do board.decide $target text=$value
    on edit do set $target text=$value
    on pin do pin $target until=$value
catchup-item : board-entry
notice : board-notice
  on undo do undo $value
post : board-post, layout compact, excerptLines 3
  format stamp as short-relative
  format date as calendar-date
  format initials as initials
  on like do like $item
  on personal do board.personal $item action=$value
  on unpersonal do undo $value
  on rsvp do board.rsvp $item status=$value
  on answer do board.answer $target reply=$reply
  body : markdown, value $p.text
  fields : field-list, fields ""
    format stamp as calendar-date
  date : date-tile, start $p.start, end $p.end, place $p.location
    only when $p.start != ""
    format date as calendar-date
    format month as month
    format day as day
    format weekday as weekday
    format time as time
  poll : poll
    format stamp as short-relative
    only when $p.post_kind = poll
    on vote do vote $item $value
    when fact votes changes play pulse
  slots : slots
    only when $p.seats > 0 and $p.post_kind != event
    on claim do claim $item
  files : column, of tag:file, prop:attached_to=$p.id as file, limit 1, each attachment-preview
  when fact likes changes play pulse
detail : board-post, detail yes, layout compact
  format stamp as short-relative
  format date as calendar-date
  format initials as initials
  on like do like $item
  on personal do board.personal $item action=$value
  on unpersonal do undo $value
  on rsvp do board.rsvp $item status=$value
  on answer do board.answer $target reply=$reply
  body : markdown, value $p.text
  fields : field-list, fields ""
    format stamp as calendar-date
  date : date-tile, start $p.start, end $p.end, place $p.location
    only when $p.start != ""
    format date as calendar-date
    format month as month
    format day as day
    format weekday as weekday
    format time as time
  poll : poll
    format stamp as short-relative
    only when $p.post_kind = poll
    on vote do vote $item $value
    when fact votes changes play pulse
  slots : slots
    only when $p.seats > 0 and $p.post_kind != event
    on claim do claim $item
  event-slots : column, of tag:slot, prop:event=$p.id as slot, each slot
  files : column, of tag:file, prop:attached_to=$p.id as file, each attachment
  when fact likes changes play pulse
slot : slots
  on claim do claim $item
attachment : column, of reading:"file-read $file.id" as content, each attachment-content
attachment-content : file, content $content, name $file.name, owner $file.upload_owner, page $view.documentPage, pageTarget $view.documentFile, pageRequest $view.documentRequest
  format stamp as calendar-date
  on alt do set $target alt=$value
  on rsvp do board.rsvp $target status=going
  on calendar do board.calendar $target
  table : table, sortable yes
attachment-preview : column, of reading:"file-read $file.id" as content, each attachment-thumbnail
attachment-thumbnail : file, content $content, name $file.name, owner $file.upload_owner, variant thumbnail
  format stamp as calendar-date
  on alt do set $target alt=$value
  on rsvp do board.rsvp $target status=going
  on calendar do board.calendar $target
  table : table, sortable yes
result : board-entry
  format stamp as short-relative
calendar-event : text "$e.title"
  format stamp as short-relative
