# Copy to .env (in this folder) and fill in. Alex writes .env himself; it is never committed.
# Everything here is optional in test mode.

# test (default) or live
SITE_MODE=test
# live: https://seabright.example.org
SITE_BASE_URL=
SITE_PORT=8817

# The first leaders, comma separated. They can sign in without an invite and make invites.
SITE_LEADERS=

# Google sign-in: a "Web application" OAuth client from Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (live mode only): any provider's SMTP settings. Without EMAIL_SMTP_HOST live mode still starts;
# email sign-in then says to ask a leader, and leaders use: python -m agora_entry signin-link <email>
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=Seabright Neighbours <signin@seabright.example.org>

# Where people land after joining or signing in (the board, served by the kernel at /).
SITE_HOME=/
# Guest passes from a meeting's QR code end at 23:59:59 on the next day, in this zone.
SITE_TIMEZONE=America/Los_Angeles
# How long after a guest pass ends its browser can still sign up and keep the account.
SITE_GUEST_CLAIM_DAYS=14
# Rate limits: SITE_LIMIT_<KIND>=<count> for any kind in web.LIMITS (email_ip, email_addr, code_ip,
# link_ip, google_ip, join_ip, page_ip, guest_ip, guest_invite, invite_make, email_noinvite).
# SITE_IP_LIMITS=off turns off every *_ip limit, when all clients reach this service from one proxy address.
SITE_IP_LIMITS=on
# SITE_LIMIT_GUEST_INVITE=300

# Behind Cloudflare: CF-Connecting-IP (only if the server accepts traffic from Cloudflare alone).
SITE_PROXY_IP_HEADER=

# The kernel: where it listens, and the key both sides use (any long random string, the same in the kernel's settings).
# Without KERNEL_URL, nobody is handed to a kernel yet. The kernel will listen on http://127.0.0.1:8810.
KERNEL_URL=
KERNEL_SHARED_SECRET=
