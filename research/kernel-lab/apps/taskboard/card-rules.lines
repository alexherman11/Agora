rule name="Cards waiting on a landing" by=anyone on=house.land do="task.signal $target mode=waiting event=landed route=alex_ask:JEFF cc=Alex unseen=\"the dependency\" text=\"Unblocked: {title} has landed\""
rule name="Cards waiting on completion" by=anyone on=task.done do="task.signal $target mode=waiting event=done route=alex_ask:JEFF cc=Alex unseen=\"the dependency\" text=\"Unblocked: {title} is done\""
rule name="Call the landing recipient" by=anyone on=house.land do="task.signal $target mode=notify event=landed route=alex_ask:JEFF cc=Alex unseen=\"the dependency\" text=\"{title} has landed; your next step is due.\""
rule name="Tell the fix reporter" by=anyone on=house.land do="task.signal $target mode=reporter event=landed route=alex_ask:JEFF cc=Alex unseen=\"the dependency\" text=\"A fix for what you found has landed: {title}. Please check it.\""
rule name="Deliver asynchronous publication notes" by=anyone on=set do="task.signal $target mode=waiting event=landed route=alex_ask:JEFF cc=Alex unseen=\"the dependency\" text=\"Unblocked: {title} has landed\"; task.signal $target mode=notify event=landed route=alex_ask:JEFF cc=Alex unseen=\"the dependency\" text=\"{title} has landed; your next step is due.\"; task.signal $target mode=reporter event=landed route=alex_ask:JEFF cc=Alex unseen=\"the dependency\" text=\"A fix for what you found has landed: {title}. Please check it.\""
