verb task.land-notices steps="task.signal $target mode=waiting event=landed route=alex_ask:JEFF; task.signal $target mode=notify event=landed route=alex_ask:JEFF; task.signal $target mode=reporter event=landed route=alex_ask:JEFF" help="Deliver the landing rules after asynchronous publication records build=landed; deduplicated with house.land."
rule name="Cards waiting on a landing" by=anyone on=house.land do="task.signal $target mode=waiting event=landed route=alex_ask:JEFF"
rule name="Cards waiting on completion" by=anyone on=task.done do="task.signal $target mode=waiting event=done route=alex_ask:JEFF"
rule name="Call the landing recipient" by=anyone on=house.land do="task.signal $target mode=notify event=landed route=alex_ask:JEFF"
rule name="Tell the fix reporter" by=anyone on=house.land do="task.signal $target mode=reporter event=landed route=alex_ask:JEFF"
rule name="Deliver asynchronous publication notes" by=anyone on=set do="task.land-notices $target"
