# Work: who is at work and what is moving, one page (Alex, 27 Oct: "a really good overview of all the work being
# done, where i can click in and view more closely or chat with workers directly"). Brought forward from the old
# desk's home-work and home-board panels (old-desk/): bands with counts, one compact line per card, colour says whose
# move it is (amber Alex's, lilac a resident's, mint an agent at work now, the rest grey), an empty band one quiet line.
# Right: the open person's log as a terminal (house.log: their chat, the receipts of their acts, what they did outside
# any chat, what they are doing now; newest at the bottom) with a prompt under it that says into their chat.
# $SHOP is Shop talk's id, filled in by install.py; a person with no chat of their own is talked to there, by @name.
root : column, of tag:work-view as view, each page
page : grid, columns "5fr 7fr", gap 36px
  left : column
    list : column, gap 16px
      title : text "Work", role heading
      people : band, name "At work", tone mint, empty "no one the house runs"
        rows : column, of reading:"house.who" as a, each person
      needs : band, name "Needs you", tone amber, empty "nothing waits on you"
        rows : column, of tag:taskboard-task, prop:who=Alex as t, each needs-line
      builds : band, name "Builds", tone lilac, empty "no builds yet"
        rows : column, of tag:taskboard-task as t, each build-line
      moving : band, name "In motion", tone mint, empty "nothing in motion"
        rows : column, of tag:taskboard-task, prop:lane=Now as t, each moving-line
      landed : band, name "Landed", tone grey, empty "nothing landed yet", folded yes
        rows : column, of tag:taskboard-task, prop:lane=Done as t, limit 12, each landed-line
  right : column
    pick : text "Open someone on the left to see their log and talk to them.", role sub
      only when $view.agent = ""
    up : column, width 100%, of reading:"house.who" as sel, each close
person : row, gap 8px
  only when $a.name != ""
  state : badge, label $a.doing
  name : text "$a.name"
  now : text "$a.now", role sub
  open : button, label "Open"
    on press do set $view.id agent=$a.person
needs-line : row, gap 8px
  only when $t.lane != "Done"
  state : badge, label "yours"
  what : text "$t.title"
build-line : row, gap 8px
  only when $t.build != ""
  state : badge, label $t.build
  what : text "$t.title"
  who : text "$t.builder", role sub
moving-line : row, gap 8px
  state : badge, label "$t.who"
  what : text "$t.title"
landed-line : row, gap 8px
  state : badge, label "done"
  what : text "$t.title", role sub
close : column, gap 8px, width 100%
  only when $sel.person = $view.agent
  head : row, gap 10px
    state : badge, label $sel.doing
    name : text "$sel.name"
    model : text "$sel.now · $sel.model $sel.reasoning · $sel.turns turns · first words $sel.first_words", role sub
  log : column, width 100%, of reading:"house.log $sel.person limit=200" as l, each terminal
terminal : column, width 100%
  in-chat : console, value $l.log, label "$sel.name's log", hint "Write to $sel.name…", empty "Nothing yet. Say something below."
    only when $sel.chat != ""
    on say do say $sel.chat text="$value"
  in-shop : console, value $l.log, label "$sel.name's log", hint "Write to $sel.name in Shop talk…", empty "Nothing yet."
    only when $sel.chat = ""
    on say do say $SHOP text="@$sel.name $value"
