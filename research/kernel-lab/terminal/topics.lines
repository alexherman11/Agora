# Help topics: the pages `help <topic>` shows. World data, made with ordinary words; install_topics.py makes each
# one only if no topic of that name exists yet, so edits made in the world (set <topic> text=...) are never undone.
# --refresh rewrites a page only when nobody but this installer's agent has changed it.
# A topic: name (what you type after help), aliases (other names, plurals are free), words (the words it lists, most
# useful first; * matches any ending), text (one short paragraph; \n is a new line), order (its place in `help`).
# 27 Oct: the language Alex approved (names where ids go, plain verbs, dotted families, who/recent, undo the whole act).

make kind=topic name=start order=0 title="Lines" words="look help who recent window.list window.open window.move make set forget undo rows post task.add theme.use verb" text="type a line, the world answers.\n  window.move Feed to=left    a word, then the thing it acts on (its name or id), then settings\n  close Help                  plain verbs (open, close, move, done) work out what you mean from the thing\n  post \"hello there\"          quote text that has spaces; ; puts two lines in one\n  undo                        every act prints a receipt [r812]; undo takes back your latest whole act\nsee words only read; do words change things.\nwords worth knowing:"

make kind=topic name=lines order=1 title="How a line works" aliases="terminal syntax quoting quotes ids receipts line names" words="help look rows find kinds undo history recent" text="word, then thing, then key=value settings, then free words: set Lines at=40,40 · post \"two words\" · window.open feed to=left. A thing is named by its name or its id (dk74, shown in every answer); when two things share a name the answer lists their ids to choose from. Families are spelled family.word (window.move, task.add, theme.use); a plain verb (close, open, move, done) finds the family word for the thing you name. A receipt [r812] names a record; undo r812 takes it back. ; separates two lines. see words read and never change anything; do words act; hear words are things that happen (rules listen for them)."

make kind=topic name=windows order=2 title="Windows" aliases="window screen desktop" words="window.list window.open window.move window.close window.focus wm.windows wm.arrange wm.mode window.* wm.*" text="Agora windows are world things (kind=window). window.list shows the open ones; window.open <lens or view> opens one (window.open feed to=left); move, close or focus one by its name or id (close Help, window.move Feed to=right). Spots: left right center big top-left top-right bottom-left bottom-right. wm.* is the window manager for every window on the PC, Agora's or not."

make kind=topic name=theme order=3 title="Themes" aliases="themes colours colors appearance look-and-feel wallpaper" words="theme.current theme.list theme.use theme.try theme.keep theme.revert theme.make theme.edit theme.*" text="one look for every window, bar and widget. theme.current says what you wear and why. theme.use <name> wears it, just you (an agent changes it for the person it acts for); theme.use place goes back to the place's. theme.try <name> wears one for a while (theme.keep keeps it). theme.use <name> for=place changes everyone's (stewards). Names with spaces need quotes."

make kind=topic name=tasks order=4 title="Task board" aliases="task board taskboard taskboard-task todo card cards" words="task.add task.move task.done task.note task.rename task.text task.priority task.remove task.* rows" text="cards on the task board (kind=taskboard-task), in lanes Backlog, Now and Done. task.add title=\"Buy milk\" to=Backlog adds one. done \"Buy milk\" (or task.done) finishes it; task.move \"Buy milk\" to=Now moves it. rows taskboard-task lists them all. Each is one act, so undo takes it back, with anything a rule did because of it."

make kind=topic name=feed order=5 title="The feed" aliases="posts post social like pin" words="look post like pin reply board.* catch-up" text="the place's posts. look shows the feed, pinned first; post <words> shares something; like <post> and pin <post> (leaders) act on one. board.* are the community board's threads, questions and events. A pin on the dock is a different thing: help buttons."

make kind=topic name=buttons order=6 title="Buttons and pins on the bars" aliases="button dock taskbar bar bars pins shortcut shortcuts press" words="press make set forget rows" text="a button is a world thing: make kind=button bar=taskbar label=Feed does=\"window.open feed\" order=2 puts one on the dock (bar=taskbar is the dock). does= is the line it runs, as whoever presses it; press Feed runs it from here. A pin opens a thing: make kind=pin bar=taskbar shows=<thing>. rows button bar=taskbar lists them; set Feed label=News changes one; forget Feed takes it off."

make kind=topic name=music order=7 title="Music and media" aliases="media audio song songs play playing pause" words="media.now media.pause media.resume media.play media.next media.prev" text="what Windows' media session is playing (Spotify, a browser...). media.now says what is playing; media.pause and media.resume do just that, and press nothing when there is nothing to do; media.play is a toggle (start=yes presses play even when nothing is named). These act outside the world, so undo cannot take them back."

make kind=topic name=people order=8 title="Who is here" aliases="who whoami person persons agents agent members everyone me" words="who recent look role board.badges" text="who lists the people (and who leads), the agents and whom they act for, and the modules. An agent acts with its person's rights, so what it changes that person changes. recent by=<name> shows what someone did lately; role <person> leader|member in=<group> changes a role."

make kind=topic name=undo order=9 title="Undo and history" aliases="history back mistake mistakes records changes recent" words="undo recent history forgotten forget" text="every act gets a receipt [r812]. undo takes back your latest whole act: what you did and what rules did because of it; undo r812 takes back that one. recent shows the latest acts you can see, newest first (recent by=me, kind=window, since=r800). history alone shows your own; history <thing> one thing's trail. forget <thing> hides a thing; undo brings it back. Acts outside the world (music, Windows' own windows) cannot go back."

make kind=topic name=words order=10 title="Making your own words" aliases="verb verbs rule rules alias aliases dictionary new-word shortcut" words="verb rule word.set word.rename word.copy" text="verb tidy steps=\"window.move $1 to=left; window.move $2 to=right\" help=\"tidy <a> <b>: two windows side by side\" makes a new word; steps are lines separated by ;, $1 $2 are what follows the word, $name is a setting (name=...). A family word is family.word (task.archive), unless a module owns that family. rule on=<word> do=\"<line>\" runs a line whenever that word is used. word.set <word> aliases=\"open\" gives a word another name. help <your word> shows its help at once."

make kind=topic name=fixing order=11 title="Fixing help" aliases="fix improve help-check edit-help unclear" words="word.set ask set" text="help check lists help that may mislead. To fix a word's help: help <word>, then word.set <word> help=\"<word> <what it takes>: what it does.\" To fix a topic page: help <topic> shows its id, then set <id> text=\"...\" (or words=\"...\" to change its list). Not a steward? ask <id> text=\"what confused you\" asks for the change."
