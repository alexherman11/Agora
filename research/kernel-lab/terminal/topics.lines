# Help topics: the pages `help <topic>` shows. World data, made with ordinary words; install_topics.py makes each
# one only if no topic of that name exists yet, so edits made in the world (set <topic> text=...) are never undone.
# A topic: name (what you type after help), aliases (other names, plurals are free), words (the words it lists, most
# useful first; * matches any ending), text (one short paragraph), order (the place in `help` topics).

make kind=topic name=start order=0 title="Lines" words="look help window.list window.open window.move make set forget undo history rows post task-add theme.use verb" text="type a line, the world answers.\n  window.move dk74 to=left    a word, then the thing it acts on (its id), then settings\n  post \"hello there\"          quote text that has spaces; ; puts two lines in one\n  undo                        every act prints a receipt [r812]; undo takes back your latest, undo r812 that one\nIds are in every answer (rows <kind> lists them). see words only read; do words change things.\nwords worth knowing:"

make kind=topic name=lines order=1 title="How a line works" aliases="terminal syntax quoting quotes ids receipts line" words="help look rows find undo history" text="word, then thing, then key=value settings, then free words: set dk74 at=40,40 · post \"two words\" · window.open feed to=left. A thing is named by its id (dk74, shown in every answer; rows <kind> lists them). A receipt [r812] names a record; undo r812 takes it back. ; separates two lines, and a do line that runs several steps is still one act, one undo. see words read (they never change anything); do words act; hear words are things that happen (rules listen for them)."

make kind=topic name=windows order=2 title="Windows" aliases="window screen desktop" words="window.list window.open window.move window.close window.focus wm.windows wm.arrange wm.mode window.* wm.*" text="Agora windows are world things (kind=window). window.list shows the open ones with their ids; window.open <lens or view> opens one (window.open feed to=left); move, close or focus one by its id. Spots: left right center big top-left top-right bottom-left bottom-right. wm.* is the window manager for every window on the PC, Agora's or not."

make kind=topic name=theme order=3 title="Themes" aliases="themes colours colors appearance look-and-feel wallpaper" words="theme.current theme.list theme.try theme.keep theme.use theme.revert theme.make theme.edit theme.*" text="one look for every window, bar and widget. theme.current says what you wear and why. Just for you: theme.try <name> wears one for a while (theme.keep keeps it), theme.use <name> for=me keeps it now, theme.use place for=me goes back to the place's. theme.use <name> alone changes the place's theme (stewards). Names with spaces need quotes."

make kind=topic name=tasks order=4 title="Task board" aliases="task board taskboard taskboard-task todo card cards" words="task-add task-move task-done task-note task-rename task-text task-priority task-remove task-* rows" text="cards on the task board (kind=taskboard-task), in lanes Backlog, Now and Done. task-add title=\"Buy milk\" to=Backlog adds one; its receipt names its id. task-done <id> finishes it; task-move <id> to=Now moves it. rows taskboard-task lists them all. Each is one act, so undo takes it back."

make kind=topic name=feed order=5 title="The feed" aliases="posts post social like pin" words="look post like pin reply board.* catch-up" text="the place's posts. look shows the feed, pinned first; post <words> shares something; like <id> and pin <id> (leaders) act on a post. board.* are the community board's threads, questions and events."

make kind=topic name=buttons order=6 title="Buttons and pins on the bars" aliases="button dock taskbar bar bars pins shortcut shortcuts" words="make set forget rows" text="a button is a world thing: make kind=button bar=taskbar label=Feed does=\"window.open feed\" order=2 puts one on the dock (bar=taskbar is the dock). does= is the line it runs, as whoever presses it. A pin opens a thing: make kind=pin bar=taskbar shows=<id>. rows button bar=taskbar lists them; set <id> label=... changes one; forget <id> takes it off."

make kind=topic name=music order=7 title="Music and media" aliases="media audio song songs play playing pause" words="media.now media.play media.next media.prev" text="what Windows' media session is playing (Spotify, a browser...). media.now says what is playing; media.play plays or pauses it (one word, a toggle); media.next and media.prev skip. These act outside the world, so undo cannot take them back."

make kind=topic name=people order=8 title="Who is here" aliases="who whoami person persons agents agent members everyone me" words="rows look role board.badges" text="rows person lists the people here and rows agent the agents (each acts for a person, with that person's rights). look <id> says who one is; board.badges names leaders and stewards; role <person> leader|member in=<group> changes a role. rows module lists the modules, which act too."

make kind=topic name=undo order=9 title="Undo and history" aliases="history back mistake mistakes records changes recent" words="undo history forgotten forget" text="every act gets a receipt [r812]. undo takes back your latest act; undo r812 takes back that one (an undo is itself an act, so a second undo takes back the act before). history <id> shows a thing's trail: when, who, which word, what changed. forget <id> hides a thing; undo brings it back. Acts outside the world (music, Windows' own windows) say undo: external."

make kind=topic name=words order=10 title="Making your own words" aliases="verb verbs rule rules alias aliases dictionary new-word shortcut" words="verb rule word-set word-rename rename dictionary-copy" text="verb tidy steps=\"window.move $1 to=left; window.move $2 to=right\" help=\"tidy <a> <b>: two windows side by side\" makes a new word; steps are lines separated by ;, $1 $2 are what follows the word, $name is a setting (name=...). rule on=<word> do=\"<line>\" runs a line whenever that word is used. word-set <word> aliases=\"open\" gives a word another name. help <your word> shows its help at once."

make kind=topic name=fixing order=11 title="Fixing help" aliases="fix improve help-check edit-help unclear" words="word-set ask set" text="help check lists help that may mislead. To fix a word's help: help <word>, then word-set <word> help=\"<word> <what it takes>: what it does.\" To fix a topic page: help <topic> shows its id, then set <id> text=\"...\" (or words=\"...\" to change its list). Not a steward? ask <id> text=\"what confused you\" asks for the change."
