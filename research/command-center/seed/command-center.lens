porch : column, role page
  top : row, role bar
    name : text "THE PORCH", role title
    asks : row, of kind:chat,unanswered:$me, each ask
  main : grid 4 4 5, gap
    people : column
      h1 : text "RESIDENTS", role heading
      list : column, of kind:surface,prop:role=resident, each res
    middle : column
      h2 : text "FOR YOU", role heading
      inbox : column, of kind:chat,unanswered:$me, each chat
      h3 : text "PORCH TALK", role heading
      talk : column, the kind:chat,prop:members=all
        tmsgs : column, of messages:$id, scroll end, each m
        tsay : text "", hint "say something · @name reaches one now · @everyone reaches all", on edit do append $item line="$value"
    right : column
      h4 : text "BOARD", role heading
      add : text "", hint "a new chunk of work", on edit do create Board kind=task title="$value" status=open
      cols : grid 1 1 1
        open : column, role drop, on drop card do prop $carried status=open
          oh : text "BACKLOG", role meta
          ol : column, of kind:task,prop:status=open, each card
        doing : column, role drop, on drop card do prop $carried status=doing
          dh : text "NOW", role meta
          dl : column, of kind:task,prop:status=doing, each card
        done : column, role drop, on drop card do prop $carried status=done
          xh : text "DONE", role meta
          xl : column, of kind:task,prop:status=done, clamp 6, each card
      h5 : text "THE WORLD", role heading
      ev : column, of events, clamp 12, each e
ask : text "$title", role chip
res : column, role card
  rname : text "$title", role name
  rstat : text "wants $want", role meta
  rnow : text "$status", role tag, only when prop:status
  live : column, of house:$id, each hs
  dms : column, of kind:chat,in:$id, each chat
  wake : text "[ wake ]", role tool, on click do prop $item want=awake, only when prop:want=rest
  rest : text "[ let rest ]", role tool, on click do prop $item want=rest, only when prop:want=awake
hs : column
  hd : text "$doing", role meta
  ht : text "$turns turns, the last at $since", role meta, only when $turns > 0
chat : column, role card.plain
  ctitle : text "$title", role meta
  msgs : column, of messages:$id, scroll end, each m
  say : text "", hint "answer", on edit do append $item line="$value"
m : row, gap
  who : text "$who", role tag
  said : text "$said", role body
card : column, role card.plain, carry
  ct : text "$title", role body
  aim : text "objective", role mark, only when prop:objective=open
  go : text "[ start ]", role tool, on click do prop $item status=doing, only when prop:status=open
  fin : text "[ done ]", role tool, on click do prop $item status=done, only when prop:status=doing
  pick : text "[ make objective ]", role tool, on click do prop $item objective=open, only when prop:status=doing,-prop:objective=open
e : text "$by $verb $target", role meta
