{
  "id": "logistics",
  "claims": [
    {"kind":"field","id":"stock.name","type":"string","default":"","merge":"register"},
    {"kind":"field","id":"stock.available","type":"number","default":0,"merge":"counter"},
    {"kind":"field","id":"stock.unitCost","type":"number","default":0,"merge":"register"},
    {"kind":"seed","id":"stock/radio","values":{"name":"Field radio","available":3,"unitCost":120}},
    {"kind":"seed","id":"stock/tent","values":{"name":"Storm tent","available":2,"unitCost":300}},
    {"kind":"query","id":"logistics.inventory","from":"stock","sort":"name"},
    {"kind":"query","id":"logistics.missionLines","from":"lines","where":["eq",["row","missionId"],["parent","id"]],"sort":"sku"},
    {"kind":"query","id":"logistics.shortages","from":"lines","where":["and",["eq",["get",["record","missions",["row","missionId"]],"status"],"draft"],["gt",["row","qty"],["get",["record","stock",["row","sku"]],"available"]]],"sort":"sku"},
    {"kind":"action","id":"stock.restock","requires":["and",["ne",["record","stock",["arg","id"]],null],["gt",["arg","qty"],0],["eq",["arg","qty"],["round",["arg","qty"]]]],"effects":[{"op":"add","collection":"stock","id":["arg","id"],"field":"available","value":["arg","qty"]}]},
    {"kind":"reaction","id":"logistics.onDispatch","on":"mission.dispatch","when":true,"effects":[{"op":"foreach","in":["filter",["all","lines"],["eq",["row","missionId"],["arg","id"]]],"effects":[{"op":"add","collection":"stock","id":["row","sku"],"field":"available","value":["sub",0,["row","qty"]]}]}]},
    {"kind":"reaction","id":"logistics.onCancel","on":"mission.cancel","when":true,"effects":[{"op":"foreach","in":["filter",["all","lines"],["eq",["row","missionId"],["arg","id"]]],"effects":[{"op":"add","collection":"stock","id":["row","sku"],"field":"available","value":["row","qty"]}]}]},
    {"kind":"constraint","id":"logistics.noNegativeStock","check":["eq",["count",["filter",["all","stock"],["lt",["row","available"],0]]],0],"message":"Dispatch exceeds available stock"},
    {"kind":"constraint","id":"logistics.validQuantities","check":["eq",["count",["filter",["all","lines"],["not",["and",["gt",["row","qty"],0],["eq",["row","qty"],["round",["row","qty"]]]]]]],0],"message":"Packing quantity must be a positive whole number"},
    {"kind":"constraint","id":"logistics.validStockReferences","check":["eq",["count",["filter",["all","lines"],["eq",["record","stock",["row","sku"]],null]]],0],"message":"Packing line refers to missing stock"},
    {"kind":"constraint","id":"logistics.validMissionReferences","check":["eq",["count",["filter",["all","lines"],["eq",["record","missions",["row","missionId"]],null]]],0],"message":"Packing line refers to missing mission"},
    {"kind":"view","id":"logistics.panel","parent":"workspace","widget":"panel","title":"Inventory","order":20},
    {"kind":"view","id":"logistics.overview","parent":"logistics.panel","widget":"text","text":["concat",["count",["query","logistics.shortages"]]," packing lines currently exceed stock."],"order":1},
    {"kind":"view","id":"logistics.stockList","parent":"logistics.panel","widget":"list","query":"logistics.inventory","order":2},
    {"kind":"view","id":"logistics.stockRow","parent":"logistics.stockList","widget":"row","role":"stock-row","order":1},
    {"kind":"view","id":"logistics.stockText","parent":"logistics.stockRow","widget":"text","text":["concat",["row","name"]," (",["row","id"],"): ",["row","available"]," available · ",["row","unitCost"]," credits each"],"order":1},
    {"kind":"view","id":"logistics.restockQty","parent":"logistics.stockRow","widget":"input","inputType":"number","bind":"restockQty","value":1,"placeholder":"Qty","order":2},
    {"kind":"view","id":"logistics.restockButton","parent":"logistics.stockRow","widget":"button","text":"Restock","action":"stock.restock","args":{"id":["row","id"],"qty":["local","restockQty"]},"order":3},
    {"kind":"view","id":"logistics.missionPack","parent":"missions.card","widget":"panel","title":"Packing availability","order":40},
    {"kind":"view","id":"logistics.missionPackList","parent":"logistics.missionPack","widget":"list","query":"logistics.missionLines","order":1},
    {"kind":"view","id":"logistics.missionPackRow","parent":"logistics.missionPackList","widget":"row","role":"packing-availability","order":1},
    {"kind":"view","id":"logistics.missionPackText","parent":"logistics.missionPackRow","widget":"text","text":["concat",["row","qty"]," × ",["get",["record","stock",["row","sku"]],"name"]," · available ",["get",["record","stock",["row","sku"]],"available"]],"order":1},
    {"kind":"view","id":"logistics.missionShortage","parent":"logistics.missionPackRow","widget":"badge","text":"Shortage","visible":["gt",["row","qty"],["get",["record","stock",["row","sku"]],"available"]],"order":2},
    {"kind":"view","id":"logistics.missionReady","parent":"missions.tools","widget":"badge","text":"Stock checked at dispatch","visible":["eq",["row","status"],"draft"],"order":60}
  ]
}
