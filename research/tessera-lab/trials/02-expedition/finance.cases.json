[
  {
    "steps": [
      {
        "action": "mission.dispatch",
        "args": {
          "id": "ridge",
          "eventId": "dispatch-ridge"
        }
      },
      {
        "action": "mission.cancel",
        "args": {
          "id": "ridge",
          "eventId": "cancel-ridge"
        }
      }
    ],
    "assert": [
      {
        "expr": [
          "get",
          [
            "record",
            "projects",
            "alpine"
          ],
          "available"
        ],
        "equals": 1000
      },
      {
        "expr": [
          "get",
          [
            "record",
            "missions",
            "ridge"
          ],
          "charged"
        ],
        "equals": 540
      },
      {
        "expr": [
          "get",
          [
            "record",
            "ledger",
            "dispatch-ridge"
          ],
          "amount"
        ],
        "equals": 540
      },
      {
        "expr": [
          "get",
          [
            "record",
            "ledger",
            "cancel-ridge"
          ],
          "amount"
        ],
        "equals": 540
      },
      {
        "expr": [
          "get",
          [
            "record",
            "ledger",
            "cancel-ridge"
          ],
          "kind"
        ],
        "equals": "refund"
      }
    ]
  },
  {
    "steps": [
      {
        "action": "mission.dispatch",
        "args": {
          "id": "ridge",
          "eventId": "dispatch-ridge"
        }
      },
      {
        "action": "mission.dispatch",
        "args": {
          "id": "coast",
          "eventId": "dispatch-coast"
        },
        "ok": false
      }
    ],
    "assert": [
      {
        "expr": [
          "get",
          [
            "record",
            "projects",
            "alpine"
          ],
          "available"
        ],
        "equals": 460
      },
      {
        "expr": [
          "get",
          [
            "record",
            "projects",
            "ocean"
          ],
          "available"
        ],
        "equals": 400
      },
      {
        "expr": [
          "record",
          "ledger",
          "dispatch-coast"
        ],
        "equals": null
      },
      {
        "expr": [
          "count",
          [
            "all",
            "ledger"
          ]
        ],
        "equals": 1
      }
    ]
  },
  {
    "steps": [
      {
        "action": "mission.create",
        "args": {
          "id": "expensive",
          "title": "Expensive tent trial",
          "projectId": "ocean"
        }
      },
      {
        "action": "line.add",
        "args": {
          "id": "expensive-tents",
          "missionId": "expensive",
          "sku": "tent",
          "qty": 2
        }
      },
      {
        "action": "mission.dispatch",
        "args": {
          "id": "expensive",
          "eventId": "dispatch-expensive"
        },
        "ok": false
      }
    ],
    "assert": [
      {
        "expr": [
          "get",
          [
            "record",
            "missions",
            "expensive"
          ],
          "status"
        ],
        "equals": "draft"
      },
      {
        "expr": [
          "get",
          [
            "record",
            "projects",
            "ocean"
          ],
          "available"
        ],
        "equals": 400
      },
      {
        "expr": [
          "record",
          "ledger",
          "dispatch-expensive"
        ],
        "equals": null
      }
    ]
  },
  {
    "steps": [
      {
        "action": "finance.topUp",
        "args": {
          "id": "ocean",
          "amount": 250
        }
      },
      {
        "action": "finance.topUp",
        "args": {
          "id": "ocean",
          "amount": -5
        },
        "ok": false
      }
    ],
    "assert": [
      {
        "expr": [
          "get",
          [
            "record",
            "projects",
            "ocean"
          ],
          "available"
        ],
        "equals": 650
      }
    ]
  }
]
