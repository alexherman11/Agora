window : column
  share 1
  role page
  title : text "Visual report · isolated demo"
    role title
  subtitle : text "Owned demo feed. Messages here are addressed only to Codex."
    role subtitle
  feed : column
    share 1
    scroll end
    of sayings in:DEMO_FEED_ID
    each message
  composer : text ""
    role composer
    hint "Write in the isolated demo…"
    lines 3..8
    commit explicit
    on edit do append DEMO_FEED_ID line="$value" default_to="codex"
  help : text "Enter sends · Shift Enter adds a line"
    role hint
message : column
  role message
  author : text "$by"
    role author
  body : text "$said"
    role body
  visual : column
    only when ($visual or "") != ""
    lens $visual
