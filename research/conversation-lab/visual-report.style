font sans = Segoe UI, system-ui, sans-serif
font mono = Cascadia Code, ui-monospace, monospace
token paper = #F5F4F0
token card = #FFFFFF
token ink = #282B28
token accent = #286655
token soft = ink at 65%
token faint = ink at 13%
token wash = accent at 7%
token gap = 8
token ramp = 1.16
token text = sans 15/1.6
token text.mono = mono 11/1.5
role desk : on paper, ink, text
role page : on paper, ink, text, pad gap x2
role report : on card, ink, text, pad gap x2, edge faint, corner gap x1.5
role eyebrow : text.mono tracked, accent, space below gap
role title : text up 2 strong, ink
role subtitle : text down, soft, space below gap x2
role check : on wash, pad gap x1.5, corner gap, space below gap
role label : text medium, ink
role good : text.mono strong, accent, pad left gap
role body : text, ink, space above gap /2
role detail : text down, soft, space above gap /2
role boundary : text down, soft, space above gap
role message : pad gap, space below gap x2
role author : text medium, accent
role composer : text, ink, on card, pad gap
role button : on accent, card, text down medium, pad gap, corner gap
role hint : text down, soft, space above gap
theme dark of visual-chat-proof-style
  token paper = #1D211F
  token card = #272D29
  token ink = #E8EBE6
  token accent = #8DCDB4
