report : column
  role report
  eyebrow : text "CONVERSATION / DELIVERY CHECKS"
    role eyebrow
  title : text "The message reached JEFF"
    role title
  introduction : text "Three observations from one delivery check. Expand a row for the exact evidence."
    role subtitle
  flow : column
    measure 28ch
    drawing : text "<svg viewBox='0 0 240 248'><title>Browser Send, saved context, then JEFF reply</title><g fill='var(--t-wash)' stroke='var(--t-accent)' stroke-width='1'><rect x='1' y='1' width='238' height='66' rx='10'/><rect x='1' y='91' width='238' height='66' rx='10'/><rect x='1' y='181' width='238' height='66' rx='10'/></g><g stroke='var(--t-accent)' stroke-width='2' fill='none'><path d='M120 70V86m-5-5 5 5 5-5'/><path d='M120 160V176m-5-5 5 5 5-5'/></g><g fill='var(--t-ink)' font-family='Segoe UI, sans-serif' font-size='18'><text x='18' y='28'>Browser Send</text><text x='18' y='118'>Captured context</text><text x='18' y='208'>JEFF reply</text></g><g fill='var(--t-accent)' font-family='Segoe UI, sans-serif' font-size='15'><text x='18' y='50'>m5410</text><text x='18' y='140'>saved snapshot</text><text x='18' y='230'>m5411</text></g></svg>"
      picture
  delivery : column
    role check
    heading : row
      name : text "Message and response"
        role label
        share 1
      status : text "VERIFIED"
        role good
    summary : text "Browser Send produced m5410; JEFF answered in m5411."
      role body
    details : column
      fold "Delivery evidence" handle detail
      evidence : text "The browser sent from Codex draft a5154. The observed reply is m5411, event e10449. This reports that specific exchange; it does not establish every future delivery."
        role detail
  context : column
    role check
    heading : row
      name : text "Captured and current context"
        role label
        share 1
      status : text "DISTINGUISHED"
        role good
    summary : text "JEFF separated a5076 at captured revision 3 from current revision 5."
      role body
    details : column
      fold "Context evidence" handle detail
      evidence : text "The reply identified cap-3 and its captured/current revision difference. For cap-5 it identified a604, title Agora, at captured revision 4 versus current revision 6; cap-5 carried native title and identity."
        role detail
  image : column
    role check
    heading : row
      name : text "Image reached the model"
        role label
        share 1
      status : text "RECEIVED"
        role good
    summary : text "JEFF received cap-4 as an actual 600 × 380 image and described its three-line test."
      role body
    details : column
      fold "Image evidence and limit" handle detail
      evidence : text "The response described the image content. This does not establish pixel precision or completeness of desktop gesture capture."
        role detail
  boundary : text "Native report proof · This is a summary of observed evidence, not a new test run. No claim of HTML feature parity."
    role boundary
