    "s07": {
      "id": "s07",
      "kind": "note",
      "title": "Tide data format",
      "text": "Harbor tide feed is CSV, one row per 6 minutes. Need a parser before the kickoff.",
      "tags": [
        "harbor"
      ],
      "due": "2026-09-17",
      "rev": 8,
      "comments": [
        {
          "id": "c35",
          "by": "priya",
          "text": "Which timezone are the timestamps in?",
          "resolved": true,
          "replies": [
            {
              "by": "alex",
              "text": "Timestamps are UTC, per the Parser notes."
            }
          ]
        },
        {
          "id": "c36",
          "by": "priya",
          "text": "Is the 6-minute cadence fixed, or can it change?",
          "resolved": true,
          "replies": [
            {
              "by": "alex",
              "text": "The feed's 6-minute cadence is fixed, per the Parser notes."
            }
          ]
        },
        {
          "id": "c40",
          "by": "priya",
          "text": "And where does the feed come from?",
          "resolved": true,
          "replies": [
            {
              "by": "alex",
              "text": "The feed comes from the harbor master's station, per the Parser notes."
            }
          ]
        }
      ]
    },
