look f5204 :1
do create f5204 kind=note title=notify-question-owner tags=verb on=house text="# notify-question-owner <card>: the waiting card's question, noticed once, for the one it is for.\n# A native unanswered question to Alex is his. Otherwise the card's asker: a resident (a corner of their own) already\n# hears it through the house (the task notice for commission=waiting, and the knock of the mark=ask comment), so no\n# note is made for them; a person with no corner gets the note their notices bell shows. A card with no asked_by\n# refuses the second line (it cannot be read) and gets a note only for a question to Alex.\ndo create \"Alex's notices\" kind=note title=asking role=notice to=alex topic=asking about=$1 came=$now when count(sayings for:alex in:$1 mark=ask awaiting=yes) > 0\ndo create \"Alex's notices\" kind=note title=asking role=notice to=$1.asked_by topic=asking about=$1 came=$now when count(sayings for:alex in:$1 mark=ask awaiting=yes) = 0 and count(kind:surface,prop:role=resident,prop:actor=$1.asked_by) = 0"
read a5701
do replace a5701 old="when prop:commission=waiting do create \"Alex's notices\" kind=note title=asking role=notice to=alex topic=asking about=$item came=$now" new="when prop:commission=waiting do notify-question-owner $item"
