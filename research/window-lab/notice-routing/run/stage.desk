look f5204 :1
do create f5204 kind=note title=notify-question-owner tags=verb on=house text="# notify-question-owner <card>: the waiting card's question, noticed once, for Alex when it is his.\n# A note for Alex: an unanswered mark=ask question addressed to him, or a card he asked (asked_by=alex). A resident\n# asker gets no note: the house already reaches them (the worker's mark=ask comment knocks the card's asked_by; the\n# waiting state is a task notice to the card's lead, else its asker). Any other asker (no resident corner, not alex)\n# gets nothing here and is unresolved. A card with no asked_by refuses the second line, by itself.\ndo create \"Alex's notices\" kind=note title=asking role=notice to=alex topic=asking about=$1 came=$now when count(sayings for:alex in:$1 mark=ask awaiting=yes) > 0\ndo create \"Alex's notices\" kind=note title=asking role=notice to=alex topic=asking about=$1 came=$now when count(sayings for:alex in:$1 mark=ask awaiting=yes) = 0 and $1.asked_by = \"alex\""
read a5701
do replace a5701 old="when prop:commission=waiting do create \"Alex's notices\" kind=note title=asking role=notice to=alex topic=asking about=$item came=$now" new="when prop:commission=waiting do notify-question-owner $item"
