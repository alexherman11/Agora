# --- At work, improved (a6265: house-at-work, -row, -small). Laid between home-style and LAMPLIT's overrides (build.py's
# BORROWED), in LAMPLIT's light: amber your move, lilac a resident's, mint acting this moment, the rest grey.
role athouse : between gap /4
role atperson : corner gap, pad gap /4, pad left gap, pad right gap /2, rail ghost
role atperson.lit : corner gap, pad gap /4, pad left gap, pad right gap /2, rail lit
role atperson.you : corner gap, pad gap /4, pad left gap, pad right gap /2, rail lamp, on lampwash
role atperson.asks : corner gap, pad gap /4, pad left gap, pad right gap /2, rail jeff, on jeffwash
role atperson.on : corner gap, pad gap /4, pad left gap, pad right gap /2, rail lit, on raisedhi, edge ink
role atline : between gap, align center
role atwho : text.label medium, soft
role atwho.jeff : text.label medium, jeff
role atwhat : text down, ink
role atstate : text.label, faint
role atstate.lit : text.label medium, lit
role atstate.you : text.label medium, lamp
role atstate.asks : text.label medium, jeff
role atstate.warn : text.label medium, ink
role atsince : text.label, faint, width 3.2em
role atbar : width 2.2em
role atpct : text.label, faint, width 2.4em
role atpct.full : text.label medium, ink, width 2.4em
role atmore : text down 2, faint
role atpop : on paper, edge rim, corner gap, pad gap, between gap /2, width 30em
role atpophead : between gap, align center
role atpopwhat : text down, ink
role atpopmeta : text.label, faint
role atpopfeed : between gap /4
role atpopline : between gap
role atpoptime : text.label, faint, width 5.5em
role atpopkind : text.label medium tracked, lit, width 5em
role atpopkind.quiet : text.label tracked, soft, width 5em
role atpopword : text down, soft
role atpopgo : between gap
