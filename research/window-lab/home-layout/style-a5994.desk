# a5994: the looks the working tiling adds to home-style (a5206): the rail of titles beside a panel that fills the room,
# and the landing box the painter draws while a panel is in the air (lens.html has a floor look if a style has none)
read a5206
do append a5206 line="# a5994: the tiling's rail (a panel fills the room, the rest are titles) and the landing box of a drag"
do append a5206 line="role rail : between gap, width 15em"
do append a5206 line="role railitem : soft, on glass, edge rim, corner gap x1.5, pad gap, between gap /4"
do append a5206 line="role railitem.on : ink, on glassdeep, edge accent, corner gap x1.5, pad gap, between gap /4"
do append a5206 line="role landing : on accentwash, edge accent, corner gap x2"
