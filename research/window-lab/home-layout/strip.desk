# the panel lenses lose their own box and title: the layout's panel (home-tiling) draws both, and the one-line view
# (<name>-small) says what the title row said beside it. Exact passages as they stood on 15 Oct, after a5504.
read a5540
do replace a5540 old="  role panel\n  head : text \"The lowdown\"\n    role heading\n" new=""
read a5544
do replace a5544 old="  role panel\n  head : text \"At work\"\n    role heading\n" new=""
read a5548
do replace a5548 old="tasks : column\n  role panel\n" new="tasks : column\n"
do replace a5548 old="  head : row\n    role bdhead\n    title : text \"The board\"\n      role heading\n      share 1\n" new="  head : row\n    role bdhead\n"
read a5546
do replace a5546 old="  role side\n  head : text \"On your screen\"\n    role heading\n" new=""
read a5439
do replace a5439 old="waiting : column\n  role panel\n" new="waiting : column\n"
do replace a5439 old="  top : row\n    role waithead\n    head : text \"Waiting on you\"\n      role heading\n      share 1\n    n : text \"$(now + later)\"\n      role count\n      only when now + later > 0\n" new=""
