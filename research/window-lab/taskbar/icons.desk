# a6271: the home base's icons, one note each in the surface Icons (role=icons) in Home base: icon=<name> says which
# icon it is, the text is the drawing. One set: a 24 grid, one stroke (1.6, round ends and joins), no fill, drawn in
# currentColor so the role that holds it decides the colour (white; amber when it needs Alex; mint when an agent acts).
# A thing on the bar says icon=<name>; a new icon is one line here. {icons} is the surface's id (apply.py fills it).
do create {icons} kind=note title="JEFF" role=icon icon=jeff text="<svg viewBox='0 0 24 24'><g fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M5 4.5h14a2 2 0 0 1 2 2v8.5a2 2 0 0 1-2 2h-7.5L7 20.5V17H5a2 2 0 0 1-2-2V6.5a2 2 0 0 1 2-2z'/><path d='M12 7.6l.95 2.1 2.1.95-2.1.95-.95 2.1-.95-2.1-2.1-.95 2.1-.95z'/></g></svg>"
do create {icons} kind=note title="Board" role=icon icon=board text="<svg viewBox='0 0 24 24'><g fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><rect x='3.5' y='4' width='4.6' height='12.5' rx='1.3'/><rect x='9.7' y='4' width='4.6' height='16' rx='1.3'/><rect x='15.9' y='4' width='4.6' height='8.5' rx='1.3'/></g></svg>"
do create {icons} kind=note title="Conversation" role=icon icon=conversation text="<svg viewBox='0 0 24 24'><g fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M4.5 4.5h10a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H9.5l-3.5 3v-3H4.5a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2z'/><path d='M19.5 9a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H18v3l-3.5-3h-4'/></g></svg>"
do create {icons} kind=note title="Writing" role=icon icon=writing text="<svg viewBox='0 0 24 24'><g fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M15 4.5l4.5 4.5L9 19.5H4.5V15z'/><path d='M12.5 7l4.5 4.5'/><path d='M13 19.5h6.5'/></g></svg>"
do create {icons} kind=note title="Window Manager" role=icon icon=windows text="<svg viewBox='0 0 24 24'><g fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='11' height='16' rx='1.8'/><rect x='16' y='4' width='5' height='7' rx='1.4'/><rect x='16' y='13' width='5' height='7' rx='1.4'/></g></svg>"
do create {icons} kind=note title="The lowdown (document)" role=icon icon=lowdown text="<svg viewBox='0 0 24 24'><g fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M6 3.5h8.5L19 8v12.5H6z'/><path d='M14 3.5V8h5'/><path d='M9 12h7M9 15h7M9 18h4'/></g></svg>"
do create {icons} kind=note title="Waiting on you" role=icon icon=inbox text="<svg viewBox='0 0 24 24'><g fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M3.5 13.5L6 5h12l2.5 8.5V18a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 18z'/><path d='M3.5 13.5h5l1.5 2.5h4l1.5-2.5h5'/></g></svg>"
do create {icons} kind=note title="The lowdown (panel)" role=icon icon=digest text="<svg viewBox='0 0 24 24'><g fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><rect x='3.5' y='4.5' width='17' height='15' rx='2'/><path d='M7 9h10M7 12.5h10M7 16h6'/></g></svg>"
do create {icons} kind=note title="At work" role=icon icon=people text="<svg viewBox='0 0 24 24'><g fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><circle cx='9' cy='8.5' r='3'/><path d='M3.5 19.5c.6-3.3 2.8-5.2 5.5-5.2s4.9 1.9 5.5 5.2'/><circle cx='16.5' cy='9.5' r='2.4'/><path d='M15.8 14.4c2.5-.2 4.3 1.5 4.8 4.6'/></g></svg>"
do create {icons} kind=note title="On your screen" role=icon icon=screen text="<svg viewBox='0 0 24 24'><g fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4.5' width='18' height='12' rx='1.8'/><path d='M9 20h6M12 16.5V20'/></g></svg>"
do create {icons} kind=note title="The board (panel)" role=icon icon=lanes text="<svg viewBox='0 0 24 24'><g fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><circle cx='5' cy='6.5' r='1.3'/><circle cx='5' cy='12' r='1.3'/><circle cx='5' cy='17.5' r='1.3'/><path d='M9 6.5h11M9 12h11M9 17.5h7'/></g></svg>"
do create {icons} kind=note title="Music" role=icon icon=music text="<svg viewBox='0 0 24 24'><g fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M9 17.5V6l10-2v11.5'/><circle cx='6.5' cy='17.5' r='2.5'/><circle cx='16.5' cy='15.5' r='2.5'/></g></svg>"
do create {icons} kind=note title="Clock" role=icon icon=clock text="<svg viewBox='0 0 24 24'><g fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='8.5'/><path d='M12 7.5V12l3 2'/></g></svg>"
do create {icons} kind=note title="Now" role=icon icon=now text="<svg viewBox='0 0 24 24'><g fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='8.5'/><circle cx='12' cy='12' r='3.5'/></g></svg>"
do create {icons} kind=note title="Focus timer" role=icon icon=timer text="<svg viewBox='0 0 24 24'><g fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='13.5' r='7'/><path d='M12 13.5V9.5M10 3.5h4M17.8 7.2l1.4-1.4'/></g></svg>"
do create {icons} kind=note title="Notices" role=icon icon=bell text="<svg viewBox='0 0 24 24'><g fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M6.5 16.5V11a5.5 5.5 0 0 1 11 0v5.5l1.5 1.5H5z'/><path d='M10 20.5a2 2 0 0 0 4 0'/></g></svg>"
