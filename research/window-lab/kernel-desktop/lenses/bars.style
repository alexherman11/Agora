# bars: the look of the desktop's bars (top and bottom), after the calm style. Claude, PROOF a13428, 24 Oct 2026.
# A light bar of pills, in the manner of status bars like komorebi-bar and YASB (the look only; no code of theirs).

token paper    = #F4F5F3      # the bar itself: warm paper
token card     = #FFFFFF      # a pill
token ink      = #1F2A33
token accent   = #3F5D73      # slate blue
token warn     = #A24E2C
token mark     = #7A5C2E
token sage     = #5E7D63
token rose     = #A85D6E
token sheet    = #F4F1EA

token gap      = 8
token icon     = 17
token pill     = 28
token ramp     = 1.15
token text     = ui 15/1.5

token line     = ink at 18%
token faint    = ink at 10%
token quiet    = ink at 82%
token hush     = ink at 62%

role sheet     : on paper, ink, text
role bar       : on paper, ink, text down, pad gap /2, between gap, border bottom faint, align stretch
role group     : between gap /2
role pill      : on card, ink, text down, pad gap /2, corner gap, edge faint, between gap, height pill, align center, hover accent at 8%
role icon      : width icon, height icon, accent
role pill.time : on accent at 12%, accent, text down medium, pad gap /2, corner gap, between gap
role pill.feed : on rose at 12%, rose, text down medium, pad gap /2, corner gap, between gap, hover rose at 18%
role pill.play : on sage at 14%, sage, text down medium, pad gap /2, corner gap, between gap, hover sage at 22%
role label     : text down 2 tracked, hush
role value     : text down medium, ink
role detail    : text down 2, hush
role focus     : text down medium, quiet
role meta      : text down 2 tracked, hush
role title     : text medium, ink
role tag       : text down 2 tracked, accent, on accent at 12%, pad gap /2, corner gap /2
role tool      : text down, hush, pad gap /2, corner gap /2
role card      : on card, ink, text, pad gap, edge faint, corner gap /2
role heading   : text up medium, ink
role refusal   : text.mono down, warn, on warn at 8%, pad gap, corner gap /2, edge warn
