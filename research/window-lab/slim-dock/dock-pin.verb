# dock-pin <thing> <dock>: stable descriptors, duplicate drops are no-ops.
do create $2 kind=note title="$1.title" role=dock-pin opens="$(($1.opens or $1.shows or $1.id))" glyph="$(($1.glyph or \"◆\"))" icon="$(($1.icon or \"\"))" tint="$(($1.tint or \"blue\"))" about="$(($1.about or \"\"))" window="$(($1.window or \"\"))" when not (($1.role or "") = "home-panel") and not ($1.kind = "lens" or ($1.tags or "") has "lens") and (($1.window or "") = "" or ($1.opens or "") != "") and count(in:$2,prop:opens=$(($1.opens or $1.shows or $1.id))) = 0 and count(in:$2,prop:opens=$1) = 0
do create $2 kind=note title="$1.title" role=dock-pin opens="" window=$1.window glyph="$(($1.glyph or \"◆\"))" icon="$(($1.icon or \"\"))" tint="$(($1.tint or \"blue\"))" about="$(($1.about or \"\"))" when not (($1.role or "") = "home-panel") and not ($1.kind = "lens" or ($1.tags or "") has "lens") and ($1.window or "") != "" and ($1.opens or "") = "" and count(in:$2,prop:window=$1.window,-prop:opens) = 0
do create $2 kind=note title="$1.title" role=dock-pin lens=$1.lens shows="$(($1.shows or \"\"))" glyph="$(($1.glyph or \"◆\"))" icon="$(($1.icon or \"\"))" tint="$(($1.tint or \"blue\"))" about="$(($1.about or \"\"))" filled="$(($1.filled or \"\"))" chrome="$(($1.chrome or \"\"))" sizing="$(($1.sizing or \"\"))" pin="$(($1.pin or \"\"))" when ($1.role or "") = "home-panel" and ($1.shows or "") = "" and count(in:$2,prop:lens=$1.lens,-prop:shows) = 0
do create $2 kind=note title="$1.title" role=dock-pin lens=$1.lens shows=$1.shows glyph="$(($1.glyph or \"◆\"))" icon="$(($1.icon or \"\"))" tint="$(($1.tint or \"blue\"))" about="$(($1.about or \"\"))" filled="$(($1.filled or \"\"))" chrome="$(($1.chrome or \"\"))" sizing="$(($1.sizing or \"\"))" pin="$(($1.pin or \"\"))" when ($1.role or "") = "home-panel" and ($1.shows or "") != "" and count(in:$2,prop:lens=$1.lens,prop:shows=$1.shows) = 0
do create $2 kind=note title="$1.title" role=dock-pin lens=$1.title shows="" glyph="$(($1.glyph or \"◆\"))" icon="$(($1.icon or \"\"))" tint="$(($1.tint or \"blue\"))" about="$(($1.about or \"\"))" when ($1.kind = "lens" or ($1.tags or "") has "lens") and count(in:$2,prop:lens=$1.title,-prop:shows) = 0
do prop in:$2,prop:opens=$(($1.opens or $1.shows or $1.id)),prop:dock_removed=yes dock_removed=no when true and count(in:$2,prop:opens=$(($1.opens or $1.shows or $1.id)),prop:dock_removed=yes) > 0
do prop in:$2,prop:opens=$1,prop:dock_removed=yes dock_removed=no when true and count(in:$2,prop:opens=$1,prop:dock_removed=yes) > 0
do prop in:$2,prop:window=$1.window,-prop:opens,prop:dock_removed=yes dock_removed=no when ($1.window or "") != "" and count(in:$2,prop:window=$1.window,-prop:opens,prop:dock_removed=yes) > 0
do prop in:$2,prop:lens=$1.lens,-prop:shows,prop:dock_removed=yes dock_removed=no when ($1.role or "") = "home-panel" and ($1.shows or "") = "" and count(in:$2,prop:lens=$1.lens,-prop:shows,prop:dock_removed=yes) > 0
do prop in:$2,prop:lens=$1.lens,prop:shows=$1.shows,prop:dock_removed=yes dock_removed=no when ($1.role or "") = "home-panel" and ($1.shows or "") != "" and count(in:$2,prop:lens=$1.lens,prop:shows=$1.shows,prop:dock_removed=yes) > 0
do prop in:$2,prop:lens=$1.title,-prop:shows,prop:dock_removed=yes dock_removed=no when ($1.kind = "lens" or ($1.tags or "") has "lens") and count(in:$2,prop:lens=$1.title,-prop:shows,prop:dock_removed=yes) > 0
