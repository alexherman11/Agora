# harbour-app: a sample phone app, a list and a detail (a6431, the first app shown in the app dev workspace's phone
# preview, until Alex says which map to build). Places by the water are notes (role=harbour-place) in Harbour places;
# which one you have open is your own record (role=harbour-view actor=<you>, open=<place>). A press on a row opens it;
# the back line closes it. Its look is harbour-style, a phone app's own, not the home base's.
app : column
  role happ
  of prop:role=harbour-view,prop:actor=$me as v
  each screen
  none : text "No Harbour view of yours: a note with role=harbour-view actor=<you> (research/window-lab/app-dev/apply.py makes one)."
    role hhint
    only when count(prop:role=harbour-view,prop:actor=$me) = 0
screen : column
  role happ
  list : column
    role happ
    only when ($v.open or "") = ""
    head : column
      role hbar
      title : text "Harbour"
        role htitle
      sub : text "$(count(prop:role=harbour-place)) places by the water"
        role hbarsub
    rows : column
      role hlist
      of prop:role=harbour-place as p
      by order
      each row
  detail : column
    role happ
    only when ($v.open or "") != ""
    place : column
      role happ
      the $v.open as d
      back : row
        role hback
        on click do read $v; do prop $v open=""
        go : text "‹ All places"
          role hbackword
      hero : column
        role hhero
        name : text "$d.title"
          role hbig
        where : text "$d.area"
          role hsub
      facts : row
        role hfacts
        hours : column
          role hfact
          k : text "Open"
            role hkey
          v : text "$d.hours"
            role hval
        rating : column
          role hfact
          k : text "Rating"
            role hkey
          v : text "$d.rating"
            role hval
      about : text "$d.text"
        role hbody
row : row
  role hrow
  on click do read $v; do prop $v open=$p
  words : column
    role hwords
    share 1
    name : text "$title"
      role hname
    where : text "$area · $hours"
      role hmeta
  stars : text "$rating"
    role hrating
