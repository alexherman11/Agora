role button : on ink, night, text down medium, pad gap, pad left gap x2, pad right gap x2, corner gap x2
# --- the timer: running is alive (mint); idle is grey; done is your move (amber)
role pomoring : text.label medium, lit, width gap x7
role pomoring.still : text.label medium, faint, width gap x7
role pomoring.done : text.label medium, lamp, width gap x7
role pomomode : text.label tracked, faint
role pomomode.on : text.label medium tracked, lit
role pomobtn : text down 2 medium, night, on ink, corner gap x2, pad gap /4, pad left gap, pad right gap
role pomochip : text down 2, soft, edge rim, corner gap x2, pad gap /4, pad left gap, pad right gap
# --- the dock: white for what is open
role appicon.on : on mine, edge ink, corner gap x1.5, pad gap, width gap x11, between gap /4
role dockchip.on : ink, on wash, edge ink, corner gap, pad gap /2, pad left gap, pad right gap
role railitem.on : ink, on glassdeep, edge ink, corner gap x1.5, pad gap, between gap /4
role landing : on wash, edge ink, corner gap x2
