# home-widgets: every widget of the home base's top bar, left to right (a5530). A widget is a lens note tagged lens and
# widget, with slot=bar and order=<n> (size=s|m is a hint for the layout, a5496): adding one is one note in the Home base
# room, never an edit to home-base. This lens is their one reader; home-base places it first in its bar (top left).
widgets : row
  role widgets
  of tag:widget,prop:slot=bar as w
  by order
  each widget
widget : row
  role widget
  role widget.wide when $w.size = "m"
  lens $w.title
