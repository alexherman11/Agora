window : column
  share 1
  role tw.page
  the prop:role=adapter,prop:name=twitch as chat
  top : row
    role tw.top
    live : text "#$chat.channel"
      role tw.chip
      only when ($chat.channel or "") != ""
    state : text "$chat.status"
      role tw.status
      share 1
      clamp 1
  pick : text ""
    only when ($chat.channel or "") = ""
    role tw.composer
    hint "Your Twitch channel name, then Enter"
    commit enter only
    on edit do prop $chat.item channel="$value"
  feed : column
    share 1
    scroll end
    role tw.feed
    of lines:a12319
    clamp last 150
    each message
  foot : row
    role tw.foot
    note : text "Read-only"
      role tw.hint
      share 1
    pause : text "Pause"
      role tw.tool
      only when ($chat.on or "") = "yes"
      on click do prop $chat.item on=no
    resume : text "Turn on"
      role tw.tool
      only when ($chat.on or "") != "yes" or ($chat.status or "") = "waiting for Alex to turn it on"
      on click do prop $chat.item on=yes
message : row
  role tw.msg
  role tw.notice when ($kind or "") = "notice"
  role tw.sysline when ($user or "") = "bridge"
  let msg = $words when ($words or "") != ""
  let msg = $said otherwise
  who : text "$user"
    only when ($words or "") != "" and ($kind or "") != "notice"
    role tw.name
    role tw.name.red when $color = "#FF0000"
    role tw.name.blue when $color = "#0000FF"
    role tw.name.green when $color = "#008000"
    role tw.name.firebrick when $color = "#B22222"
    role tw.name.coral when $color = "#FF7F50"
    role tw.name.yellowgreen when $color = "#9ACD32"
    role tw.name.orangered when $color = "#FF4500"
    role tw.name.seagreen when $color = "#2E8B57"
    role tw.name.goldenrod when $color = "#DAA520"
    role tw.name.chocolate when $color = "#D2691E"
    role tw.name.cadetblue when $color = "#5F9EA0"
    role tw.name.dodgerblue when $color = "#1E90FF"
    role tw.name.hotpink when $color = "#FF69B4"
    role tw.name.blueviolet when $color = "#8A2BE2"
    role tw.name.springgreen when $color = "#00FF7F"
  body : text "$(msg)"
    role tw.words
    share 1
  at : text "$at"
    role tw.when
