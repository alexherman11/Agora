{
  "status": "hidden-fixture-only",
  "entry": {
    "producer": "ConversationRunner.entry(authenticated_person)",
    "kind": "conversation-entry",
    "label_binding": "visible_module.name",
    "action": {
      "word": "conversation.open",
      "target_binding": "configured_agent_module"
    },
    "scope": "signed-in-person",
    "fresh": {"fresh": "yes"}
  },
  "respond": {
    "producer": "ConversationRunner.respond(authenticated_person, text)",
    "request_fields": ["text"],
    "principal_source": "authenticated host session",
    "chat_source": "server resolver",
    "response_fields": ["chat", "text", "message", "tools"],
    "model_may_supply_person_or_chat": false
  },
  "draft": {
    "reader": "look <private draft>",
    "review_fields": ["text", "destination", "rev", "status"],
    "post": {
      "label": "Post",
      "word": "draft.post",
      "target_binding": "reviewed_draft.id",
      "arguments": {"rev_binding": "reviewed_draft.rev"},
      "requires": "explicit signed-in author's gesture",
      "model_available": false
    }
  },
  "tool_content": {
    "trust": "untrusted data",
    "render_as": "inert text and permission-checked world references",
    "may_execute_actions": false
  }
}
